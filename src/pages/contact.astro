---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout
  title="Contact Otter Homecare | Home Care in Wiltshire & Somerset"
  description="Get in touch with Otter Homecare for a free, no-pressure chat about home care in Trowbridge, Melksham, Frome, Bradford-on-Avon and Westbury. Call 01225 690022."
>
  <header class="phero"><div class="wrap"><div class="crumb"><a href="/">Home</a> · Contact</div><h1>Get in touch</h1><p>Speak to a real, local person — never a call centre. We're here to answer your questions, with no pressure and no obligation.</p></div></header>

  <section class="section"><div class="wrap">
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="ci"><span class="ic"><img src="/assets/icons/phone.svg" alt="" /></span><div><b>Call us</b><a href="tel:01225690022">01225 690022</a></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/heart.svg" alt="" /></span><div><b>Email</b><a href="mailto:hello@otterhomecare.co.uk">hello@otterhomecare.co.uk</a></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/pin.svg" alt="" /></span><div><b>Visit / write to us</b><span>Arlington House, 72 Fore Street,<br>Trowbridge, Wiltshire BA14 8HQ</span></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/clock.svg" alt="" /></span><div><b>Office hours</b><span>Mon–Fri 9am–5pm · care delivered 24/7</span></div></div>
      </div>
      <div class="reveal">
        <form class="form" id="contactForm" action="/api/contact" method="POST" novalidate>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
          <div class="frow">
            <div class="field"><label for="n">Your name</label><input id="n" name="name" type="text" required placeholder="Jane Smith" /></div>
            <div class="field"><label for="p">Phone</label><input id="p" name="phone" type="tel" required placeholder="07700 900000" /></div>
          </div>
          <div class="field"><label for="e">Email</label><input id="e" name="email" type="email" placeholder="jane@example.com" /></div>
          <div class="field"><label for="m">How can we help?</label><textarea id="m" name="msg" placeholder="Tell us a little about what you're looking for…"></textarea></div>
          <button class="btn btn-primary" type="submit">Send message →</button>
          <p class="privacy">We'll only use your details to respond to your enquiry. See our <a href="/privacy" style="text-decoration:underline">privacy policy</a>.</p>
        </form>
        <div class="form-success" id="contactOk" style="display:none">
          <div class="tick">✓</div>
          <h3>Thank you — message received</h3>
          <p>We'll be in touch very soon. If it's urgent, please call <strong>01225 690022</strong>.</p>
        </div>
      </div>
    </div>
  </div></section>

  <section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
    <div class="reveal" style="max-width:36ch;margin:0 auto">
      <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
      <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
      <p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person today — never a call centre.</p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-clay btn-lg" href="/#book">Book a free assessment</a>
        <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
      </div>
    </div>
    <div class="book-trust reveal">
      <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
      <div class="bt-stars"><span class="s">★★★★★</span> Rated <b>9.4</b> by families on homecare.co.uk</div>
    </div>
  </div></section>

  <script is:inline>
    const cf = document.getElementById("contactForm");
    if (cf) cf.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = cf.querySelector('button[type="submit"]');
      const data = Object.fromEntries(new FormData(cf).entries());
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) });
        const json = await res.json();
        if (res.ok && json.ok) {
          cf.style.display = "none"; document.getElementById("contactOk").style.display = "block";
          // Google Ads: count the successful send as a "Contact form submission" conversion (cookieless — see SiteLayout head)
          if (typeof gtag === "function") gtag("event", "conversion", { send_to: "AW-11233030388/uXnICMDw5bwcEPThqewp" });
        }
        else { btn.disabled = false; btn.textContent = "Send message →"; alert(json.error || "Something went wrong — please call us on 01225 690022."); }
      } catch { btn.disabled = false; btn.textContent = "Send message →"; alert("Something went wrong — please call us on 01225 690022."); }
    });
  </script>
</SiteLayout>
