---
import RatedBadge from "../components/RatedBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
---
<SiteLayout
  title="Contact Otter Homecare | Home Care in Wiltshire & Somerset"
  description="Call 01225 690022 or send us a message for a free, no-pressure chat about home care in Trowbridge, Melksham, Frome and nearby towns."
>
  <header class="phero"><div class="wrap"><div class="crumb"><a href="/">Home</a> · Contact</div><h1>Get in touch</h1><p>A friendly voice, not a call centre — here to answer your questions, with no pressure and no obligation.</p></div></header>

  <section class="section"><div class="wrap">
    <div class="contact-grid">
      <div class="contact-info reveal">
        <div class="ci"><span class="ic"><img src="/assets/icons/phone.svg" alt="" /></span><div><b>Call us</b><a href="tel:01225690022">01225 690022</a></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/heart.svg" alt="" /></span><div><b>Email</b><a href="mailto:hello@otterhomecare.co.uk">hello@otterhomecare.co.uk</a></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/pin.svg" alt="" /></span><div><b>Visit / write to us</b><span>Arlington House, 72 Fore Street,<br>Trowbridge, Wiltshire BA14 8HQ</span></div></div>
        <div class="ci"><span class="ic"><img src="/assets/icons/clock.svg" alt="" /></span><div><b>Office hours</b><span>Mon–Fri 8:30am–5pm · care delivered 24/7</span></div></div>
      </div>
      <div class="reveal cg-form">
        <EnquiryForm id="contactForm" level="h2" heading="Book your free assessment" hint="Not sure what help you need yet? Ask for a call and we'll talk it through first — a free home visit only when you're ready. We usually reply the same day, and there's no obligation at all." button="Send my enquiry →" successHeading="Thank you — message received" successText="We'll be in touch very soon." />
      </div>
    </div>
  </div></section>

  <section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
    <div class="reveal" style="max-width:36ch;margin:0 auto">
      <span class="eyebrow" style="color:#9fc4bf">Mon–Fri 8:30am–5pm · care delivered 24/7</span>
      <h2 style="margin:14px 0 12px">Prefer to talk it through?</h2>
      <p class="lede" style="margin-bottom:26px;color:#bfe0dc">Call us — you'll always reach a real, local person, never a call centre.</p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-clay btn-lg" href="tel:01225690022">Call 01225 690022</a>
      </div>
    </div>
    <div class="book-trust reveal">
      <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
      <RatedBadge />
    </div>
  </div></section>

</SiteLayout>
