---
import { stages } from "../data/alongside";
import Photo from "../components/Photo.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import stats from "../data/reviewStats.json";
import Turnstile from "../components/Turnstile.astro";
import TTMark from "../components/TTMark.astro";
import OtterKilt from "../components/OtterKilt.astro";
---
<SiteLayout
  title="Otter Homecare — Compassionate home care in Wiltshire & Somerset"
  description="Warm, flexible home care from a small, local team across Trowbridge, Bradford-on-Avon, Melksham, Westbury, Warminster and Frome. CQC-registered. Book a free assessment."
>
<header class="hero" id="top"> <div class="wrap"> <div class="hero-copy"> <span class="eyebrow">Family-run home care — Trowbridge, West Wiltshire &amp; Somerset</span> <h1 style="margin-top:18px">We look after your loved ones</h1> <span class="hero-like">… <span class="hl-hand">like family</span></span> <p class="sub">Warm, flexible home care from a small, local team — from a friendly visit and a cup of tea to daily care, nights, or someone living in.</p> </div> <div class="hero-media arch"> <div class="main"><Photo src="/img/ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg" alt="An Otter Care Professional sharing a warm moment with a client in the garden" priority sizes="(max-width: 900px) 100vw, 560px" /></div> <div class="hero-badge"><span class="em">{stats.homecare.score}</span><div><span class="stars">★★★★★</span><b>Rated by families</b><Photo class="hc-logo" src="/assets/homecare-logo.png" alt="Reviewed on homecare.co.uk" sizes="140px" /></div></div> </div> <div class="hero-cta"> <a class="btn btn-primary btn-lg" href="/contact">Book a free assessment <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a> <a class="btn btn-ghost btn-lg" href="tel:01225690022"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>Call 01225 690022</a> <div class="hero-trust"> <div class="ht-avatars"><span style="background:#136B7D">F</span><span style="background:#D4AC4F;color:#3a2a06">H</span><span style="background:#C8643C">E</span><span style="background:var(--teal-d)">J</span></div> <div class="ht-text"><span class="ht-stars">★★★★★</span><b>Loved by families across Wiltshire &amp; Somerset</b><small>Real reviews on homecare.co.uk</small></div> </div> </div> </div> </header>  <div class="wave wave--to-teal" aria-hidden="true"><svg viewBox="0 0 1200 90" preserveAspectRatio="none"><path class="rip-back" d="M0,34 C200,66 420,8 640,34 C860,60 1020,24 1200,42 L1200,90 L0,90 Z"></path><path class="rip-front" d="M0,60 C240,90 470,40 700,60 C940,80 1080,54 1200,66 L1200,90 L0,90 Z"></path></svg></div><section class="proof"><div class="wrap"><span class="proof-eyebrow">Why families choose Otter</span><div class="proof-grid"><div class="pf reveal"><span class="pf-ic"><img src="/assets/icons/heart.svg" alt="" loading="lazy"></span><b>Good enough for Dad</b><small>We only give care we'd want for our own dad</small></div><div class="pf reveal"><span class="pf-ic"><img src="/assets/icons/team.svg" alt="" loading="lazy"></span><b>The same few faces</b><small>Directly employed and DBS-checked — never a rotating rota</small></div><div class="pf reveal"><span class="pf-ic"><img src="/assets/icons/key.svg" alt="" loading="lazy"></span><b>Registered with the CQC</b><small>Regulated by the CQC — never an unregulated introductory agency</small></div><div class="pf reveal"><span class="pf-ic"><img src="/assets/icons/signpost.svg" alt="" loading="lazy"></span><b>Trained beyond the basics</b><small>By our own in-house trainer, before they ever visit alone</small></div></div></div></section>
<!-- TYPES OF SUPPORT — the delivery question, asked before the "what for" question.
     Added 21 Aug 2026. The homepage previously mixed one delivery model (live-in)
     into a grid of needs (personal care, conditions, companionship), so live-in read
     as a rival to personal care and the visiting model — which is what all 50+ of our
     clients actually receive — had no name anywhere on the page. Nights link to the
     own page as of 21 Aug 2026. -->
<section class="section supportscale">
  <div class="wrap">
    <div class="head-c reveal">
      <span class="eyebrow">Types of support</span>
      <h2>From a cup of tea to someone living in</h2>
      <p class="lede">Most families start small and change as things change. You're not picking a package — you're choosing how much help you'd like, and it can move with you.</p>
    </div>
    <div class="scale-row">
      <a class="scale reveal" href="/visiting-care">
        <span class="sc-ic"><img src="/assets/icons/door.svg" alt="" loading="lazy"></span>
        <b>We visit you</b>
        <p>From a friendly call-in once a day to several visits — half an hour, or a good long stretch.</p>
        <span class="more">Visiting care →</span>
      </a>
      <a class="scale reveal" href="/night-care">
        <span class="sc-ic"><img src="/assets/icons/window.svg" alt="" loading="lazy"></span>
        <b>We stay the night</b>
        <p>Someone sleeping over who can be woken once or twice, or awake the whole night if that is what is needed.</p>
        <span class="more">Night care →</span>
      </a>
      <a class="scale reveal" href="/live-in-care">
        <span class="sc-ic"><img src="/assets/icons/home.svg" alt="" loading="lazy"></span>
        <b>We live in</b>
        <p>Someone living alongside them, day and night — the alternative to a move into a care home.</p>
        <span class="more">Live-in care →</span>
      </a>
    </div>
  </div>
</section>
<section class="section services" id="services"> <div class="wrap"> <div class="head-c reveal"> <span class="dots-motif" aria-hidden="true"><TTMark animate /></span> <span class="eyebrow">What we help with</span>
        <h2>Care for the people you love most</h2> <p class="lede">Whether it's for a parent, a partner, or yourself, we'll wrap our care gently around the person — and the life they already love.</p> </div> <div class="svc-grid">
      <a class="svc svc-feature reveal" href="/personal-care"><div class="img"><Photo src="/img/personal-care-real.jpg" alt="" sizes="(max-width: 900px) 100vw, 400px" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/clock.svg" alt="" loading="lazy"></span><h3>Personal Care</h3><p>Everyday help with washing, dressing, medication and meals — flexible visits, as much or as little as you need.</p><span class="more">Learn more →</span></div></a>
      <a class="svc reveal" href="/companionship"><div class="img"><Photo src="/img/out-and-about.jpg" alt="" sizes="(max-width: 900px) 100vw, 820px" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/mug.svg" alt="" loading="lazy"></span><h3>Companionship</h3><p>A friendly face, shared hobbies and genuine connection, every visit — because good company is care too.</p><span class="more">Learn more →</span></div></a>
      <a class="svc reveal" href="/dementia"><div class="img"><Photo src="/img/dem-stay-yourself.jpg" alt="" sizes="(max-width: 880px) 50vw, 260px" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/armchair.svg" alt="" loading="lazy"></span><h3>Dementia Care</h3><p>Patient, familiar support that keeps someone safe at home — and keeps them themselves.</p><span class="more">Learn more →</span></div></a>
      <a class="svc svc-wide reveal" href="/conditions"><div class="img"><Photo src="/img/svc-specialist.jpg" alt="" sizes="(max-width: 900px) 100vw, 400px" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/heart.svg" alt="" loading="lazy"></span><h3>Conditions We Care For</h3><p>Specialist support for dementia, recovery and a range of conditions.</p><span class="more">Learn more →</span></div></a>
    </div>
    <p class="svc-costs-line reveal">Pay only for the time you need — clear hourly rates, no hidden fees. <a href="/cost-of-home-care">See costs &amp; funding →</a></p>
</div> </section>
<!-- ============================================================
  MERGED FOUNDER SECTION — production (design, 12 Aug 2026)
  Replaces the stand-in .founder section at the §1.4 marker.
  All copy existing + verbatim. One film: Good Enough for Dad.
  CSS: block J in otter-home-additions.css.
  ============================================================ -->
<section class="section founder-merged" id="founder">
  <div class="wrap">
    <div class="promise-top reveal">
      <Photo class="promise-photo" src="/img/promise-dad.jpg" alt="Jamie, our founder, with his father in the garden" />
      <div class="promise-words">
        <span class="eyebrow">Our promise</span>
        <h2>It started with caring for my own father</h2>
        <p class="promise-quote">“Care should feel like family — because for us, it started with family.”</p>
        <p class="promise-note">We only hire Care Professionals we’d trust with our own families — and our team looks after Jamie’s dad today.</p>
        <div class="sig">Jamie Rowland-Jones<span>Founder, Otter Homecare</span></div>
        
      </div>
    </div>
    <div class="video-embed reveal" data-yt="lYQKT_XjQTo" role="button" tabindex="0" aria-label="Play film: Would it be good enough for my dad?">
      <img src="/img/poster-good-enough-for-dad.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/lYQKT_XjQTo/hqdefault.jpg'" alt="Jamie speaking about the Good Enough for Dad promise" loading="lazy">
      <span class="playbtn"><span></span></span>
      <span class="vlabel">Film: Good Enough for Dad</span>
    </div>
  </div>
</section>

<!-- Kilt strip. Small on purpose: the founder block used to trail off into a bare
     text link promising "why the otter wears a kilt" with nothing to look at, and
     the mascot — the one thing no competitor has — appeared nowhere on the
     homepage. This pays the link off and hands it somewhere to go. Kept to a
     single row so it reads as an aside rather than another section; the page has
     just come down from 19.2 phone screens to 16.7 and should stay there. -->
<section class="section kiltstrip">
  <div class="wrap">
    <a class="kilt-card reveal" href="/our-story">
      <OtterKilt class="kilt-img" />
      <span class="kilt-body">
        <span class="eyebrow">Our values</span>
        <span class="kilt-h">Why our otter wears a kilt</span>
        <span class="kilt-p">Kindness, Initiative, Learning and Teamwork — the four things every Otter is hired for. <b>KILT</b>, for short.</span>
        <span class="kilt-link">Meet our values →</span>
      </span>
    </a>
  </div>
</section>

<section class="section steps" id="steps"> <div class="wrap"> <div class="head-c reveal"> <h2>A simple, reassuring process</h2> </div> <div class="steps-grid"><div class="step reveal"><span class="step-ic"><svg viewBox="0 0 24 24"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2 4.2 2 2 0 0 1 4 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.4 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.8 2z"></path></svg><span class="step-num">1</span></span><h3>Call us</h3><p>Complimentary, expert guidance tailored to your needs.</p></div> <div class="step reveal"><span class="step-ic"><svg viewBox="0 0 24 24"><path d="M9 11l3 3L22 4"></path><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg><span class="step-num">2</span></span><h3>Home visit</h3><p>Our qualified manager visits to create your tailored care plan.</p></div> <div class="step reveal"><span class="step-ic"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1a5.5 5.5 0 0 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"></path></svg><span class="step-num">3</span></span><h3>Start care</h3><p>Your matched Care Professional begins support on your terms.</p></div> <div class="step reveal"><span class="step-ic"><svg viewBox="0 0 24 24"><path d="M23 4v6h-6"></path><path d="M1 20v-6h6"></path><path d="M3.5 9a9 9 0 0 1 14.8-3.4L23 10M1 14l4.7 4.4A9 9 0 0 0 20.5 15"></path></svg><span class="step-num">4</span></span><h3>Ongoing</h3><p>We review and adapt your care as your needs change.</p></div></div> <div class="quizcard reveal"> <div><h3>Not sure what care you need?</h3><p>Tell us a little about your situation and we'll point you in the right direction — no pressure, no jargon.</p></div> <a class="btn btn-clay" href="/contact">Get in touch →</a> </div> </div> </section>
<section class="section app" id="app"> <div class="wrap"> <div class="reveal"> <h2>Stay connected to the moments that matter</h2> <p class="lede" style="margin:10px 0 22px">Our Care App keeps the whole family gently in the loop — wherever they are.</p> <div class="fl"><span class="ix">01</span><div><h3>See who's visiting today</h3><p>Know exactly when your Care Professional has been and when they're due.</p></div></div> <div class="fl"><span class="ix">02</span><div><h3>Read real visit notes</h3><p>From breakfast choices to how they're feeling — all recorded with care.</p></div></div>  <div class="fl"><span class="ix">03</span><div><h3>Know medication's been taken</h3><p>Confidence that medication's been given and needs are met.</p></div></div> <!-- app film moved to /family/care-app (§4) --> <!-- C3 · SIGNED OFF 12 Aug 2026: app teaser link -->
<p class="app-more reveal"><a href="/family/care-app">See how the app works →</a></p> </div> <div class="app-stage reveal"> <div class="phone phone-app" aria-label="The Otter Care App showing a completed visit note (example)"><div class="pa-status"><span>12:19</span><span class="pa-sicons" aria-hidden="true"><svg viewBox="0 0 16 12"><rect x="1" y="7" width="3" height="5" rx="1" fill="currentColor"></rect><rect x="6" y="4" width="3" height="8" rx="1" fill="currentColor"></rect><rect x="11" y="1" width="3" height="11" rx="1" fill="currentColor"></rect></svg><svg viewBox="0 0 16 12" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><path d="M2 4.5a9 9 0 0 1 12 0"></path><path d="M4.5 7a5.5 5.5 0 0 1 7 0"></path><circle cx="8" cy="10" r="1.1" fill="currentColor" stroke="none"></circle></svg><svg viewBox="0 0 22 12" fill="none" stroke="currentColor"><rect x="1" y="1.5" width="17" height="9" rx="2.5" stroke-width="1.2"></rect><rect x="3" y="3.5" width="10" height="5" rx="1" fill="currentColor" stroke="none"></rect><path d="M20 4.5v3" stroke-width="1.4" stroke-linecap="round"></path></svg></span></div><div class="pa-bar"><span class="pa-back" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"></path></svg></span><b>Visit note</b><span class="pa-sync" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"></path><path d="M3.5 9a9 9 0 0 1 14.8-3.4L23 10M1 14l4.7 4.4A9 9 0 0 0 20.5 15"></path></svg></span></div><div class="pa-body"><div class="pa-card"><small>Visit completed by</small><b>Sophie</b><span class="pa-meta">Tue · 08:00 – 09:00</span><span class="pa-done"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg>12/12 activities completed</span></div><div class="pa-sec">Medication</div><div class="pa-med"><span class="pa-pill" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)"></rect><path d="M8.5 8.5l7 7"></path></svg></span><div><b>Morning tablets</b><small>Given · 08:15</small></div><span class="pa-tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg></span></div><div class="pa-med"><span class="pa-pill" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3.5" y="8.5" width="17" height="7" rx="3.5" transform="rotate(-45 12 12)"></rect><path d="M8.5 8.5l7 7"></path></svg></span><div><b>Skin cream</b><small>Applied · 08:40</small></div><span class="pa-tick" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M8.5 12.5l2.5 2.5 4.5-5"></path></svg></span></div><p class="pa-note">Let myself in with the key safe. She was up and pleased to see me — made porridge and a pot of tea, and she ate well.</p></div><div class="pa-foot">Example visit note — names changed</div><div class="pa-tabs"><span class="on"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="3" width="14" height="18" rx="2"></rect><path d="M9 8h6M9 12h6M9 16h4"></path></svg>Visits</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path></svg>Cases</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 1 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.7 21a2 2 0 0 1-3.4 0"></path></svg>Alerts</span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 4v6h-6M1 20v-6h6"></path><path d="M3.5 9a9 9 0 0 1 14.8-3.4L23 10M1 14l4.7 4.4A9 9 0 0 0 20.5 15"></path></svg>Sync</span></div></div> <div class="app-co co1"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"></path></svg></span><div><b>Visit complete</b><small>Notes added · 09:32</small></div></div><div class="app-co co2"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="2.5" y="8.5" width="19" height="7" rx="3.5"></rect><line x1="12" y1="8.5" x2="12" y2="15.5"></line></svg></span><div><b>Medication given</b><small>On time, every visit</small></div></div><div class="app-co co3"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg></span><div><b>On the way</b><small>Sarah arrives 8:30</small></div></div><div class="app-co co4"><span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg></span><div><b>Next visit booked</b><small>Tomorrow, 9:00am</small></div></div> </div> 

</div> </section>

<!-- Otter Alongside — the six family guides. Sits directly after the care-app section: both
     are "support for families beyond the visits", so they reinforce each other, and this
     lands mid-page where phone users still are. It was originally just above the booking
     band, which on mobile put it at screen 14 of 19 — past where most people had left. Guides
     come from src/data/alongside.ts, shared with the /family hub so they can't drift. -->
<section class="section bg-paper alongside-home" id="alongside">
  <div class="wrap">
    <div class="head-c reveal">
      <span class="eyebrow">Otter Alongside</span>
      <h2>Six short guides for families</h2>
      <p class="lede">Free to read, whether or not we ever look after anyone for you — from the first "should we get help?" conversation all the way to the end.</p>
    </div>
    <div class="al-grid reveal">
      {stages.map((s) => (
        <a class="al-card" href={s.href}>
          <span class="al-head">
            <span class="al-ic"><img src={`/assets/icons/${s.icon}.svg`} alt="" width="24" height="24" loading="lazy" /></span>
            <span class="al-n">{s.n}</span>
          </span>
          <span class="al-t">{s.title}</span>
          <span class="al-s">{s.short}</span>
        </a>
      ))}
    </div>
    <div class="al-foot reveal">
      <a class="btn btn-primary" href="/family">Open Otter Alongside →</a>
      <p>Plus the questions families ask us most, and our plain-English guide to the Mental Capacity Act.</p>
    </div>
  </div>
</section>
<section class="section tmt hcrev" id="stories"> <div class="wrap"> <div class="head-c reveal"> <h2>The families we look after</h2> </div> <div class="hc-bar reveal"> <div class="hc-score"> <div class="hc-badge">{stats.homecare.score}</div> <div><b>Review Score for Otter Homecare</b><small>Based on {stats.homecare.count} verified reviews</small></div> </div> <a class="hc-brand" href="https://www.homecare.co.uk/homecare/agency.cfm/id/65432251370" target="_blank" rel="noopener"><Photo src="/assets/homecare-logo.png" alt="homecare.co.uk" sizes="160px" /></a> </div> <div class="story reveal"> <div class="story-pic"><Photo src="/img/ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg" alt="A client at home" /></div> <div class="story-body"> <div class="star">★★★★★</div> <blockquote>"I cannot recommend the Otter team highly enough if you are considering care for a loved one with dementia… We have gone from thinking our mum would be going into a care home imminently, to having mum safe, supported and most of all happy in her own home now. They listen, they communicate brilliantly and they are so adaptable to all the changes that dementia care brings."</blockquote> <div class="by">Anna B<span>Family of a client · via Google</span></div> </div> </div>  <div class="hc-grid hc-grid--2"> <div class="hc-card reveal"> <div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">15 Jul 2026</span></div> <p>"The Carers have all been very compassionate and very supportive during this rapid dementia journey we are experiencing…"</p> <div class="hc-by">Trudy S<span>Wife of Client</span></div> </div>    <div class="hc-card reveal"> <div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">24 Jun 2026</span></div> <p>"The care I have received so far is excellent, second to none. The carers are friendly and understanding. Very knowledgeable and appear to have a high quality of training… Highly recommend."</p> <div class="hc-by">S M<span>Client</span></div> </div></div> <div class="hc-foot reveal"> <a href="https://www.homecare.co.uk/homecare/agency.cfm/id/65432251370" target="_blank" rel="noopener">Read all {stats.homecare.count} reviews on homecare.co.uk →</a> <!-- C5 · SIGNED OFF 12 Aug 2026: internal reviews link --><span style="margin:0 10px;color:var(--muted)">·</span><a href="/reviews" style="font-weight:800;color:var(--teal)">More reviews from local families →</a> </div> </div> </section>
<section class="section moments"><div class="wrap"><div class="mgroup-head reveal"><span class="eyebrow">Real moments</span><h2>Going above and beyond</h2><p class="lede">Person-centred care isn't a slogan — it's the small, true things our team do every day.</p></div><div class="moments-grid"><div class="moment reveal"><img class="m-img" src="/img/rm-hilltop.jpg" alt="A client at the hilltop by the White Horse" loading="lazy"><div class="m-body"><h3>To the top of the hill</h3><p>For our Otter Happy Hour, one lady asked to be taken to the spot where her late husband's ashes had been scattered, high up by the White Horse. We made it happen.</p></div></div><div class="moment reveal"><Photo class="m-img" src="/img/rm-horses.jpeg" alt="An Otter Care Professional with a client at the stables" /><div class="m-body"><h3>A morning with the horses</h3><p>A lady living with dementia had once helped at a local stable. So one morning we took her to see the horses, then for coffee and cake at the farm café. She was calm and happy all morning.</p></div></div><div class="moment reveal"><img class="m-img" src="/img/haircut.jpg" alt="Cherie, our Registered Manager, with a client after a haircut" loading="lazy"><div class="m-body"><h3>A salon at home</h3><p>A gentleman who used to go a long time between haircuts now gets a regular trim from Cherie, our Registered Manager — a fresh cut, a good chat, and a bit of dignity.</p></div></div></div><div class="moments-more reveal"><a href="/real-moments">More real moments →</a></div></div></section>


<section class="section book" id="book"> <div class="wrap"> <div class="reveal"> <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span> <h2>Let's find the right care, together</h2> <p class="lede">Tell us a little about who needs support and we'll be in touch to arrange a free home visit — at a time that suits you.</p> <div class="reassure"> <div><span class="ic">✓</span> Free, no-obligation home visit</div> <div><span class="ic">✓</span> A tailored care plan, built around you</div> <div><span class="ic">✓</span> A friendly voice, not a call centre</div> </div> <div class="callbox"> <small>Prefer to talk? Call us Mon–Fri, 9am–5pm</small> <a href="tel:01225690022">01225 690022</a> </div> </div> <div class="reveal"> <form class="form" id="bookForm" action="/api/contact" method="POST" novalidate><input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" /> <!-- Second honeypot. Positioned off-screen rather than display:none, which      spam tooling detects and skips, and given an ordinary-looking name so a      bot avoiding the well-known "company" trap still fills it. Never focusable,      never announced. --> <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"        style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" /> <input type="hidden" name="ts" value="" data-stamp /> <h3>Book a free assessment</h3> <p class="fhint">We usually reply the same day. If you'd rather just talk it through first, say so below.</p> <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none"> <div class="frow"> <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" required autocomplete="name" placeholder="Jane Smith"></div> <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="07700 900000"></div> </div> <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" inputmode="email" placeholder="jane@example.com"></div> <div class="frow"> <div class="field"><label for="who">Who is the care for?</label><select id="who" name="who"><option value="" selected>Please choose…</option><option>My parent</option><option>My partner</option><option>Myself</option><option>Another relative</option><option>Someone else</option></select></div> <div class="field"><label for="area">Your area</label><select id="area" name="area"><option value="" selected>Please choose…</option><option>Trowbridge</option><option>Bradford-on-Avon</option><option>Melksham</option><option>Westbury</option><option>Frome</option><option>Warminster</option><option>Elsewhere nearby</option></select></div> </div> <div class="field"><label for="msg">How can we help? (optional)</label><textarea id="msg" name="msg" placeholder="A little about the support you're looking for…"></textarea></div> <Turnstile /><button class="btn btn-primary" type="submit">Request my free assessment →</button> <p class="privacy">Your details are kept private and never shared. See our <a href="/privacy" style="text-decoration:underline">privacy policy</a>.</p> </form> <div class="form-success" id="formSuccess"> <div class="tick">✓</div> <h3>Thank you — we've got it</h3> <p>One of our local team will be in touch very soon to arrange your free visit. If it's urgent, please call <strong>01225 690022</strong>.</p> </div> </div> </div> </section>
