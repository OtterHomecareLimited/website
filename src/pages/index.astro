---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image } from "astro:assets";
import hero from "../assets/img/hero.jpg";
import founder from "../assets/img/founder.jpg";
import community from "../assets/img/community.jpg";
---
<BaseLayout
  title="Otter Homecare — Trusted home care across Wiltshire & Somerset"
  description="Personal, live-in and companionship home care in Trowbridge, Melksham, Frome, Bradford-on-Avon and Westbury. CQC-registered and locally run."
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="wrap">
      <div class="grid">
        <div>
          <span class="eyebrow">🦦 Home care · Wiltshire & Somerset</span>
          <h1>Care that feels like <span class="accent">family</span> — in the home you love.</h1>
          <p class="lede">Personal, live-in and companionship care across Trowbridge, Melksham, Frome, Bradford-on-Avon and Westbury. Locally run. Properly trained. Quietly brilliant.</p>
          <div class="hero-ctas">
            <a href="/contact" class="cta large">Arrange a free chat →</a>
            <a href="/care-services" class="cta ghost large">Explore our care</a>
          </div>
          <a href="#founder" class="watch-link"><span class="play-mini">▶</span> Watch Jamie's 2-minute message — why we built Otter</a>
          <div class="phone-line">
            <span>Prefer to talk?</span>
            <strong>01225 690022</strong>
            <span>· Mon–Fri 8:30–17:00</span>
          </div>
        </div>
        <div style="position:relative">
          <div class="hero-art">
            <Image src={hero} alt="A Care Professional sharing a laugh with a client outdoors" class="fill-img" widths={[480, 800, 1200]} sizes="(max-width: 980px) 100vw, 560px" loading="eager" />
          </div>
          <div class="badge-float tl">
            <div class="num">★★★★★</div>
            <div class="lbl">Wiltshire Council QAF<br><strong style="color:#1F2E33">Perfect score 2024</strong></div>
          </div>
          <div class="badge-float br">
            <div class="num" style="color:#87A96B">100%</div>
            <div class="lbl">Locally owned<br>& Trowbridge-based</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <div class="trust">
    <div class="wrap">
      <div class="row">
        <div class="item">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L3 7v6c0 5 4 9 9 10 5-1 9-5 9-10V7l-9-5z"/></svg></div>
          <div><strong>CQC Registered</strong><span>Quality regulated</span></div>
        </div>
        <div class="item">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M2 12h20"/></svg></div>
          <div><strong>Wiltshire Council Approved</strong><span>QAF perfect score</span></div>
        </div>
        <div class="item">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg></div>
          <div><strong>Trained Local Team</strong><span>Properly supported staff</span></div>
        </div>
        <div class="item">
          <div class="icon"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 11c0 6-9 11-9 11s-9-5-9-11a9 9 0 0118 0z"/><circle cx="12" cy="11" r="3"/></svg></div>
          <div><strong>Wiltshire & Somerset</strong><span>Trowbridge, Melksham, Frome…</span></div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ FOUNDER'S MESSAGE ============ -->
  <section class="founder" id="founder">
    <div class="wrap">
      <div class="layout">
        <div class="media">
          <div class="video-frame">
            <Image src={founder} alt="Jamie sharing a cup of tea with a client in a Wiltshire garden" class="fill-img" widths={[480, 800]} sizes="(max-width: 980px) 100vw, 480px" />
          </div>
        </div>
        <div>
          <span class="eyebrow">A note from our founder</span>
          <h2>I started Otter Homecare because of my Dad.</h2>
          <p class="story">I grew up in Wiltshire, but spent my twenties and thirties in Thailand. There, I saw a culture where caring for older loved ones at home — surrounded by family — was simply the way of life. Care homes were almost unheard of.</p>
          <p class="story">When I came back to the UK and my father suffered a severe stroke, I knew exactly what to do. We cared for him at home. Familiar faces. Dignity. Love. Supervising his support team opened my eyes to the real power of good care — not just for the person being supported, but for the whole family.</p>
          <p class="story">My wife Bowling and I founded Otter Homecare to bring that same care to families across Wiltshire and Somerset. Three things still guide every decision we make:</p>
          <p class="story"><strong>The Dad test.</strong> Before we hire anyone or write any care plan, I ask one question: <em>would this be good enough for my own Dad?</em> If the answer is anything other than yes, we change it.</p>
          <p class="story"><strong>A small team, on purpose.</strong> We've stayed deliberately small so families know everyone who comes through the door — and so I know everyone we send.</p>
          <p class="story"><strong>Full transparency through our care app.</strong> Families can see every visit, every note, every medication — in real time, from their phone. No mystery. No "how did Mum do today?" left hanging.</p>
          <div class="sig">
            <span class="sig-mark">Jamie,</span>
            <div>
              <div class="sig-name">Jamie Rowland-Jones</div>
              <div class="sig-role">Founder & Managing Director · Otter Homecare</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section class="services" id="services">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">What we do</span>
        <h2>Care designed around the person, not the task list.</h2>
        <p>Whether it's an hour of companionship a week or full live-in support, we shape our care around what someone actually needs — and what makes them feel like themselves.</p>
      </div>
      <div class="cards">
        <a class="service" href="/personal-care">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          <h3>Personal Care</h3>
          <p>Help with washing, dressing, medication, meals and the everyday moments that matter — delivered with dignity.</p>
          <span class="more">Learn more →</span>
        </a>
        <a class="service" href="/live-in-care">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12l2-2 4 4 8-8 4 4"/><path d="M3 21h18"/></svg></div>
          <h3>Live-in Care</h3>
          <p>A dedicated carer in the home around the clock — a real alternative to residential care, in the place you know best.</p>
          <span class="more">Learn more →</span>
        </a>
        <a class="service" href="/companionship">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M8 12h8M12 8v8"/></svg></div>
          <h3>Companionship</h3>
          <p>A friendly visit, a cup of tea, a trip out — the kind of company that lifts a week and keeps loneliness at bay.</p>
          <span class="more">Learn more →</span>
        </a>
        <a class="service" href="/conditions">
          <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2l3 6 6 1-4.5 4 1 6L12 16l-5.5 3 1-6L3 9l6-1z"/></svg></div>
          <h3>Specialist Support</h3>
          <p>Dementia, frailty, fall recovery, end-of-life — experienced support for the conditions that need a steady, expert hand.</p>
          <span class="more">Learn more →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="how" id="how">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">How it works</span>
        <h2>Three steps to care that fits.</h2>
        <p>No call centres, no high-pressure sales. Just a friendly chat to understand what's needed, then a plan we build together.</p>
      </div>
      <div class="steps">
        <div class="step">
          <div class="num">1</div>
          <h3>Free, no-pressure chat</h3>
          <p>Call us or fill in the form. We'll listen, answer your questions and explain how home care actually works — in plain English.</p>
        </div>
        <div class="step">
          <div class="num">2</div>
          <h3>Home assessment</h3>
          <p>We visit at a time that suits you to understand the person, the home and the routine. No commitment, no charge.</p>
        </div>
        <div class="step">
          <div class="num">3</div>
          <h3>Care that starts gently</h3>
          <p>A bespoke care plan and a matched carer. We start small, build trust, and adjust as needs change — never the other way round.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ AREAS ============ -->
  <section class="areas" id="areas">
    <div class="wrap">
      <div class="layout">
        <div class="map-box">
          <div class="map-label">[ Interactive map of West Wiltshire<br>with service pins ]</div>
        </div>
        <div>
          <span class="eyebrow">Where we cover</span>
          <h2 style="font-size:34px;margin:14px 0 16px">Proudly local. Properly local.</h2>
          <p style="font-size:16.5px;color:var(--muted);margin:0 0 8px">We're a Trowbridge family business serving the towns and villages around us. That means short journeys for our carers, faster response when things change, and a team that knows the area you live in.</p>
          <div class="area-pills">
            <a class="pill" href="/trowbridge"><span class="marker"></span>Trowbridge</a>
            <a class="pill" href="/melksham"><span class="marker"></span>Melksham</a>
            <a class="pill" href="/frome"><span class="marker"></span>Frome</a>
            <a class="pill" href="/bradford-on-avon"><span class="marker"></span>Bradford-on-Avon</a>
            <a class="pill" href="/westbury"><span class="marker"></span>Westbury</a>
            <span class="pill" style="background:var(--teal-soft);color:var(--teal);border-color:var(--teal-soft)">+ surrounding villages</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY US ============ -->
  <section class="why">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">The promises we make</span>
        <h2>Not the biggest. Just genuinely good.</h2>
        <p>Four things that aren't marketing — they're how we actually run.</p>
      </div>
      <div class="grid">
        <div class="item">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg></div>
          <h3>The "Dad test"</h3>
          <p>Every carer we hire, every plan we write — we ask one question: would this be good enough for my own Dad?</p>
        </div>
        <div class="item">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></div>
          <h3>A small team, on purpose</h3>
          <p>We've stayed deliberately small so you know everyone we send — and so we know them too. No agency strangers.</p>
        </div>
        <div class="item">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M10 18h4"/></svg></div>
          <h3>Real-time care app</h3>
          <p>Every visit, every note, every medication — visible on your phone the moment it happens. No mystery.</p>
        </div>
        <div class="item">
          <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 4-7 8-7s8 3 8 7"/></svg></div>
          <h3>Same faces, every time</h3>
          <p>We track carer continuity weekly. Familiar faces, familiar routines — because care that feels new every day isn't really care.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="testimonials">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">In their own words</span>
        <h2>What families and clients say.</h2>
      </div>
      <div class="quotes">
        <div class="quote">
          <p>The Otter team have been wonderful with Mum. They take time with her, they remember the little things, and I sleep better at night knowing they're there.</p>
          <div class="who">
            <div class="avatar">SW</div>
            <div><div class="name">Sarah W.</div><div class="role">Daughter, Trowbridge</div></div>
          </div>
        </div>
        <div class="quote">
          <p>I didn't want to leave my home and I haven't had to. The carers are kind, professional, and feel like friends after a while.</p>
          <div class="who">
            <div class="avatar">DR</div>
            <div><div class="name">David R.</div><div class="role">Client, Bradford-on-Avon</div></div>
          </div>
        </div>
        <div class="quote">
          <p>From the first phone call to the assessment to the care itself, it has all been brilliant. Honest, clear, and properly run.</p>
          <div class="who">
            <div class="avatar">MH</div>
            <div><div class="name">Margaret H.</div><div class="role">Daughter-in-law, Melksham</div></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ COMMUNITY ============ -->
  <section class="community" id="community">
    <div class="wrap">
      <div class="layout">
        <div class="community-art">
          <Image src={community} alt="The Otter Homecare team at the Otter Café, Staverton Village Hall" class="fill-img" widths={[480, 800, 1000]} sizes="(max-width: 980px) 100vw, 480px" />
        </div>
        <div>
          <span class="eyebrow">More than care</span>
          <h2>The Otter Café — and a community we love.</h2>
          <p>We run free monthly Otter Café gatherings in Staverton Village Hall, send out our Community Connect newsletter, and turn up to things that matter locally. Care doesn't end at the front door — and neither do we.</p>
          <div style="display:flex;gap:14px;flex-wrap:wrap">
            <a href="/contact" class="cta">Find the next Otter Café →</a>
            <a href="/blog" class="cta ghost">Read Community Connect</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ BLOG ============ -->
  <section class="blog">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">From the blog</span>
        <h2>Helpful reads for families thinking about care.</h2>
      </div>
      <div class="cards">
        <article class="post">
          <a href="/post/community-connect-winter-february-2026">
            <div class="img">[ Photo: newsletter cover ]</div>
            <div class="body">
              <span class="tag">Newsletter</span>
              <h3>Community Connect — Winter 2026 edition</h3>
              <span class="date">15 February 2026</span>
            </div>
          </a>
        </article>
        <article class="post">
          <div class="img">[ Photo: Otter Café ]</div>
          <div class="body">
            <span class="tag">Community</span>
            <h3>Our first ever Otter Café — a wonderful start</h3>
            <span class="date">9 September 2025</span>
          </div>
        </article>
        <article class="post">
          <div class="img">[ Photo: family conversation ]</div>
          <div class="body">
            <span class="tag">Advice</span>
            <h3>The benefits of personalised care plans — why one-size-fits-all doesn't work</h3>
            <span class="date">3 September 2025</span>
          </div>
        </article>
      </div>
      <div style="text-align:center;margin-top:36px"><a href="/blog" class="cta ghost">Read more from the blog →</a></div>
    </div>
  </section>

  <!-- ============ BIG CTA ============ -->
  <section class="big-cta" id="contact">
    <div class="wrap">
      <h2>Wondering if home care could work?</h2>
      <p>Have a free, no-pressure chat with someone local who knows what they're talking about. We'll listen first.</p>
      <div class="row">
        <a href="tel:01225690022" class="phone">📞 01225 690022</a>
        <a href="/contact" class="cta large" style="background:#fff;color:var(--teal)">Book a free chat →</a>
      </div>
    </div>
  </section>
</BaseLayout>
