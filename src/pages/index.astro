---
import SiteLayout from "../layouts/SiteLayout.astro";
const img = (f: string) => `/img/${f}`;
---
<SiteLayout
  title="Otter Homecare — Compassionate home care in Wiltshire & Somerset"
  description="Warm, flexible home care from a small, local team across Trowbridge, Bradford-on-Avon, Melksham, Westbury and Frome. CQC regulated. Book a free assessment."
>
  <!-- hero -->
  <header class="hero" id="top">
    <div class="wrap">
      <div class="hero-copy">
        <span class="eyebrow">Local home care in Wiltshire &amp; Somerset</span>
        <h1 style="margin-top:18px">We look after your loved ones</h1>
        <span class="hero-like">… <span class="hl-hand">like family</span></span>
        <p class="sub">Warm, flexible home care from a small, local team — from live-in support to a friendly visit and a cup of tea.</p>
      </div>
      <div class="hero-media arch">
        <div class="main"><img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="An Otter carer sharing a warm moment with a client in the garden" /></div>
        <div class="hero-badge"><span class="em">9.4</span><div><span class="stars">★★★★★</span><b>Rated by families</b><img class="hc-logo" src="/assets/homecare-logo.png" alt="Reviewed on homecare.co.uk" /></div></div>
      </div>
      <div class="hero-cta">
        <a class="btn btn-primary btn-lg" href="#book">Book a free assessment <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
        <a class="btn btn-ghost btn-lg" href="tel:01225690022"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>Call 01225 690022</a>
        <div class="hero-trust">
          <div class="ht-avatars"><span style="background:#17687D">F</span><span style="background:#D8B65E;color:#3a2a06">H</span><span style="background:#C8643C">E</span><span style="background:#0F4F60">J</span></div>
          <div class="ht-text"><span class="ht-stars">★★★★★</span><b>Loved by families across Wiltshire &amp; Somerset</b><small>Real reviews on homecare.co.uk</small></div>
        </div>
      </div>
    </div>
  </header>

  <!-- proof band -->
  <section class="proof"><div class="wrap">
    <div class="pf"><b>1</b><small>One local team, not a national branch</small></div>
    <div class="pf"><b>1-to-1</b><small>Carefully matched, familiar carers</small></div>
    <div class="pf"><b>Your way</b><small>Visit lengths to suit you</small></div>
    <div class="pf"><b>5 towns</b><small>Across Wiltshire &amp; Somerset</small></div>
  </div></section>

  <!-- founder + video -->
  <section class="section founder" id="founder">
    <div class="wrap">
      <div class="video-embed reveal" data-yt="BFJ9QbUBr9I" role="button" tabindex="0" aria-label="Play: Hi, I'm Jamie — why I started Otter">
        <img src="https://img.youtube.com/vi/BFJ9QbUBr9I/maxresdefault.jpg" alt="Jamie, founder of Otter Homecare, speaking to camera" />
        <span class="playbtn"><span></span></span>
        <span class="vlabel">Watch: Hi, I'm Jamie — why I started Otter</span>
      </div>
      <div class="reveal">
        <h2>It started with caring for my own father</h2>
        <blockquote>Otter was born after my father had a stroke and I became his main carer. Combined with 20 years in Asia — where older generations are deeply respected — it inspired a kinder, more personal kind of care here in Wiltshire and Somerset.</blockquote>
        <div class="sig">Jamie Rowland-Jones<span>Founder, Otter Homecare</span></div>
      </div>
    </div>
  </section>

  <!-- our promise (KILT) -->
  <section class="section promise" id="promise">
    <div class="wrap">
      <div class="head-c reveal">
        <h2>Our promise to your family</h2>
        <p class="lede">Four values guide everyone at Otter. Read the first letter of each below — and you'll see why our otter wears a kilt.</p>
      </div>
      <div class="promise-row">
        <div class="promise-otter reveal">
          <div class="promise-bubble">Four values — one proud kilt.</div>
          <img src="/assets/otter-kilt.png" alt="The Otter Homecare mascot wearing a tartan kilt — a nod to our four values: Kindness, Innovation, Learning, Teamwork" loading="lazy" />
        </div>
        <div class="promise-list reveal">
          <div class="pl"><span class="pl-val"><span class="ini">K</span>indness</span><div class="pl-body"><h3>Care that feels like family</h3><p>Carers matched to your loved one for genuine warmth and patience — every single visit.</p></div></div>
          <div class="pl"><span class="pl-val"><span class="ini">I</span>nnovation</span><div class="pl-body"><h3>Always finding better ways to care</h3><p>We're constantly looking for new ways of doing things — like our real-time Care App — to bring about better outcomes for the people we care for.</p></div></div>
          <div class="pl"><span class="pl-val"><span class="ini">L</span>earning</span><div class="pl-body"><h3>A team that keeps getting better at caring for you</h3><p>Directly employed carers, properly trained and always improving how they support you.</p></div></div>
          <div class="pl"><span class="pl-val"><span class="ini">T</span>eamwork</span><div class="pl-body"><h3>A reliable team around your loved one</h3><p>A small, familiar group who know your routine — never just one person, never a stranger.</p></div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- services -->
  <section class="section services" id="services">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="dots-motif" aria-hidden="true"><img src="/assets/otter-tt.png" alt="" /></span>
        <h2>Care for the people you love most</h2>
        <p class="lede">Whether it's for a parent, a partner, or yourself, we'll wrap our care gently around the person — and the life they already love.</p>
      </div>
      <div class="svc-grid">
        <a class="svc svc-feature reveal" href="/live-in-care"><div class="img"><img src={img("ff72ba_0aa05eb659ee4c64a5d410e57b21eff0~mv2.jpg")} alt="" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/home.svg" alt="" /></span><h3>Live-in Care</h3><p>Expert round-the-clock care in the comfort of your own home — a warm, one-to-one alternative to a care home.</p><span class="more">Learn more →</span></div></a>
        <a class="svc reveal" href="/visiting-care"><div class="img"><img src={img("ff72ba_3a8fe18215c24b3e9cb6884f0bf44228~mv2.jpg")} alt="" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/clock.svg" alt="" /></span><h3>Visiting Care</h3><p>Friendly carers visiting your home — from personal care, washing and dressing to meals, medication and good company.</p><span class="more">Learn more →</span></div></a>
        <a class="svc reveal" href="/conditions"><div class="img"><img src={img("ff72ba_356da85da3114f4ea8c98fa716675d83~mv2.jpg")} alt="" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/heart.svg" alt="" /></span><h3>Conditions We Care For</h3><p>Specialist support for dementia, recovery and a range of conditions.</p><span class="more">Learn more →</span></div></a>
        <a class="svc svc-wide reveal" href="/companionship"><div class="img"><img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="" /></div><div class="body"><span class="svc-ic"><img src="/assets/icons/mug.svg" alt="" /></span><h3>Companionship</h3><p>A friendly face, shared hobbies and genuine connection, every visit — because good company is care too.</p><span class="more">Learn more →</span></div></a>
      </div>
    </div>
  </section>

  <div class="wave wave--to-teal" aria-hidden="true"><svg viewBox="0 0 1200 40" preserveAspectRatio="none"><path d="M0,40 L0,18 C150,32 250,6 420,16 C560,24 660,4 820,14 C980,24 1080,8 1200,18 L1200,40 Z"></path></svg></div>

  <!-- different -->
  <section class="section diff" id="diff">
    <div class="wrap diff-wrap">
      <div class="diff-intro reveal">
        <h2>What makes us different</h2>
        <p>We're one local team who answer the phone ourselves — not a branch of a national chain or a call centre.</p>
        <div class="diff-lead">
          <div class="ic"><img src="/assets/icons/heart.svg" alt="" /></div>
          <h3>Good Enough for Dad</h3>
          <p>We only hire carers we'd trust with our own families. In fact, our carers support my own dad.</p>
        </div>
      </div>
      <div class="diff-list reveal">
        <div class="dl"><div class="ic"><img src="/assets/icons/team.svg" alt="" /></div><div><h4>A small, dedicated team</h4><p>Tight-knit, so carers get to know each client and family properly.</p></div></div>
        <div class="dl"><div class="ic"><img src="/assets/icons/pin.svg" alt="" /></div><div><h4>Local &amp; personal</h4><p>Based in Trowbridge and just around the corner — always close by.</p></div></div>
        <div class="dl"><div class="ic"><img src="/assets/icons/phone.svg" alt="" /></div><div><h4>Care App transparency</h4><p>Families see real-time updates from every visit, for total peace of mind.</p></div></div>
        <div class="dl"><div class="ic"><img src="/assets/icons/clock.svg" alt="" /></div><div><h4>Visits that suit you</h4><p>From a quick daily call-in to a full day together — care that flexes around life.</p></div></div>
      </div>
    </div>
  </section>

  <!-- full-bleed photo beat (video placeholder) -->
  <section class="fullbleed has-video" data-yt="lYQKT_XjQTo" role="button" tabindex="0" aria-label="Play film: Would it be good enough for my dad?">
    <img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="An Otter carer walking with a client outdoors" />
    <span class="fb-play"><span></span></span>
    <span class="soon-tag">Film: Good Enough for Dad</span>
    <div class="fb-quote"><div class="wrap"><p>“Care should feel like family — because for us, it started with family.”</p><cite>— Jamie, Founder of Otter Homecare</cite></div></div>
  </section>

  <!-- care you can trust -->
  <section class="section trustwhy" id="trust-why">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="dots-motif" aria-hidden="true"><img src="/assets/otter-tt.png" alt="" /></span>
        <h2>Peace of mind, built in</h2>
      </div>
      <div class="trust3">
        <div class="t3 reveal"><span class="ix">01</span><h3>Fully CQC-regulated</h3><p>Independently inspected against the highest national standards — never an unregulated introductory agency.</p></div>
        <div class="t3 reveal"><span class="ix">02</span><h3>Our own carers</h3><p>Directly employed and trained by us. No freelancers, no agency staff — just familiar, friendly faces.</p></div>
        <div class="t3 reveal"><span class="ix">03</span><h3>Matched &amp; consistent</h3><p>The same small team of carers, who get to know you, your routine and the things that matter most.</p></div>
      </div>
    </div>
  </section>

  <!-- otter happy hour -->
  <section class="section happyhour">
    <div class="wrap">
      <div class="hh-card reveal">
        <div class="hh-copy">
          <span class="tag">a little joy, on us ♥</span>
          <h2>Otter Happy Hour</h2>
          <p>Every month we gift a free hour of care — to spend on whatever brings a smile. A trip to the garden centre, a favourite cake, or simply more time together.</p>
        </div>
        <div class="hh-emblem"><img src="/assets/icons/heart.svg" alt="" /></div>
      </div>
    </div>
  </section>

  <!-- help -->
  <section class="section help" id="help">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="dots-motif" aria-hidden="true"><img src="/assets/otter-tt.png" alt="" /></span>
        <h2>Support tailored to everyday life</h2>
        <p class="lede">Our Care Professionals are trained across a wide range of support — mixed and matched to suit you.</p>
      </div>
      <div class="help-grid">
        <div class="help-item reveal"><img src={img("ff72ba_83df1eb983a540ec9504319d2046ca73~mv2.jpg")} alt="" /><span>Personal care</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_ccfd35686af147f6a016e747c91942d6~mv2.jpg")} alt="" /><span>Medication management</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_65e6bbb5381c4de39626e5fd8be7f9aa~mv2.jpg")} alt="" /><span>Meal preparation</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_7402ffd16d2848ac9e7a9bb2ac85cdf9~mv2.jpg")} alt="" /><span>Transportation</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_937a9c9f723a4acbb4b07d6c06efc354~mv2.jpg")} alt="" /><span>Hobbies &amp; interests</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_bcb4f2e40c2f405b8d0b51b783e888b2~mv2.jpg")} alt="" /><span>Physical activity</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_2b291b82c9c04a17b6b9a51f6953fd1f~mv2.jpg")} alt="" /><span>Home help</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_65e6bbb5381c4de39626e5fd8be7f9aa~mv2.jpg")} alt="" /><span>Grocery shopping</span></div>
      </div>
    </div>
  </section>

  <!-- steps -->
  <section class="section steps" id="steps">
    <div class="wrap">
      <div class="head-c reveal"><h2>A simple, reassuring process</h2></div>
      <div class="steps-grid">
        <div class="step reveal"><span class="bignum">1</span><h3>Call us</h3><p>Complimentary, expert guidance tailored to your needs.</p></div>
        <div class="step reveal"><span class="bignum">2</span><h3>Home visit</h3><p>Our qualified manager visits to create your tailored care plan.</p></div>
        <div class="step reveal"><span class="bignum">3</span><h3>Start care</h3><p>Your matched Care Professional begins support on your terms.</p></div>
        <div class="step reveal"><span class="bignum">4</span><h3>Ongoing</h3><p>We review and adapt your care as your needs change.</p></div>
      </div>
      <div class="quizcard reveal">
        <div><h3>Not sure what care you need?</h3><p>Answer a few quick questions and we'll point you in the right direction — no pressure, no jargon.</p></div>
        <a class="btn btn-clay" href="#book">Get in touch →</a>
      </div>
    </div>
  </section>

  <!-- app -->
  <section class="section app" id="app">
    <div class="wrap">
      <div class="reveal">
        <h2>Stay connected to the moments that matter</h2>
        <p class="lede" style="margin:10px 0 22px">Our Care App keeps the whole family gently in the loop — wherever they are.</p>
        <div class="fl"><span class="ix">01</span><div><h4>See who's visiting today</h4><p>Know exactly when your carer has been and when they're due.</p></div></div>
        <div class="fl"><span class="ix">02</span><div><h4>Read real visit notes</h4><p>From breakfast choices to how they're feeling — all recorded with care.</p></div></div>
        <div class="fl"><span class="ix">03</span><div><h4>Access care records anytime</h4><p>Easily view care plans, assessments and updates.</p></div></div>
        <div class="fl"><span class="ix">04</span><div><h4>Know medication's been taken</h4><p>Confidence that medication's been given and needs are met.</p></div></div>
        <div class="video-embed reveal" data-yt="vnTnK0pfv0c" role="button" tabindex="0" aria-label="Play video: Using the Otter Homecare app" style="margin-top:26px"><img src="https://img.youtube.com/vi/vnTnK0pfv0c/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/vnTnK0pfv0c/hqdefault.jpg'" alt="Using the Otter Homecare Care App" /><span class="playbtn"><span></span></span><span class="vlabel">See the Care App in action</span></div>
      </div>
      <div class="app-stage reveal">
        <div class="phone"><img src={img("ff72ba_92c3196bddda4a5f87fda89ca88bb38b~mv2.png")} alt="The Otter Care App showing a visit summary" /></div>
        <figure class="app-note n-top">
          <span class="ava"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="A daughter who uses the Otter Care App" /></span>
          <figcaption>"Now I know Mum's OK<br>without having to call."</figcaption>
        </figure>
        <figure class="app-note n-bottom">
          <span class="ava"><img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="A son who stays involved through the app" /></span>
          <figcaption>"I can stay involved<br>from miles away."</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <!-- stories + homecare.co.uk reviews (SAMPLE — replace with official homecare.co.uk Review Widget) -->
  <section class="section tmt hcrev" id="stories">
    <div class="wrap">
      <div class="head-c reveal"><h2>The families we look after</h2></div>
      <div class="story reveal">
        <div class="story-pic"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="A client at home" /></div>
        <div class="story-body">
          <div class="star">★★★★★</div>
          <blockquote>"After Mum's fall we were terrified she'd have to leave the home she's lived in for 40 years. Otter sat with us, built a plan around her, and matched her with two carers she now calls friends. She's still in her own kitchen — and we finally sleep at night."</blockquote>
          <div class="by">The Hughes family<span>Caring for Margaret · Bradford-on-Avon</span></div>
        </div>
      </div>
      <div class="hc-bar reveal">
        <div class="hc-score">
          <div class="hc-badge">9.4</div>
          <div><b>homecare.co.uk Review Score for Otter Homecare</b><small>Based on 14 verified reviews</small></div>
        </div>
        <a class="hc-brand" href="https://www.homecare.co.uk" target="_blank" rel="noopener"><span class="dot"></span>homecare<i>.co.uk</i></a>
      </div>
      <div class="hc-grid">
        <div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★☆</span><span class="hc-date">27 Mar 2026</span></div><p>"Otter staff are superb in every way. They are kind, and really understand what being caring carers is all about."</p><div class="hc-by">Frances W<span>Client</span></div></div>
        <div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">12 Dec 2025</span></div><p>"All home care should be as good as this. Lovely carers, nothing is too much trouble — they don't just do the job, they care."</p><div class="hc-by">E S<span>Client</span></div></div>
        <div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">14 Oct 2025</span></div><p>"The Otter Home Care staff were incredibly kind and considerate in all their dealings with me and my family."</p><div class="hc-by">J K<span>Stepson of Client</span></div></div>
        <div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">30 Sep 2025</span></div><p>"I cannot recommend Otter Home Care highly enough. We used them to provide care for my elderly dad and they were wonderful."</p><div class="hc-by">Helen F<span>Daughter of Client</span></div></div>
      </div>
      <div class="hc-foot reveal"><a href="https://www.homecare.co.uk" target="_blank" rel="noopener">Read all 14 reviews on homecare.co.uk →</a></div>
    </div>
  </section>

  <!-- benefits -->
  <section class="section benefits" id="benefits">
    <div class="wrap">
      <div class="reveal">
        <h2>Stay in the place you love</h2>
        <p class="lede">For many families, staying at home with the right support is the most comfortable — and most empowering — option.</p>
        <div class="blist">
          <div class="b"><div class="ic"><img src="/assets/icons/home.svg" alt="" /></div><div><b>Stay in the place you love</b><p>No need to leave home or uproot your life.</p></div></div>
          <div class="b"><div class="ic"><img src="/assets/icons/key.svg" alt="" /></div><div><b>Keep your independence</b><p>Care fits around your routine, not the other way around.</p></div></div>
          <div class="b"><div class="ic"><img src="/assets/icons/pound.svg" alt="" /></div><div><b>Pay only for the time you need</b><p>Flexible, tailored support — never more than you use.</p></div></div>
          <div class="b"><div class="ic"><img src="/assets/icons/heart.svg" alt="" /></div><div><b>One-to-one attention</b><p>Care that's personal, consistent and centred around you.</p></div></div>
          <div class="b"><div class="ic"><img src="/assets/icons/paw.svg" alt="" /></div><div><b>Stay close to your pets</b><p>Keep the comfort of your companions by your side.</p></div></div>
        </div>
      </div>
      <div class="pic reveal"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="Client enjoying tea at home" /></div>
    </div>
  </section>

  <!-- careers -->
  <section class="section careers" id="careers">
    <div class="wrap reveal">
      <div class="careers-copy">
        <h2 style="margin-top:0">Become an Otter Care Professional</h2>
        <p class="lede" style="color:#4a3408;margin:12px 0 0;max-width:34ch">Join a small, local team who genuinely look out for each other — with proper training, flexible hours and industry-leading pay.</p>
        <div class="perks"><span>Flexible hours</span><span>Industry-leading pay</span><span>Full training &amp; support</span><span>A supportive team</span></div>
        <a class="btn btn-clay" href="/careers" style="margin-top:22px">Find out more →</a>
      </div>
      <img class="careers-otter" src="/assets/otter-mascot.png" alt="Friendly Otter Homecare mascot waving" loading="lazy" />
    </div>
  </section>

  <div class="wave wave--to-teal" aria-hidden="true"><svg viewBox="0 0 1200 40" preserveAspectRatio="none"><path d="M0,40 L0,18 C150,32 250,6 420,16 C560,24 660,4 820,14 C980,24 1080,8 1200,18 L1200,40 Z"></path></svg></div>

  <!-- booking -->
  <section class="section book" id="book">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
        <h2>Let's find the right care, together</h2>
        <p class="lede">Tell us a little about who needs support and we'll be in touch to arrange a free home visit — at a time that suits you.</p>
        <div class="reassure">
          <div><span class="ic">✓</span> Free, no-obligation home visit</div>
          <div><span class="ic">✓</span> A tailored care plan, built around you</div>
          <div><span class="ic">✓</span> Speak to a real local person — never a call centre</div>
        </div>
        <div class="callbox">
          <small>Prefer to talk? Call us any time</small>
          <a href="tel:01225690022">01225 690022</a>
        </div>
      </div>
      <div class="reveal">
        <form class="form" id="bookForm" action="/api/contact" method="POST" novalidate>
          <h3>Book a free assessment</h3>
          <p class="fhint">We usually reply the same day.</p>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
          <div class="frow">
            <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" required placeholder="Jane Smith" /></div>
            <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" required placeholder="07700 900000" /></div>
          </div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="jane@example.com" /></div>
          <div class="frow">
            <div class="field"><label for="who">Who is the care for?</label><select id="who" name="who"><option>My parent</option><option>My partner</option><option>Myself</option><option>Another relative</option><option>Someone else</option></select></div>
            <div class="field"><label for="area">Your area</label><select id="area" name="area"><option>Trowbridge</option><option>Bradford-on-Avon</option><option>Melksham</option><option>Westbury</option><option>Frome</option><option>Elsewhere nearby</option></select></div>
          </div>
          <div class="field"><label for="msg">How can we help? (optional)</label><textarea id="msg" name="msg" placeholder="A little about the support you're looking for…"></textarea></div>
          <button class="btn btn-primary" type="submit">Request my free assessment →</button>
          <p class="privacy">Your details are kept private and never shared. See our <a href="/privacy" style="text-decoration:underline">privacy policy</a>.</p>
        </form>
        <div class="form-success" id="formSuccess">
          <div class="tick">✓</div>
          <h3>Thank you — we've got it</h3>
          <p>One of our local team will be in touch very soon to arrange your free visit. If it's urgent, please call <strong>01225 690022</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- accreditation -->
  <section class="accred">
    <div class="wrap">
      <span class="lab">Regulated &amp; accredited</span>
      <a href="https://www.cqc.org.uk" target="_blank" rel="noopener"><img src={img("ff72ba_1dd84e5fdfa54621847dc493095a773f~mv2.jpg")} alt="Regulated by the Care Quality Commission" /></a>
      <a href="https://www.homecareassociation.org.uk" target="_blank" rel="noopener"><img src={img("ff72ba_91a56724044b4b7e9b3fcaf45212292b~mv2.png")} alt="Member of the Homecare Association" /></a>
      <a class="wide" href="https://www.homecare.co.uk" target="_blank" rel="noopener"><img src={img("ff72ba_08d2912203b449fcb907fb6fa089403a~mv2.jpg")} alt="Reviewed on homecare.co.uk" /></a>
    </div>
  </section>

  <script is:inline>
    const f = document.getElementById("bookForm");
    if (f) f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = f.querySelector('button[type="submit"]');
      const data = Object.fromEntries(new FormData(f).entries());
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) });
        const json = await res.json();
        if (res.ok && json.ok) { f.classList.add("hide"); document.getElementById("formSuccess").classList.add("show"); }
        else { btn.disabled = false; btn.textContent = "Request my free assessment →"; alert(json.error || "Something went wrong — please call us on 01225 690022."); }
      } catch { btn.disabled = false; btn.textContent = "Request my free assessment →"; alert("Something went wrong — please call us on 01225 690022."); }
    });
  </script>
</SiteLayout>
