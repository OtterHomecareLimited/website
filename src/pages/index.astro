---
import SiteLayout from "../layouts/SiteLayout.astro";
const img = (f: string) => `/img/${f}`;
---
<SiteLayout
  title="Otter Homecare — Compassionate home care in Wiltshire & Somerset"
  description="Warm, flexible home care from a small, local team across Trowbridge, Bradford-on-Avon, Melksham, Westbury and Frome. CQC regulated. Book a free assessment."
>
  <!-- hero -->
  <header class="hero" id="top">
    <div class="blob x"></div>
    <div class="blob y"></div>
    <div class="wrap">
      <div>
        <span class="eyebrow">Local home care in Wiltshire &amp; Somerset</span>
        <h1 style="margin-top:18px">Care for a <span class="hl">kinder</span> future</h1>
        <p class="sub">Warm, flexible home care from a small, local team who treat your family like our own — from live-in support to a friendly visit and a cup of tea.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="#book">Book a free assessment</a>
          <a class="btn btn-ghost btn-lg" href="tel:01225690022">Call 01225 690022</a>
        </div>
        <div class="chips">
          <span class="chip">CQC regulated</span>
          <span class="chip">Homecare Association member</span>
          <span class="chip">★ Rated on homecare.co.uk</span>
        </div>
      </div>
      <div class="hero-media">
        <div class="main"><img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="Otter carer supporting a client outdoors" /></div>
        <div class="bubble b1"><span class="em"><img src={img("ff72ba_6b697f1e4a3a41c1aecccee2682244ff~mv2.png")} alt="" /></span><div>Visits your way<small>from a quick call-in</small></div></div>
        <div class="bubble b2"><span class="em"><img src={img("ff72ba_2bf82f37a4d848749064454cc8f0df2c~mv2.png")} alt="" /></span><div>Live updates<small>via the Care App</small></div></div>
      </div>
    </div>
  </header>

  <!-- trust strip -->
  <section class="trust"><div class="wrap">
    <div class="item"><div class="ic">✓</div><div><small>Regulated by</small><b>Care Quality Commission</b></div></div>
    <div class="item"><div class="ic">✓</div><div><small>Member of</small><b>The Homecare Association</b></div></div>
    <div class="item"><div class="ic">✓</div><div><small>Reviewed on</small><b>homecare.co.uk</b></div></div>
    <div class="item"><div class="ic">✓</div><div><small>Flexible</small><b>Visits to suit you</b></div></div>
  </div></section>

  <!-- proof band -->
  <section class="proof"><div class="wrap">
    <div class="pf"><b>1</b><small>One local team, not a national branch</small></div>
    <div class="pf"><b>1-to-1</b><small>Carefully matched, familiar carers</small></div>
    <div class="pf"><b>Your way</b><small>Visit lengths to suit you</small></div>
    <div class="pf"><b>5 towns</b><small>Across Wiltshire &amp; Somerset</small></div>
  </div></section>

  <!-- founder -->
  <section class="section founder" id="founder">
    <div class="wrap">
      <div class="pic reveal"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="Founder Jamie with his father" /></div>
      <div class="reveal">
        <span class="eyebrow on-clay">Our story</span>
        <h2>Care that started at our own kitchen table</h2>
        <blockquote>Otter was born after my father had a stroke and I became his main carer. Combined with 20 years in Asia — where older generations are deeply respected — it inspired a kinder, more personal kind of care here in Wiltshire and Somerset.</blockquote>
        <div class="sig">Jamie Rowland-Jones<span>Founder, Otter Homecare</span></div>
      </div>
    </div>
  </section>

  <!-- services -->
  <section class="section services" id="services">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">Care services</span>
        <h2>Care for your parents, partner, or yourself</h2>
      </div>
      <div class="svc-grid">
        <a class="svc reveal" href="/live-in-care"><div class="img"><span class="tag">Popular</span><img src={img("ff72ba_0aa05eb659ee4c64a5d410e57b21eff0~mv2.jpg")} alt="" /></div><div class="body"><h3>Live-in Care</h3><p>Expert round-the-clock care in the comfort of your own home.</p><span class="more">Learn more →</span></div></a>
        <a class="svc reveal" href="/care-services"><div class="img"><img src={img("ff72ba_3a8fe18215c24b3e9cb6884f0bf44228~mv2.jpg")} alt="" /></div><div class="body"><h3>Visiting Care</h3><p>Friendly carers visiting your home with flexible, tailored support.</p><span class="more">Learn more →</span></div></a>
        <a class="svc reveal" href="/conditions"><div class="img"><img src={img("ff72ba_356da85da3114f4ea8c98fa716675d83~mv2.jpg")} alt="" /></div><div class="body"><h3>Conditions We Care For</h3><p>Specialist support for dementia, recovery and a range of conditions.</p><span class="more">Learn more →</span></div></a>
        <a class="svc reveal" href="/companionship"><div class="img"><img src={img("ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg")} alt="" /></div><div class="body"><h3>Companionship</h3><p>A friendly face, shared hobbies and genuine connection, every visit.</p><span class="more">Learn more →</span></div></a>
      </div>
    </div>
  </section>

  <!-- different -->
  <section class="section diff" id="diff">
    <div class="wrap">
      <div class="head reveal">
        <span class="eyebrow">Why families choose us</span>
        <h2>What makes us different</h2>
        <p>We're one local team who answer the phone ourselves — not a branch of a national chain or a call centre.</p>
      </div>
      <div class="diff-grid">
        <div class="feat lead reveal"><div class="ic"><img src={img("ff72ba_5700a715dff44d6c8efc49ea98140c28~mv2.png")} alt="" /></div><h3>Good Enough for Dad</h3><p>We only hire carers we'd trust with our own families. In fact, our carers support my own dad.</p></div>
        <div class="feat reveal"><div class="ic"><img src={img("ff72ba_fc3d57bfd4854541b312b420e82571e0~mv2.png")} alt="" /></div><h3>A small, dedicated team</h3><p>Tight-knit, so carers get to know each client and family properly.</p></div>
        <div class="feat reveal"><div class="ic"><img src={img("ff72ba_c1c4f601da794bc6883e08519553e393~mv2.png")} alt="" /></div><h3>Local &amp; personal</h3><p>Based in Trowbridge and just around the corner — always close by.</p></div>
        <div class="feat reveal"><div class="ic"><img src={img("ff72ba_2bf82f37a4d848749064454cc8f0df2c~mv2.png")} alt="" /></div><h3>Care App transparency</h3><p>Families see real-time updates from every visit, for total peace of mind.</p></div>
        <div class="feat reveal"><div class="ic"><img src={img("ff72ba_6b697f1e4a3a41c1aecccee2682244ff~mv2.png")} alt="" /></div><h3>Visits that suit you</h3><p>From a quick daily call-in to a full day together — care that flexes around life.</p></div>
        <div class="feat reveal"><div class="ic"><img src={img("ff72ba_1a0a055e1b314d97a1b43f988176b52d~mv2.png")} alt="" /></div><h3>Otter Happy Hour</h3><p>A free hour of care each month to enjoy something special.</p></div>
      </div>
    </div>
  </section>

  <!-- care you can trust -->
  <section class="section trustwhy" id="trust-why">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">Care you can trust</span>
        <h2>Peace of mind, built in</h2>
      </div>
      <div class="trust3">
        <div class="t3 reveal"><span class="ix">01</span><h3>Fully CQC-regulated</h3><p>Independently inspected against the highest national standards — never an unregulated introductory agency.</p></div>
        <div class="t3 reveal"><span class="ix">02</span><h3>Our own carers</h3><p>Directly employed and trained by us. No freelancers, no agency staff — just familiar, friendly faces.</p></div>
        <div class="t3 reveal"><span class="ix">03</span><h3>Matched &amp; consistent</h3><p>The same small team of carers, who get to know you, your routine and the things that matter most.</p></div>
      </div>
    </div>
  </section>

  <!-- help -->
  <section class="section help" id="help">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">How we can help</span>
        <h2>Support tailored to everyday life</h2>
        <p class="lede">Our Care Professionals are trained across a wide range of support — mixed and matched to suit you.</p>
      </div>
      <div class="help-grid">
        <div class="help-item reveal"><img src={img("ff72ba_83df1eb983a540ec9504319d2046ca73~mv2.jpg")} alt="" /><span>Personal care</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_ccfd35686af147f6a016e747c91942d6~mv2.jpg")} alt="" /><span>Medication management</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_65e6bbb5381c4de39626e5fd8be7f9aa~mv2.jpg")} alt="" /><span>Meal preparation</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_7402ffd16d2848ac9e7a9bb2ac85cdf9~mv2.jpg")} alt="" /><span>Transportation</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_937a9c9f723a4acbb4b07d6c06efc354~mv2.jpg")} alt="" /><span>Hobbies &amp; interests</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_bcb4f2e40c2f405b8d0b51b783e888b2~mv2.jpg")} alt="" /><span>Physical activity</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_2b291b82c9c04a17b6b9a51f6953fd1f~mv2.jpg")} alt="" /><span>Home help</span></div>
        <div class="help-item reveal"><img src={img("ff72ba_65e6bbb5381c4de39626e5fd8be7f9aa~mv2.jpg")} alt="" /><span>Grocery shopping</span></div>
      </div>
    </div>
  </section>

  <!-- steps -->
  <section class="section steps" id="steps">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">How to get started</span>
        <h2>A simple, reassuring process</h2>
      </div>
      <div class="steps-grid">
        <div class="step reveal"><div class="ic"><img src={img("ff72ba_042db41963494f38a129bc17b0ce576e~mv2.png")} alt="" /></div><span class="sn">Step 1</span><h3>Call us</h3><p>Complimentary, expert guidance tailored to your needs.</p></div>
        <div class="step reveal"><div class="ic"><img src={img("ff72ba_fe924b8c9a6a414181c34d43e5bd4f69~mv2.png")} alt="" /></div><span class="sn">Step 2</span><h3>Home visit</h3><p>Our qualified manager visits to create your tailored care plan.</p></div>
        <div class="step reveal"><div class="ic"><img src={img("ff72ba_0bbd91564fe4494ea87681e131d16a57~mv2.png")} alt="" /></div><span class="sn">Step 3</span><h3>Start care</h3><p>Your matched Care Professional begins support on your terms.</p></div>
        <div class="step reveal"><div class="ic"><img src={img("ff72ba_450bd4f5f0764d2ab2652a812a08121a~mv2.png")} alt="" /></div><span class="sn">Step 4</span><h3>Ongoing</h3><p>We review and adapt your care as your needs change.</p></div>
      </div>
      <div class="quizcard reveal">
        <div><h3>Not sure what care you need?</h3><p>Answer a few quick questions and we'll point you in the right direction — no pressure, no jargon.</p></div>
        <a class="btn btn-clay" href="#book">Get in touch →</a>
      </div>
    </div>
  </section>

  <!-- app -->
  <section class="section app" id="app">
    <div class="wrap">
      <div class="panel reveal"><div class="phone"><img src={img("ff72ba_92c3196bddda4a5f87fda89ca88bb38b~mv2.png")} alt="Otter Care App" /></div></div>
      <div class="reveal">
        <span class="eyebrow">The Otter Care App</span>
        <h2>Stay connected to the moments that matter</h2>
        <div class="fl"><span class="ix">01</span><div><h4>See who's visiting today</h4><p>Know exactly when your carer has been and when they're due.</p></div></div>
        <div class="fl"><span class="ix">02</span><div><h4>Read real visit notes</h4><p>From breakfast choices to how they're feeling — all recorded with care.</p></div></div>
        <div class="fl"><span class="ix">03</span><div><h4>Access care records anytime</h4><p>Easily view care plans, assessments and updates.</p></div></div>
        <div class="fl"><span class="ix">04</span><div><h4>Know medication's been taken</h4><p>Confidence that medication's been given and needs are met.</p></div></div>
      </div>
    </div>
  </section>

  <!-- stories (SAMPLE testimonials — to be replaced with real, consented quotes) -->
  <section class="section tmt" id="stories">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow on-clay">Real stories</span>
        <h2>The families we look after</h2>
      </div>
      <div class="story reveal">
        <div class="story-pic"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="A client at home" /></div>
        <div class="story-body">
          <div class="star">★★★★★</div>
          <blockquote>"After Mum's fall we were terrified she'd have to leave the home she's lived in for 40 years. Otter sat with us, built a plan around her, and matched her with two carers she now calls friends. She's still in her own kitchen — and we finally sleep at night."</blockquote>
          <div class="by">The Hughes family<span>Caring for Margaret · Bradford-on-Avon</span></div>
        </div>
      </div>
      <div class="tmt-grid">
        <div class="quote reveal"><div class="star">★★★★★</div><p>"The carers feel like family now. Mum lights up when they arrive, and the app means I can see she's well even when I'm away."</p><div class="by"><span class="av">SM</span><div><b>Sarah M.</b><small>Daughter · Melksham</small></div></div></div>
        <div class="quote reveal"><div class="star">★★★★★</div><p>"Genuinely kind and never rushed. They fit visits around Dad's day, so he always has time to enjoy the company."</p><div class="by"><span class="av">DR</span><div><b>David R.</b><small>Son · Trowbridge</small></div></div></div>
        <div class="quote reveal"><div class="star">★★★★★</div><p>"From the first call I felt understood. The care plan fits our lives perfectly and the team are wonderful."</p><div class="by"><span class="av">MT</span><div><b>Margaret T.</b><small>Client · Frome</small></div></div></div>
      </div>
    </div>
  </section>

  <!-- benefits -->
  <section class="section benefits" id="benefits">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow on-clay">Why home care</span>
        <h2>Stay in the place you love</h2>
        <p class="lede">For many families, staying at home with the right support is the most comfortable — and most empowering — option.</p>
        <div class="blist">
          <div class="b"><div class="ic">✓</div><div><b>Stay in the place you love</b><p>No need to leave home or uproot your life.</p></div></div>
          <div class="b"><div class="ic">✓</div><div><b>Keep your independence</b><p>Care fits around your routine, not the other way around.</p></div></div>
          <div class="b"><div class="ic">✓</div><div><b>Pay only for the time you need</b><p>Flexible, tailored support — never more than you use.</p></div></div>
          <div class="b"><div class="ic">✓</div><div><b>One-to-one attention</b><p>Care that's personal, consistent and centred around you.</p></div></div>
          <div class="b"><div class="ic">✓</div><div><b>Stay close to your pets</b><p>Keep the comfort of your companions by your side.</p></div></div>
        </div>
      </div>
      <div class="pic reveal"><img src={img("ff72ba_a006c15eb20c4eb1b0930b2825f55912~mv2.jpg")} alt="Client enjoying tea at home" /></div>
    </div>
  </section>

  <!-- careers -->
  <section class="section careers" id="careers">
    <div class="wrap reveal">
      <div>
        <span class="eyebrow" style="background:rgba(255,255,255,.2);color:#fff">Careers</span>
        <h2 style="margin-top:14px">Become an Otter Care Professional</h2>
        <div class="perks"><span>Flexible hours</span><span>Industry-leading pay</span><span>Full training &amp; support</span><span>A supportive team</span></div>
      </div>
      <a class="btn btn-ghost" href="/careers">Find out more →</a>
    </div>
  </section>

  <!-- booking -->
  <section class="section book" id="book">
    <div class="wrap">
      <div class="reveal">
        <span class="eyebrow" style="background:rgba(255,255,255,.14);color:#fff">Free, no-obligation assessment</span>
        <h2>Let's find the right care, together</h2>
        <p class="lede">Tell us a little about who needs support and we'll be in touch to arrange a free home visit — at a time that suits you.</p>
        <div class="reassure">
          <div><span class="ic">✓</span> Free, no-obligation home visit</div>
          <div><span class="ic">✓</span> A tailored care plan, built around you</div>
          <div><span class="ic">✓</span> Speak to a real local person — never a call centre</div>
        </div>
        <div class="callbox">
          <small>Prefer to talk? Call us any time</small>
          <a href="tel:01225690022">01225 690022</a>
        </div>
      </div>
      <div class="reveal">
        <form class="form" id="bookForm" action="/api/contact" method="POST" novalidate>
          <h3>Book a free assessment</h3>
          <p class="fhint">We usually reply the same day.</p>
          <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
          <div class="frow">
            <div class="field"><label for="name">Your name</label><input id="name" name="name" type="text" required placeholder="Jane Smith" /></div>
            <div class="field"><label for="phone">Phone</label><input id="phone" name="phone" type="tel" required placeholder="07700 900000" /></div>
          </div>
          <div class="field"><label for="email">Email</label><input id="email" name="email" type="email" placeholder="jane@example.com" /></div>
          <div class="frow">
            <div class="field"><label for="who">Who is the care for?</label><select id="who" name="who"><option>My parent</option><option>My partner</option><option>Myself</option><option>Another relative</option><option>Someone else</option></select></div>
            <div class="field"><label for="area">Your area</label><select id="area" name="area"><option>Trowbridge</option><option>Bradford-on-Avon</option><option>Melksham</option><option>Westbury</option><option>Frome</option><option>Elsewhere nearby</option></select></div>
          </div>
          <div class="field"><label for="msg">How can we help? (optional)</label><textarea id="msg" name="msg" placeholder="A little about the support you're looking for…"></textarea></div>
          <button class="btn btn-primary" type="submit">Request my free assessment →</button>
          <p class="privacy">Your details are kept private and never shared. See our <a href="/privacy" style="text-decoration:underline">privacy policy</a>.</p>
        </form>
        <div class="form-success" id="formSuccess">
          <div class="tick">✓</div>
          <h3>Thank you — we've got it</h3>
          <p>One of our local team will be in touch very soon to arrange your free visit. If it's urgent, please call <strong>01225 690022</strong>.</p>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    const f = document.getElementById("bookForm");
    if (f) f.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = f.querySelector('button[type="submit"]');
      const data = Object.fromEntries(new FormData(f).entries());
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/contact", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(data),
        });
        const json = await res.json();
        if (res.ok && json.ok) {
          f.classList.add("hide");
          document.getElementById("formSuccess").classList.add("show");
        } else {
          btn.disabled = false; btn.textContent = "Request my free assessment →";
          alert(json.error || "Something went wrong — please call us on 01225 690022.");
        }
      } catch {
        btn.disabled = false; btn.textContent = "Request my free assessment →";
        alert("Something went wrong — please call us on 01225 690022.");
      }
    });
  </script>
</SiteLayout>
