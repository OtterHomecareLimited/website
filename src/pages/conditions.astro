---
import SiteLayout from "../layouts/SiteLayout.astro";
const img = (f: string) => `/img/${f}`;
const conditions = [
  { name: "Dementia", body: "We help people living with dementia stay safe, comfortable and connected at home — for as long as possible. Our Care Professionals are trained in dementia care and work with families to support memory, routine and wellbeing." },
  { name: "Stroke", body: "After a stroke, home is often the best place to rebuild strength and independence. We support recovery with compassion and practical help to make everyday life easier." },
  { name: "Palliative & End-of-Life", body: "Our Care Professionals offer gentle, sensitive support to those living with life-limiting illnesses. We help people stay in familiar surroundings, surrounded by love and dignity." },
  { name: "Physical Disabilities", body: "We empower people living with physical disabilities to thrive at home with personalised, enabling support — always focused on your goals and autonomy." },
];
---
<SiteLayout
  title="Conditions We Support | Otter Homecare"
  description="Compassionate, specialist home care for dementia, stroke recovery, palliative needs and physical disabilities across Wiltshire and Somerset. Personalised, dignified care at home."
>
  <header class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">Home</a> · <a href="/care-services">Care Services</a> · Conditions</div>
      <h1>Conditions we support</h1>
      <p>Caring for a range of conditions with compassion and expertise — always with kindness, respect and the highest standards of care, in the comfort of your own home.</p>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="reveal" style="max-width:62ch">
        <p class="lede" style="margin-bottom:14px">We support people living with a variety of conditions — from dementia and stroke recovery to those living with physical disabilities or nearing end of life. Our approach is always personalised, enabling our clients to stay in the comfort of their own home while receiving tailored, dignified care.</p>
        <p class="lede">Every person's situation is unique. That's why we take time to get to know you and your family — so we can match the right Care Professionals and plan support that truly fits.</p>
      </div>
    </div>
  </section>

  <section class="section trustwhy" style="padding-top:0">
    <div class="wrap">
      <div class="trust3" style="grid-template-columns:repeat(2,1fr)">
        {conditions.map((c, i) => (
          <div class="t3 reveal"><span class="ix">{String(i + 1).padStart(2, "0")}</span><h3>{c.name}</h3><p>{c.body}</p></div>
        ))}
      </div>
      <p class="lede reveal" style="text-align:center;max-width:60ch;margin:40px auto 0">Our Care Professionals are trained to care for a variety of conditions. If your loved one has a condition not listed here, or you're unsure what support they might need, we're always happy to offer advice.</p>
    </div>
  </section>

  <section class="section book" id="book-cta">
    <div class="wrap" style="grid-template-columns:1fr;text-align:center;display:block">
      <div class="reveal" style="max-width:36ch;margin:0 auto">
        <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
        <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
        <p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person who can talk you through the support available.</p>
        <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
          <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
          <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
