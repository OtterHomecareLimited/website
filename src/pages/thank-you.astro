---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  title="Thank you | Otter Homecare"
  description="Thank you for getting in touch with Otter Homecare. We'll be in touch very soon."
>
  <section class="big-cta" style="padding:120px 0">
    <div class="wrap">
      <div style="font-size:56px;margin-bottom:12px">🦦</div>
      <h2>Thank you — message received.</h2>
      <p>We've got your enquiry and someone local will be in touch very soon. If it's urgent, you're always welcome to call us directly.</p>
      <div class="row">
        <a href="tel:01225690022" class="phone">📞 01225 690022</a>
        <a href="/" class="cta large" style="background:#fff;color:var(--teal)">Back to home →</a>
      </div>
    </div>
  </section>
</BaseLayout>
