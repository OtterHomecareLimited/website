---
import RatedBadge from "../components/RatedBadge.astro";
import Photo from "../components/Photo.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { towns, helpCards } from "../data/towns";

export function getStaticPaths() {
  return towns.map((town) => ({ params: { slug: town.slug }, props: { town } }));
}

const { town } = Astro.props;
const initial = town.testimonial.author.trim().charAt(0);

// FAQPage schema for the town-specific questions. Only emitted where a town
// actually has FAQs — Google penalises markup that isn't visible on the page.
const faqSchema = town.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: town.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    }
  : null;
---
{faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
<SiteLayout title={town.title} description={town.description} ogImage={town.photo} breadcrumbLabel={town.name}>
  <header class="phero"><div class="wrap">
    <div class="crumb"><a href="/">Home</a> · <a href="/areas-we-cover">Areas We Cover</a> · {town.name}</div>
    <h1>{town.h1}</h1>
    <p>{town.intro}</p>
  </div></header>

  <!-- genuinely local -->
  <section class="section"><div class="wrap" style="max-width:760px">
    <div class="reveal">
      <span class="eyebrow">Genuinely local</span>
      <h2 style="font-size:clamp(26px,3.2vw,38px);margin:10px 0 12px">{town.locHeadline}</h2>
      <p class="lede" style="max-width:none" set:html={town.locBody}></p>
    </div>
  </div></section>

  <!-- local trust panel -->
  <section class="section tmt"><div class="wrap" style="max-width:980px">
    <div class="head-c reveal" style="margin-bottom:24px"><h2>Your local Otter team</h2></div>
    <div class="localtrust reveal">
      <Photo class="lt-photo" src={town.photo} alt={`Otter Homecare Care Professionals supporting families in ${town.name}`} priority sizes="(max-width: 900px) 100vw, 420px" />
      <div class="lt-facts">
        <div class="lt-fact"><span class="k">homecare.co.uk</span><span class="v">9.5 / 10</span></div>
        <div class="lt-fact"><span class="k">Local office</span><span class="v sm">01225 690022</span></div>
        <div class="lt-fact"><span class="k">Based at</span><span class="v sm">Arlington House, 72 Fore Street, Trowbridge</span></div>
        <div class="lt-villages">{town.chips.map((c) => <span>{c}</span>)}</div>
      </div>
    </div>
  </div></section>

  <!-- how we can help -->
  <section class="section"><div class="wrap">
    <div class="head-c reveal"><h2>How we can help in {town.name}</h2></div>
    <div class="svc-grid town-svc">
      {helpCards.map((c) => (
        <a class="svc reveal" href={c.href}>
          <div class="img"><Photo src={c.img} alt="" sizes="(max-width: 880px) 50vw, 260px" /></div>
          <div class="body"><h3>{c.title}</h3><p>{c.blurb}</p><span class="more">Learn more →</span></div>
        </a>
      ))}
    </div>
  </div></section>

  <!-- Depth blocks — only render for towns that have the local detail written.
       Trowbridge, Melksham and Frome fall through untouched until they do. -->
  {town.localCare && (
    <section class="section bg-sky"><div class="wrap" style="max-width:760px">
      <div class="reveal">
        <span class="eyebrow">Local healthcare</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:8px 0 12px">{town.localCare.headline}</h2>
        <p class="lede" style="max-width:none" set:html={town.localCare.body}></p>
      </div>
    </div></section>
  )}

  {town.community && (
    <section class="section"><div class="wrap" style="max-width:760px">
      <div class="reveal">
        <span class="eyebrow">In the community</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:8px 0 12px">{town.community.headline}</h2>
        <p class="lede" style="max-width:none" set:html={town.community.body}></p>
      </div>
    </div></section>
  )}

  {town.funding && (
    <section class="section tmt"><div class="wrap" style="max-width:760px">
      <div class="reveal">
        <span class="eyebrow">Costs and funding</span>
        <h2 style="font-size:clamp(24px,3vw,32px);margin:8px 0 12px">{town.funding.headline}</h2>
        <p class="lede" style="max-width:none" set:html={town.funding.body}></p>
        <a class="btn btn-primary" href="/cost-of-home-care" style="margin-top:16px">See costs &amp; funding →</a>
      </div>
    </div></section>
  )}

  <!-- How much support, localised. Was a live-in-only cross-link; widened
       21 Aug 2026 so each town page carries the whole range rather than
       jumping straight to live-in. Keeps the geo-targeting and adds two more
       real search terms ("visiting care {town}", "night care {town}"). -->
  <section class="section"><div class="wrap" style="max-width:980px">
    <div class="head-c reveal">
      <span class="eyebrow">How much support?</span>
      <h2 style="font-size:clamp(24px,3vw,32px);margin:8px 0 10px">Care in {town.name}, at whatever level suits</h2>
      <p class="lede" style="max-width:62ch;margin:0 auto">Most families in {town.name} start small and change as things change — you are choosing how much help you would like, not a fixed package.</p>
    </div>
    <div class="scale-row" style="margin-top:26px">
      <a class="scale reveal" href="/visiting-care">
        <span class="sc-ic"><img src="/assets/icons/door.svg" alt="" loading="lazy" /></span>
        <b>We visit you</b>
        <p>From a friendly call-in once a day to several visits, around {town.name} and villages like {town.chips.slice(0, 2).join(" and ")}.</p>
        <span class="more">Visiting care →</span>
      </a>
      <a class="scale reveal" href="/night-care">
        <span class="sc-ic"><img src="/assets/icons/window.svg" alt="" loading="lazy" /></span>
        <b>We stay the night</b>
        <p>Someone sleeping over who can be woken once or twice, or awake the whole night if that is what is needed.</p>
        <span class="more">Night care →</span>
      </a>
      <a class="scale reveal" href="/live-in-care">
        <span class="sc-ic"><img src="/assets/icons/home.svg" alt="" loading="lazy" /></span>
        <b>We live in</b>
        <p>A Care Professional living alongside them in {town.name} — the alternative to a move into a care home.</p>
        <span class="more">Live-in care →</span>
      </a>
    </div>
  </div></section>

  <!-- founder video -->
  <section class="section tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">Meet our founder</span><h2>Hi, I'm Jamie</h2><p class="lede">A bit about why I started Otter Homecare — and the one-to-one care we bring to families across Wiltshire and Somerset.</p></div>
    <div class="video-embed reveal" data-yt="BFJ9QbUBr9I" role="button" tabindex="0" aria-label="Play: Hi, I'm Jamie">
      <img src="/img/poster-jamie.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/BFJ9QbUBr9I/hqdefault.jpg'" alt="Jamie, founder of Otter Homecare" loading="lazy" />
      <span class="playbtn"><span></span></span>
      <span class="vlabel">Watch: Hi, I'm Jamie</span>
    </div>
  </div></section>

  <!-- Town FAQs. Markup matches /faqs so the global .faq > button accordion
       handler in SiteLayout picks these up with no extra script. -->
  {town.faqs && town.faqs.length > 0 && (
    <section class="section"><div class="wrap" style="max-width:820px">
      <div class="head-c reveal"><span class="eyebrow">Good to know</span><h2>Questions from {town.name} families</h2></div>
      <div class="faqs reveal">
        {town.faqs.map((f) => (
          <div class="faq">
            <button type="button">{f.q}<span class="tog">+</span></button>
            <div class="ans"><p>{f.a}</p></div>
          </div>
        ))}
      </div>
    </div></section>
  )}

  <!-- local testimonial -->
  <section class="section tmt"><div class="wrap">
    <div class="quote reveal" style="max-width:760px;margin:0 auto">
      <div class="star">★★★★★</div>
      <p>"{town.testimonial.quote}"</p>
      <div class="by"><span class="av">{initial}</span><div><b>{town.testimonial.author}</b><span>{town.testimonial.role}</span></div></div>
    </div>
  </div></section>

  <!-- booking band -->
  <section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
    <div class="reveal" style="max-width:36ch;margin:0 auto">
      <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
      <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
      <p class="lede" style="margin-bottom:26px;color:#bfe0dc">A friendly voice, not a call centre.</p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
        <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
      </div>
    </div>
    <div class="book-trust reveal">
      <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
      <RatedBadge />
    </div>
  </div></section>
</SiteLayout>
