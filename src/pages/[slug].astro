---
import BaseLayout from "../layouts/BaseLayout.astro";
import LocationArticle from "../components/LocationArticle.astro";
import { towns } from "../data/locations";

// Town pages (/trowbridge, …). Service pages are now their own routes on the
// v4 design; towns are migrated to v4 in the next phase.
export function getStaticPaths() {
  return towns.map((town) => ({
    params: { slug: town.slug },
    props: { town, title: town.title, description: town.description },
  }));
}

const { town, title, description } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <LocationArticle town={town} />
</BaseLayout>
