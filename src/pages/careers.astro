---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Careers | Become an Otter Care Professional" description="Join a small, local care team in Wiltshire & Somerset — £15.25/hr from day one, flexible hours, fully paid training, free DBS, 45p/mile. No experience needed.">
<header class="phero"><div class="wrap"><div class="crumb"><a href="/">Home</a> · Careers</div><h1>Become an Otter Care Professional</h1><p>Join a small, local team who look out for each other — with proper training, flexible hours and industry-leading pay. No experience needed.</p></div></header>
<section class="section"><div class="wrap"><div class="head-c reveal"><span class="eyebrow">Why work for Otter</span><h2>Care work, done properly</h2></div><div class="perks-grid reveal"><div class="perk"><div class="ic"><img src="/assets/icons/pound.svg" alt=""></div><h3>£15.25 per hour from day one</h3><p>Industry-leading starting pay — we value your time and dedication.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/clock.svg" alt=""></div><h3>Flexible hours</h3><p>Shifts that fit around your life — full-time, part-time, evenings or weekends.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/team.svg" alt=""></div><h3>Fully paid training</h3><p>Paid induction and ongoing development — experience preferred, not essential.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/key.svg" alt=""></div><h3>Free DBS &amp; uniform</h3><p>We cover your DBS check and kit you out, on us.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/pin.svg" alt=""></div><h3>45p per mile</h3><p>Travel allowance between visits, plus 24/7 office support.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/heart.svg" alt=""></div><h3>Grow with us</h3><p>Progress into senior, supervisor and management roles.</p></div></div></div></section>
<section class="section"><div class="wrap"><div class="hh-feature reveal"><img class="hh-photo" src="/img/training.jpg" alt="An Otter Care Professional in hands-on training" style="aspect-ratio:4/3"><div><span class="eyebrow">Training &amp; development</span><h2>Care as a career — taken seriously</h2><p>Great care starts with great training, so we invest in it properly. Every Care Professional gets a thorough, paid induction and ongoing development — experience is preferred, not essential, because we’ll teach you what you need.</p><p>We’re strong believers in care as a <b>career</b>, not just a job, and we actively back people who want to grow. Several of our team are currently working towards their <b>NVQs in social care</b> — and our Managing Director, Jamie, is completing a <b>Level 5 Diploma in Health &amp; Social Care</b>. If you want to develop yourself, we’ll support you all the way.</p></div></div></div></section>
<section class="section tmt"><div class="wrap"><div class="head-c reveal"><span class="eyebrow">Apply today</span><h2>Send us your details</h2><p class="lede">Fill in the form and attach your CV — we read every application personally.</p></div><div style="max-width:680px;margin:0 auto"><form class="form reveal" id="applyForm" action="/api/contact" method="POST" novalidate>
<input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" /><div class="frow"><div class="field"><label for="cn">Your name</label><input id="cn" name="name" type="text" required placeholder="Jane Smith"></div><div class="field"><label for="cp">Phone</label><input id="cp" name="phone" type="tel" required placeholder="07700 900000"></div></div><div class="field"><label for="ce">Email</label><input id="ce" name="email" type="email" placeholder="jane@example.com"></div><div class="field"><label for="cr">Role</label><select id="cr" name="role"><option>Care Professional (visiting)</option><option>Live-in Carer</option><option>Senior Carer</option><option>Not sure yet</option></select></div><div class="field"><label>Your CV</label><label class="filefield" for="cv"><span class="ff-ic">↑</span><b>Tap to upload your CV</b><small>PDF, DOC or DOCX · up to 10MB</small><input id="cv" type="file" accept=".pdf,.doc,.docx"></label></div><button class="btn btn-primary" type="submit">Send my application →</button><p class="privacy">Your details are kept private and used only for recruitment.</p></form><div class="form-success" id="applyOk" style="display:none"><div class="tick">✓</div><h3>Thank you — application received</h3><p>We read every application personally and will be in touch soon.</p></div></div></div></section>
<section class="section "><div class="wrap" style="max-width:820px"><div class="head-c reveal"><span class="eyebrow">Our language</span><h2>Why we say Care Professionals, not carers</h2></div><div class="video-embed reveal" data-yt="2YTsaanm_fY" role="button" tabindex="0" aria-label="Play video: Why we say Care Professionals, not carers"><img src="https://img.youtube.com/vi/2YTsaanm_fY/maxresdefault.jpg" onerror="this.onerror=null;this.src=&#39;https://img.youtube.com/vi/2YTsaanm_fY/hqdefault.jpg&#39;" alt="An Otter Care Professional"><span class="playbtn"><span></span></span><span class="vlabel">Watch: Why we say Care Professionals</span></div></div></section>
<section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center"><div class="reveal" style="max-width:36ch;margin:0 auto"><span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span><h2 style="margin:14px 0 12px">Let's find the right care, together</h2><p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person today — never a call centre.</p><div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap"><a class="btn btn-clay btn-lg" href="/#book">Book a free assessment</a><a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a></div></div><div class="book-trust reveal"><div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div><div class="bt-stars"><span class="s">★★★★★</span> Rated <b>9.4</b> by families on homecare.co.uk</div></div></div></section>
  <script is:inline>
    const af = document.getElementById("applyForm");
    if (af) af.addEventListener("submit", async (e) => {
      e.preventDefault();
      const btn = af.querySelector('button[type="submit"]');
      const fd = new FormData(af);
      const cv = af.querySelector('#cv');
      const data = { name: fd.get("name")||"", phone: fd.get("phone")||"", email: fd.get("email")||"", company: fd.get("company")||"",
        msg: "Careers application — role: " + (fd.get("role")||"") + (cv && cv.files && cv.files[0] ? " · CV attached: " + cv.files[0].name + " (please request)" : "") };
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        const res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) });
        const json = await res.json();
        if (res.ok && json.ok) { af.style.display = "none"; document.getElementById("applyOk").style.display = "block"; }
        else { btn.disabled = false; btn.textContent = "Send my application →"; alert(json.error || "Something went wrong — please call us on 01225 690022."); }
      } catch { btn.disabled = false; btn.textContent = "Send my application →"; alert("Something went wrong — please call us on 01225 690022."); }
    });
  </script>

</SiteLayout>
