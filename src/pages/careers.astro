---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout title="Careers | Otter Homecare" description="Join a small, local care team with proper training, great pay and genuine support — a team that's genuinely looked after.">
<header class="phero"><div class="wrap"><div class="crumb"><a href="/">Home</a> · Careers</div><h1>Become an Otter Care Professional</h1><p>Join a small, local team who look out for each other — with proper training, flexible hours and industry-leading pay. No experience needed.</p></div></header>
<section class="section"><div class="wrap"><div class="head-c reveal"><span class="eyebrow">Why work for Otter</span><h2>Care work, done properly</h2></div><div class="benefit-list reveal"><div class="benefit"><span class="b-ic"><img src="/assets/icons/pound.svg" alt=""></span><div><h3>£15.25 per hour from day one</h3><p>Industry-leading starting pay — we value your time and dedication.</p></div></div><div class="benefit"><span class="b-ic"><img src="/assets/icons/clock.svg" alt="" loading="lazy"></span><div><h3>Flexible hours</h3><p>Shifts that fit around your life — full-time, part-time, evenings or weekends.</p></div></div><div class="benefit"><span class="b-ic"><img src="/assets/icons/team.svg" alt="" loading="lazy"></span><div><h3>Fully paid training</h3><p>Paid induction and ongoing development — experience preferred, not essential.</p></div></div><div class="benefit"><span class="b-ic"><img src="/assets/icons/key.svg" alt="" loading="lazy"></span><div><h3>Free DBS &amp; uniform</h3><p>We cover your DBS check and kit you out, on us.</p></div></div><div class="benefit"><span class="b-ic"><img src="/assets/icons/pin.svg" alt="" loading="lazy"></span><div><h3>45p per mile</h3><p>Travel allowance between visits, plus 24/7 office support.</p></div></div><div class="benefit"><span class="b-ic"><img src="/assets/icons/heart.svg" alt="" loading="lazy"></span><div><h3>Grow with us</h3><p>Progress into senior, supervisor and management roles.</p></div></div></div></div></section>
<section class="section bg-sky tmt otterwhy"><div class="wrap" style="max-width:940px;text-align:center"><div class="reveal"><span class="eyebrow">Are you our kind of otter?</span><h2>The qualities we look for</h2><p class="lede" style="max-width:58ch;margin:10px auto 0">Otters hold hands so they never drift apart — and they embody everything we look for in an Otter Care Professional. Sound like you?</p></div><div class="otter-habitat reveal"><div class="th-col"><figure class="trait-bubble point-right"><figcaption class="tb-name">I'm Adaptable</figcaption><p class="tb-text">Otters are equally at home on land and in water — just as our Care Professionals adapt and tailor their support to fit each person, and each day.</p></figure><figure class="trait-bubble point-right"><figcaption class="tb-name">I'm Playful &amp; positive</figcaption><p class="tb-text">Otters are famously playful. A shared laugh, a little fun and warm company often turn an ordinary visit into the best part of someone's day.</p></figure></div><div class="otter-scene"><img class="otter-mascot" src="/img/otter-mascot-full.png" alt="The Otter Homecare mascot" loading="lazy"></div><div class="th-col"><figure class="trait-bubble point-left"><figcaption class="tb-name">I'm Caring</figcaption><p class="tb-text">Otters keep their little ones close and warm. Our team brings that same devotion to looking after someone else's loved one, every single visit.</p></figure><figure class="trait-bubble point-left"><figcaption class="tb-name">I'm Protective</figcaption><p class="tb-text">Otters hold hands so they never drift apart. We watch over the people in our care just as closely — keeping them safe, secure and never alone.</p></figure></div></div></div><div class="river-full" aria-hidden="true"><svg viewBox="0 0 1200 130" preserveAspectRatio="none"><path d="M0,46 C220,18 430,18 640,40 C840,60 1020,64 1200,36 L1200,130 L0,130 Z" fill="#88adb4"></path><path d="M0,70 C220,44 430,44 640,64 C840,82 1020,86 1200,60 L1200,130 L0,130 Z" style="fill:var(--teal-d)"></path></svg></div></section>
<section class="section" style="background:var(--teal-d);color:#eaf4f2"><div class="wrap"><div class="head-c reveal" style="max-width:780px;margin:0 auto;text-align:center"><span class="eyebrow" style="color:var(--sun)">Life at Otter</span><h2 style="color:#fff;font-size:clamp(28px,3.6vw,44px)">Cared-for carers deliver better care</h2><p class="lede" style="color:#cfe6e3;margin:14px auto 0">We believe great care starts with how we treat our own team. Look after your Care Professionals properly — with time, training, recognition and genuine support — and they give better, kinder care in return. It's not a perk; it's the whole philosophy.</p></div></div></section>
<section class="section bg-beige"><div class="wrap"><div class="head-c reveal"><span class="eyebrow">How we look after our team</span><h2>What that looks like, day to day</h2></div><div class="perks-grid reveal"><div class="perk"><div class="ic"><img src="/assets/icons/team.svg" alt="" loading="lazy"></div><h3>Not a review — a reflection</h3><p>Instead of formal supervisions, we hold quarterly <b>Support &amp; Reflection Sessions</b> on paid time — you choose the setting (office, a café, or online), and we end with a goal or two, never a box-ticking score.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/heart.svg" alt="" loading="lazy"></div><h3>Otter Stars</h3><p>Our Friday newsletter has an “Otter Stars” section celebrating great care — because good work should be seen and said out loud.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/key.svg" alt="" loading="lazy"></div><h3>The Otter Wellness Guide</h3><p>A printed wellbeing booklet for every team member — self-care tips and where to turn if you need support.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/pin.svg" alt="" loading="lazy"></div><h3>A “Celebrating Care” wall</h3><p>Clients' thank-you cards and kind messages, up on the office wall, where the whole team can see the difference they make.</p></div><div class="perk"><div class="ic"><img src="/assets/icons/mug.svg" alt="" loading="lazy"></div><h3>Fresh Fruit Fridays</h3><p>Plus handwritten thank-you cards — we send personalised ones during Stress Awareness Week. One Care Professional wrote back that it <i>“put a little tear in my eyes.”</i></p></div><div class="perk"><div class="ic"><img src="/assets/icons/paw.svg" alt="" loading="lazy"></div><h3>A proper Christmas</h3><p>A fully company-funded Christmas party — venue, sit-down meal, drinks and a DJ — plus a personalised card and small gift for everyone.</p></div></div></div></section>
<section class="section"><div class="wrap"><div class="hh-feature reveal"><img class="hh-photo" src="/img/training.jpg" alt="An Otter Care Professional in hands-on training" style="aspect-ratio:4/3" loading="lazy"><div><span class="eyebrow">Training &amp; development</span><h2>Care as a career — taken seriously</h2><p>Great care starts with great training, so we invest in it properly. Every Care Professional gets a thorough, paid induction and ongoing development — experience is preferred, not essential, because we’ll teach you what you need.</p><p>We’re strong believers in care as a <b>career</b>, not just a job, and we actively back people who want to grow. Several of our team are currently working towards their <b>NVQs in social care</b> — and our Managing Director, Jamie, is completing a <b>Level 5 Diploma in Health &amp; Social Care</b>. If you want to develop yourself, we’ll support you all the way.</p></div></div></div></section>
<section class="section bg-sky tmt"><div class="wrap"><div class="head-c reveal"><span class="eyebrow">Apply today</span><h2>Send us your details</h2><p class="lede">Fill in the form and attach your CV — we read every application personally.</p></div><div style="max-width:680px;margin:0 auto"><form class="form reveal" id="applyForm" data-success="applyOk" novalidate><input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none"><div class="frow"><div class="field"><label for="cn">Your name</label><input id="cn" type="text" required placeholder="Jane Smith"></div><div class="field"><label for="cp">Phone</label><input id="cp" type="tel" required placeholder="07700 900000"></div></div><div class="field"><label for="ce">Email</label><input id="ce" type="email" placeholder="jane@example.com"></div><div class="field"><label for="cr">Role</label><select id="cr"><option>Care Professional (visiting)</option><option>Live-in Carer</option><option>Senior Carer</option><option>Not sure yet</option></select></div><div class="field"><label>Your CV</label><label class="filefield" for="cv"><span class="ff-ic">↑</span><b>Tap to upload your CV</b><small id="cvHint">PDF, DOC or DOCX · up to 3MB</small><input id="cv" type="file" accept=".pdf,.doc,.docx"></label></div><button class="btn btn-primary" type="submit">Send my application →</button><p class="privacy">Your details are kept private and used only for recruitment.</p></form><div class="form-success" id="applyOk" style="display:none"><div class="tick">✓</div><h3>Thank you — application received</h3><p>We read every application personally and will be in touch soon.</p></div></div></div></section>
<section class="section bg-beige "><div class="wrap" style="max-width:820px"><div class="head-c reveal"><span class="eyebrow">Our language</span><h2>Why we say Care Professionals, not carers</h2></div><div class="video-embed reveal" data-yt="2YTsaanm_fY" role="button" tabindex="0" aria-label="Play video: Why we say Care Professionals, not carers"><img src="/img/poster-why-care-pros.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/2YTsaanm_fY/hqdefault.jpg'" alt="An Otter Care Professional" loading="lazy"><span class="playbtn"><span></span></span><span class="vlabel">Watch: Why we say Care Professionals</span></div></div></section>
<section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center"><div class="reveal" style="max-width:36ch;margin:0 auto"><span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span><h2 style="margin:14px 0 12px">Let's find the right care, together</h2><p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person today — never a call centre.</p><div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap"><a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a><a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a></div></div><div class="book-trust reveal"><div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div><div class="bt-stars"><span class="s">★★★★★</span> Rated <b>9.4</b> by families on homecare.co.uk</div></div></div></section>

<style is:global>
.benefit-list{display:grid;grid-template-columns:1fr 1fr;gap:0 60px;max-width:980px;margin:8px auto 0}
.benefit{display:flex;gap:16px;align-items:flex-start;padding:22px 2px;border-top:1px solid var(--line)}
.benefit:nth-child(1),.benefit:nth-child(2){border-top:none;padding-top:6px}
.benefit .b-ic{flex:none;width:46px;height:46px;border-radius:50%;background:var(--teal);display:grid;place-items:center;box-shadow:0 10px 20px -10px rgba(15,79,96,.55)}
.benefit .b-ic img{width:50%;height:50%;object-fit:contain;filter:brightness(0) invert(1)}
.benefit h3{font-size:17.5px;margin-bottom:4px;letter-spacing:-.01em}
.benefit p{font-size:14.5px;color:var(--muted);line-height:1.5;margin:0}
@media(max-width:760px){.benefit-list{grid-template-columns:1fr}.benefit:nth-child(2){border-top:1px solid var(--line);padding-top:22px}}
</style>

  <!-- Careers application — posts to /api/apply with the CV as base64 (3MB cap) -->
  <script is:inline>
    (function () {
      var f = document.getElementById("applyForm"); if (!f) return;
      var cv = document.getElementById("cv"), hint = document.getElementById("cvHint");
      if (cv) cv.addEventListener("change", function () {
        if (hint) hint.textContent = cv.files[0] ? "Attached: " + cv.files[0].name : "PDF, DOC or DOCX · up to 3MB";
      });
      f.addEventListener("submit", function (e) {
        e.preventDefault();
        var name = document.getElementById("cn").value.trim();
        var phone = document.getElementById("cp").value.trim();
        var email = document.getElementById("ce").value.trim();
        var role = document.getElementById("cr").value;
        if (!name || (!phone && !email)) { alert("Please add your name and a phone number or email."); return; }
        var file = cv && cv.files[0];
        if (file && file.size > 3 * 1024 * 1024) { alert("That file is over 3MB — please attach a smaller copy, or email it to hello@otterhomecare.co.uk."); return; }
        var btn = f.querySelector("button"); btn.disabled = true; btn.textContent = "Sending…";
        function send(cvName, cvData) {
          fetch("/api/apply", {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ name: name, phone: phone, email: email, role: role, cvName: cvName || "", cvData: cvData || "", company: f.querySelector("[name=company]").value || "" }),
          }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok && j.ok, err: j.error }; }); })
            .then(function (out) {
              if (out.ok) { f.style.display = "none"; var s = document.getElementById("applyOk"); s.style.display = "block"; }
              else { btn.disabled = false; btn.textContent = "Send my application →"; alert(out.err || "Something went wrong — please email hello@otterhomecare.co.uk."); }
            })
            .catch(function () { btn.disabled = false; btn.textContent = "Send my application →"; alert("Something went wrong — please email hello@otterhomecare.co.uk."); });
        }
        if (file) {
          var rd = new FileReader();
          rd.onload = function () { send(file.name, String(rd.result).split(",")[1] || ""); };
          rd.onerror = function () { btn.disabled = false; btn.textContent = "Send my application →"; alert("Couldn't read that file — please try again or email it to hello@otterhomecare.co.uk."); };
          rd.readAsDataURL(file);
        } else send();
      });
    })();
  </script>
</SiteLayout>
