---
import Photo from "../components/Photo.astro";
import RatedBadge from "../components/RatedBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import stats from "../data/reviewStats.json";

// aggregateRating + reviews mirror what is genuinely displayed on this page
// (homecare.co.uk score/count flow from src/data/reviewStats.json, auto-updated
// by the RC pipeline; the quoted excerpts stay hand-curated).
// Attached by @id to the same organisation entity declared in SiteLayout.
const reviewsSchema = {
  "@context": "https://schema.org",
  "@type": "HomeHealthCareService",
  "@id": "https://www.otterhomecare.co.uk/#organization",
  "name": "Otter Homecare",
  "url": "https://www.otterhomecare.co.uk",
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": stats.homecare.score,
    "bestRating": "10",
    "worstRating": "1",
    "reviewCount": String(stats.homecare.count)
  },
  "review": [
    { "@type": "Review", "author": { "@type": "Person", "name": "S M" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "The care I have received so far is excellent, second to none. The carers are friendly and understanding. Very knowledgeable and appear to have a high quality of training. I have been treated with full dignity and respect at all times. Highly recommend." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Frances W" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "Otter staff are superb in every way. They are kind, and really understand what being caring carers means." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Helen F" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "I cannot recommend Otter Home Care highly enough: we used them to provide care for my elderly dad. Their level of care was excellent, the carers were always on time and were very attentive." },
    { "@type": "Review", "author": { "@type": "Person", "name": "Anna B" },
      "reviewRating": { "@type": "Rating", "ratingValue": "5", "bestRating": "5" },
      "reviewBody": "I cannot recommend the Otter team highly enough if you are considering care for a loved one with dementia… We have gone from thinking our mum would be going into a care home imminently, to having mum safe, supported and most of all happy in her own home now. They listen, they communicate brilliantly and they are so adaptable to all the changes that dementia care brings." }
  ]
};
---
<SiteLayout title="Otter Homecare Reviews — Rated 9.5 by Families" description={`Real words from the families who trust Otter Homecare — rated ${stats.homecare.score} on homecare.co.uk, plus five-star reviews on Google.`}>
<script type="application/ld+json" set:html={JSON.stringify(reviewsSchema)} />
<header class="phero"><div class="wrap"><div class="crumb"><a href="/">Home</a> · About · Reviews</div><h1>The families we look after</h1><p>Real words from the families who trust us with the people they love.</p></div></header>
<section class="section tmt hcrev"><div class="wrap"><div class="hc-bar reveal"><div class="hc-score"><div class="hc-badge">{stats.homecare.score}</div><div><b>homecare.co.uk Review Score for Otter Homecare</b><small>Based on {stats.homecare.count} verified reviews</small></div></div><a class="hc-brand" href="https://www.homecare.co.uk/homecare/agency.cfm/id/65432251370" target="_blank" rel="noopener"><Photo src="/assets/homecare-logo.png" alt="homecare.co.uk" priority sizes="160px" /></a></div><div class="hc-grid"><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">15 Jul 2026</span></div><p>"The Carers have all been very compassionate and very supportive during this rapid dementia journey we are experiencing…"</p><div class="hc-by">Trudy S<span>Wife of Client</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">24 Jun 2026</span></div><p>"The care I have received so far is excellent, second to none. The carers are friendly and understanding. Very knowledgeable and appear to have a high quality of training… Highly recommend."</p><div class="hc-by">S M<span>Client</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">27 Mar 2026</span></div><p>"Otter staff are superb in every way. They are kind, and really understand what being caring carers means."</p><div class="hc-by">Frances W<span>Client</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">30 Sep 2025</span></div><p>"I cannot recommend Otter Home Care highly enough: we used them to provide care for my elderly dad. Their level of care was excellent, the carers were always on time and were very attentive."</p><div class="hc-by">Helen F<span>Daughter of Client</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">12 Dec 2025</span></div><p>"All home care should be as good as this, lovely carers, nothing too much trouble, they don't just do the basics, but will help out with anything…"</p><div class="hc-by">E S<span>Client</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span><span class="hc-date">14 Oct 2025</span></div><p>"Incredibly kind and considerate in all their dealings with me and my stepmother."</p><div class="hc-by">J K<span>Stepson of Client</span></div></div></div></div></section>
<section class="section tmt"><div class="wrap"><div class="gbar reveal"><img class="g-logo" src="/assets/google-logo.svg" alt="Google" loading="lazy" /><div class="g-meta"><span class="g-stars">★★★★★</span><small>A few of our recent five-star reviews from families on Google</small></div><a class="g-link" href="https://www.google.com/search?q=Otter+Homecare+Trowbridge+reviews" target="_blank" rel="noopener">Read more on Google →</a></div><div class="hc-grid" style="grid-template-columns:repeat(auto-fit,minmax(250px,1fr))"><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span></div><p>"I cannot recommend the Otter team highly enough if you are considering care for a loved one with dementia… We have gone from thinking our mum would be going into a care home imminently, to having mum safe, supported and most of all happy in her own home now. They listen, they communicate brilliantly and they are so adaptable to all the changes that dementia care brings."</p><div class="hc-by">Anna B<span>Google review</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span></div><p>"Otter offers flexible, high-quality care at an affordable price. The carers are all top notch and I cannot recommend this company highly enough."</p><div class="hc-by">Frances C<span>Google review</span></div></div><div class="hc-card reveal"><div class="hc-top"><span class="hc-stars">★★★★★</span></div><p>"Jamie and his team have done an excellent job looking after a dear family friend. I really recommend his company."</p><div class="hc-by">Fiona D<span>Google review</span></div></div></div></div></section>
<section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center"><div class="reveal" style="max-width:36ch;margin:0 auto"><span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span><h2 style="margin:14px 0 12px">Let's find the right care, together</h2><p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person today — never a call centre.</p><div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap"><a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a><a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a></div></div><div class="book-trust reveal"><div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div><RatedBadge /></div></div></section>
</SiteLayout>
