---
import Photo from "../components/Photo.astro";
import RatedBadge from "../components/RatedBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { office, careProfessionals, type Person } from "../data/team";

// Both groups render from the same card, so a Care Professional added to
// src/data/team.ts looks like the rest of the team with no markup changes.
const label = (p: Person) => p.role ?? "Care Professional";
const meta = (p: Person) =>
  [p.area, p.since ? `With Otter since ${p.since}` : null].filter(Boolean).join(" · ");
---
<SiteLayout
  title="Meet the Otter Homecare Team | Wiltshire & Somerset"
  description="The friendly, familiar faces behind Otter Homecare — the office team and the Care Professionals who visit you. Chosen for their kindness, empathy and the way they connect with people."
>
  <header class="phero"><div class="wrap">
    <div class="crumb"><a href="/">Home</a> · About · Meet the Team</div>
    <h1>Meet the team</h1>
    <p>The friendly, familiar faces behind Otter — chosen not just for their skills, but for their kindness, empathy and the way they connect with people.</p>
  </div></header>

  <section class="section"><div class="wrap">
    <Photo class="team-hero-photo reveal" src="/img/team-group.jpg" alt="The Otter Homecare team" sizes="(max-width: 900px) 100vw, 980px" />
    <div class="team-grid reveal">
      {office.map((p) => (
        <div class="team-card">
          {p.photo
            ? <Photo src={p.photo} alt={p.alt ?? `${p.name}, ${label(p)}`} sizes="(max-width: 700px) 50vw, 300px" />
            : <span class="team-initial" aria-hidden="true">{p.name.trim().charAt(0)}</span>}
          <b>{p.name}</b>
          <span class="role">{label(p)}</span>
          {meta(p) && <span class="team-meta">{meta(p)}</span>}
          <p>{p.words}</p>
        </div>
      ))}
    </div>
  </div></section>

  {/* Renders only once there are real people in it — see src/data/team.ts. */}
  {careProfessionals.length > 0 && (
    <section class="section bg-sky"><div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">The people at the door</span>
        <h2>Our Care Professionals</h2>
        <p class="lede">The same few faces we promise — directly employed, DBS-checked, and trained by our own trainer before they ever visit alone.</p>
      </div>
      <div class="team-grid reveal">
        {careProfessionals.map((p) => (
          <div class="team-card">
            {p.photo
              ? <Photo src={p.photo} alt={p.alt ?? `${p.name}, ${label(p)}`} sizes="(max-width: 700px) 50vw, 300px" />
              : <span class="team-initial" aria-hidden="true">{p.name.trim().charAt(0)}</span>}
            <b>{p.name}</b>
            <span class="role">{label(p)}</span>
            {meta(p) && <span class="team-meta">{meta(p)}</span>}
            <p>{p.words}</p>
          </div>
        ))}
      </div>
      <div class="reveal" style="text-align:center;margin-top:40px">
        <a class="btn btn-primary" href="/careers">Join the team →</a>
      </div>
    </div></section>
  )}

  <section class="section tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">One team</span><h2>We're one team — in the office and out on visits</h2></div>
    <div class="video-embed reveal" data-yt="ZDio_v8d8G4" role="button" tabindex="0" aria-label="Play video: We're one team">
      <img src="/img/poster-one-team.jpg" onerror="this.onerror=null;this.src='https://img.youtube.com/vi/ZDio_v8d8G4/hqdefault.jpg'" alt="The Otter Homecare team" loading="lazy" />
      <span class="playbtn"><span></span></span>
      <span class="vlabel">Watch: We're one team</span>
    </div>
  </div></section>

  <section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
    <div class="reveal" style="max-width:36ch;margin:0 auto">
      <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
      <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
      <p class="lede" style="margin-bottom:26px;color:#bfe0dc">A friendly voice, not a call centre.</p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
        <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
      </div>
    </div>
    <div class="book-trust reveal">
      <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
      <RatedBadge />
    </div>
  </div></section>
</SiteLayout>
