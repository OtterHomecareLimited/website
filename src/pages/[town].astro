---
import BaseLayout from "../layouts/BaseLayout.astro";
import { towns } from "../data/locations";

// ONE template → every town page. Astro pre-renders one static HTML
// file per entry in locations.ts at build time. Add a town to the
// data file and its page appears automatically — no new file.
export function getStaticPaths() {
  return towns.map((town) => ({
    params: { town: town.slug },
    props: { town },
  }));
}

const { town } = Astro.props;
---
<BaseLayout title={town.title} description={town.description}>
  <!-- Hero -->
  <section class="loc-hero">
    <div class="wrap">
      <span class="eyebrow">📍 Home care · {town.name}</span>
      <h1>{town.h1}</h1>
      <p class="lede">{town.lede}</p>
      <div class="hero-ctas">
        <a href="/contact" class="cta large">Book a free assessment →</a>
        <a href="tel:01225690022" class="cta ghost large">Call 01225 690022</a>
      </div>
    </div>
  </section>

  <!-- Body: localised intro + sidebar of villages -->
  <section>
    <div class="wrap">
      <div class="loc-grid">
        <div class="loc-intro">
          {town.intro.map((para) => <p>{para}</p>)}
          {town.landmark && <p><strong>{town.landmark}</strong></p>}

          {town.testimonial && (
            <div class="quote" style="margin-top:32px">
              <p>{town.testimonial.quote}</p>
              <div class="who">
                <div class="avatar">{town.testimonial.who.slice(0, 1)}</div>
                <div><div class="name">{town.testimonial.who}</div></div>
              </div>
            </div>
          )}
        </div>

        <aside class="loc-side">
          <h3>Villages we cover near {town.name}</h3>
          <ul>
            {town.villages.map((v) => (
              <li><span class="dot" style="background:var(--mustard)"></span>{v}</li>
            ))}
          </ul>
          <a href="/contact" class="cta" style="width:100%;justify-content:center">Arrange a free chat →</a>
        </aside>
      </div>
    </div>
  </section>

  <!-- Services strip (shared design language) -->
  <section class="services how">
    <div class="wrap">
      <div class="section-head">
        <h2>How we can help in {town.name}</h2>
      </div>
      <div class="cards">
        <a class="service" href="/personal-care"><h3>Personal Care</h3><p>Washing, dressing, medication and daily routines — with dignity.</p><span class="more">Learn more →</span></a>
        <a class="service" href="/live-in-care"><h3>Live-in Care</h3><p>Round-the-clock support in the home you know best.</p><span class="more">Learn more →</span></a>
        <a class="service" href="/companionship"><h3>Companionship</h3><p>Friendly visits that keep loneliness at bay.</p><span class="more">Learn more →</span></a>
        <a class="service" href="/conditions"><h3>Specialist Support</h3><p>Dementia, stroke, frailty and end-of-life care.</p><span class="more">Learn more →</span></a>
      </div>
    </div>
  </section>
</BaseLayout>
