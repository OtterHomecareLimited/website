---
import Photo from "../../components/Photo.astro";
// Otter Alongside — "Questions families ask" (/family/questions).
// Ported from design's FAQ handoff (Desktop/handoff, 2026-07-26). Stand-in
// header/footer stripped, assets repointed, breadcrumb parent corrected.
// Interaction decision is design's and deliberate: NO accordion — always-visible
// grouped Q&A with a jump index (find-in-page, elderly readers, schema, print).
//
// The FAQPage JSON-LD below was GENERATED from this file's own markup at port
// time (one Question per <article class="faq-item">; .faq-item__more excluded
// as navigation). If the Q&A copy changes, regenerate it — don't let them drift.
import SiteLayout from "../../layouts/SiteLayout.astro";
import "../../styles/otter-alongside-tokens.css";
import "../../styles/otter-alongside.css";
import "../../styles/otter-alongside-faq.css";
// Loads LAST on purpose — see the header of otter-alongside-print.css.
import "../../styles/otter-alongside-print.css";

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Do we have to commit to anything to talk to you?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Ringing us commits you to nothing, and the home visit is free with no obligation. Plenty of people who ring don't need care yet — we'd rather tell you that than sell you something."
      }
    },
    {
      "@type": "Question",
      "name": "How much does it cost?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We publish our full rates rather than making you ask — hourly visiting care, overnight and live-in are all on the cost of home care page. What you'd actually pay depends on how much help is needed and when, so we'd rather talk it through than quote a number that turns out to be wrong."
      }
    },
    {
      "@type": "Question",
      "name": "Is there money to help pay for care?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Often, yes — and much of it goes unclaimed for years. Attendance Allowance isn't means-tested. A Carer's Assessment is free and your legal right. None of it comes to us; we'd just rather you knew."
      }
    },
    {
      "@type": "Question",
      "name": "Mum says no. Can we arrange care anyway?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If your relative can make their own decisions, the choice is theirs — even if you disagree, and even if you're the one picking up the pieces. A first no is normal and rarely final; starting with something small and practical often shifts it."
      }
    },
    {
      "@type": "Question",
      "name": "Why can't I find the Otter app in the App Store?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Because it isn't called Otter. The app is Access Care Planning — look for the red circle. It's the care system we use rather than something we built, so it carries their name."
      }
    },
    {
      "@type": "Question",
      "name": "How do we get access to the app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Ask us — it isn't set up automatically, and your relative (or their representative) agrees to it first. Up to three people, view-only, and access can be removed at any time just by asking. The full setup walkthrough is at otterhomecare.co.uk/app."
      }
    },
    {
      "@type": "Question",
      "name": "I'm logged in but the app is empty. Is it broken?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No — this catches almost everyone. You have to follow your relative's records first: tap the three-dot menu, choose Follow Cases, type their first name."
      }
    },
    {
      "@type": "Question",
      "name": "Do we have to use the app?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Not at all. Most families choose a phone call when something matters and otherwise let us get on with it. Both are completely fine."
      }
    },
    {
      "@type": "Question",
      "name": "Can we change visit times, or add a visit?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes — most changes are a phone call. The earlier you tell us, the better the chance of keeping the same familiar faces on the rota."
      }
    },
    {
      "@type": "Question",
      "name": "Something isn't right. Will complaining affect Mum's care?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Never — and you won't be causing trouble. Early and small is far easier to put right than late and large. If it's serious we'll come out in person, including at weekends, and we'll tell you what changed as a result."
      }
    },
    {
      "@type": "Question",
      "name": "Who do we ring at night or the weekend?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The same number, always: Outside office hours — 8:30am to 5pm, Monday to Friday — it reaches our on-call team, who can always get to a manager."
      }
    },
    {
      "@type": "Question",
      "name": "Mum's gone into hospital. What do we do about the visits?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Tell us as soon as you can and we'll pause everything — and ring us the moment you hear a discharge date, even a vague one. Coming home is the risky bit, not going in."
      }
    },
    {
      "@type": "Question",
      "name": "I'm not a carer — I'm just her daughter. Does any of this apply to me?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "If you're doing the shopping, sorting medication, ringing the GP or lying awake wondering — yes. Almost everything written for \"carers\" is meant for you, and people miss years of help because they didn't think the word meant them."
      }
    },
    {
      "@type": "Question",
      "name": "Can I get a break without it looking like I'm giving up?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, and it isn't giving up — a carer who gets a proper break is usually the reason someone stays at home longer. Respite can be a few reliable hours a week or a longer block."
      }
    }
  ]
};
