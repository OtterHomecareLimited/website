---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const readMins = (body: string) => Math.max(2, Math.round((body ?? "").split(/\s+/).filter(Boolean).length / 200));
---
<SiteLayout
  title="The Otterly Caring Blog | Otter Homecare"
  description="Community news, care advice and stories from the Otter Homecare team across Wiltshire & Somerset."
>
  <header class="phero"><div class="wrap">
    <div class="crumb"><a href="/">Home</a> · About · Blog</div>
    <h1>The Otterly Caring Blog</h1>
    <p>Community news, care advice and stories from the Otter Homecare team across Wiltshire &amp; Somerset.</p>
  </div></header>

  <section class="section"><div class="wrap">
    <div class="blog-grid">
      {posts.map((post) => (
        <a class="post-card reveal" href={`/post/${post.id}`}>
          <div class="img">{post.data.heroImage ? <img src={post.data.heroImage} alt="" /> : null}</div>
          <div class="body">
            <span class="cat">{post.data.category}</span>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
            <div class="meta">{fmt(post.data.pubDate)} · {readMins(post.body)} min read</div>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</SiteLayout>
