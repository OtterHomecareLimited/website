---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
---
<BaseLayout
  title="Blog | Otter Homecare"
  description="Care insights, client stories and community news from Otter Homecare across Wiltshire and Somerset."
>
  <div class="page-head">
    <div class="wrap">
      <span class="eyebrow">From the blog</span>
      <h1>The Otterly Caring Blog</h1>
      <p>Helpful reads for families thinking about care — plus what we're up to locally.</p>
    </div>
  </div>

  <section class="blog">
    <div class="wrap">
      <div class="cards">
        {posts.map((post) => (
          <article class="post">
            <a href={`/post/${post.id}`}>
              <div class="img">{post.data.category}</div>
              <div class="body">
                <span class="tag">{post.data.category}</span>
                <h3>{post.data.title}</h3>
                <span class="date">{fmt(post.data.pubDate)}</span>
              </div>
            </a>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
