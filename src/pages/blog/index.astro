---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getCollection } from "astro:content";

const fmt = (d: Date) =>
  d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
const readMins = (body: string) => Math.max(2, Math.round((body ?? "").split(/\s+/).filter(Boolean).length / 200));

// Markdown collection posts
const collection = (await getCollection("blog", ({ data }) => !data.draft)).map((p) => ({
  href: `/post/${p.id}`,
  heroImage: p.data.heroImage,
  category: p.data.category,
  title: p.data.title,
  description: p.data.description,
  date: p.data.pubDate,
  mins: readMins(p.body),
}));
// Standalone, design-styled posts (not markdown) — slotted into the feed manually
const standalone = [
  {
    href: "/post/mental-capacity-act",
    heroImage: "/img/personal-care-real.jpg",
    category: "For Families",
    title: "Your decisions, your way: the Mental Capacity Act, explained simply",
    description: "A plain-English guide to the Mental Capacity Act — what it means for you or your loved one, and how Otter Homecare protects everyone's right to make their own decisions.",
    date: new Date("2026-06-08"),
    mins: 4,
  },
];
const feed = [...collection, ...standalone].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<SiteLayout
  title="The Otterly Caring Blog | Otter Homecare"
  description="Community news, care advice and stories from the Otter Homecare team across Wiltshire & Somerset."
>
  <header class="phero"><div class="wrap">
    <div class="crumb"><a href="/">Home</a> · About · Blog</div>
    <h1>The Otterly Caring Blog</h1>
    <p>Community news, care advice and stories from the Otter Homecare team across Wiltshire &amp; Somerset.</p>
  </div></header>

  <section class="section"><div class="wrap">
    <div class="blog-grid">
      {feed.map((post) => (
        <a class="post-card reveal" href={post.href}>
          <div class="img">{post.heroImage ? <img src={post.heroImage} alt="" /> : null}</div>
          <div class="body">
            <span class="cat">{post.category}</span>
            <h3>{post.title}</h3>
            <p>{post.description}</p>
            <div class="meta">{fmt(post.date)} · {post.mins} min read</div>
          </div>
        </a>
      ))}
    </div>
  </div></section>
</SiteLayout>
