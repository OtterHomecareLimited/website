---
import Photo from "../components/Photo.astro";
import RatedBadge from "../components/RatedBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
const img = (f: string) => `/img/${f}`;
---
<SiteLayout
  title="Care Services in Wiltshire & Somerset | Otter Homecare"
  description="From a friendly weekly visit to round-the-clock live-in support — personal care, companionship and specialist help across Trowbridge, Melksham and nearby."
>
  <header class="phero">
    <div class="wrap">
      <div class="crumb"><a href="/">Home</a> · Care Services</div>
      <h1>Care services that fit around your life</h1>
      <p>From a friendly weekly visit to round-the-clock live-in support, our care is personal, flexible and built entirely around you — here in Wiltshire and Somerset.</p>
    </div>
  </header>

  <section class="section" id="services">
    <div class="wrap">
      <div class="srow reveal">
        <div class="srow-media"><Photo src="/img/visiting-care.jpg" alt="An Otter Care Professional visiting a client at home" priority sizes="(max-width: 900px) 100vw, 520px" /></div>
        <div>
          <span class="eyebrow">Visiting Care</span>
          <h2>Flexible visits, on your terms</h2>
          <p class="lede">From a quick daily call-in upward — friendly Care Professionals who help with everyday life and brighten the day.</p>
          <ul>
            <li>Flexible visit lengths to suit you</li>
            <li>Help with washing, dressing, meals and medication</li>
            <li>Support getting out to appointments and activities</li>
            <li>The same familiar faces, building real relationships</li>
          </ul>
          <a class="btn btn-primary" href="/visiting-care">Learn about visiting care →</a>
        </div>
      </div>

      <div class="srow flip reveal">
        <div class="srow-media"><Photo src="/img/elder-care-home.jpg" alt="An Otter Care Professional supporting an older client at home" sizes="(max-width: 900px) 100vw, 520px" /></div>
        <div>
          <span class="eyebrow">Live-in Care</span>
          <h2>Round-the-clock care, at home</h2>
          <p class="lede">Expert support day and night, from a dedicated Care Professional who lives with you — a reassuring alternative to a care home.</p>
          <ul>
            <li>A dedicated Care Professional living in your home, day and night</li>
            <li>One-to-one support and genuine companionship</li>
            <li>Help with personal care, meals, medication and routines</li>
            <li>Keep your home, your pets and your independence</li>
          </ul>
          <a class="btn btn-primary" href="/live-in-care">Learn about live-in care →</a>
        </div>
      </div>

      <div class="srow reveal">
        <div class="srow-media"><Photo src="/img/specialist-support.jpg" alt="An Otter Care Professional giving specialist support to a client at home" sizes="(max-width: 900px) 100vw, 520px" /></div>
        <div>
          <span class="eyebrow">Specialist &amp; Condition-led Care</span>
          <h2>Experienced, specialist support</h2>
          <p class="lede">Care plans built around specific conditions and tailored to change with your needs over time.</p>
          <ul>
            <li>Experienced support for dementia, stroke and Parkinson's</li>
            <li>Post-operative and fall recovery at home</li>
            <li>Tailored care plans, reviewed as needs change</li>
            <li>Care Professionals trained for complex needs</li>
          </ul>
          <a class="btn btn-primary" href="/conditions">Conditions we care for →</a>
        </div>
      </div>

      <div class="srow flip reveal">
        <div class="srow-media"><Photo src="/img/ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg" alt="Companionship and a friendly chat" sizes="(max-width: 900px) 100vw, 520px" /></div>
        <div>
          <span class="eyebrow">Companionship</span>
          <h2>A friendly face and good company</h2>
          <p class="lede">Sometimes the most valuable care is simply someone to share the day with.</p>
          <ul>
            <li>A friendly face and someone to talk to</li>
            <li>Shared hobbies, walks and outings</li>
            <li>Help around the home and with errands</li>
            <li>Reassurance for families living further away</li>
          </ul>
          <a class="btn btn-primary" href="/companionship">Learn about companionship →</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section trustwhy" id="conditions">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">Conditions we care for</span>
        <h2>Specialist support, close to home</h2>
        <p class="lede">A few of the conditions our Care Professionals are experienced in supporting — if you don't see yours, just ask.</p>
      </div>
      <div class="conds reveal">
        <a href="/dementia">Dementia &amp; Alzheimer's</a>
        <a href="/conditions">Stroke recovery</a>
        <a href="/conditions">Parkinson's</a>
        <a href="/conditions">Arthritis &amp; mobility</a>
        <a href="/conditions">Diabetes</a>
        <a href="/conditions">Sensory loss</a>
        <a href="/conditions">Post-operative recovery</a>
        <a href="/fall-recovery">Fall recovery</a>
        <a href="/conditions">Palliative &amp; end-of-life</a>
        <a href="/conditions">Continence support</a>
      </div>
    </div>
  </section>

  <section class="section" id="trust-why">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">Care you can trust</span>
        <h2>Peace of mind, built in</h2>
      </div>
      <div class="trust3">
        <div class="t3 reveal"><span class="ix">01</span><h3>Registered with the CQC</h3><p>Fully registered and regulated by the Care Quality Commission — never an unregulated introductory agency.</p></div>
        <div class="t3 reveal"><span class="ix">02</span><h3>A perfect council score</h3><p>Wiltshire Council’s quality assurance inspection gave us its best possible rating — zero risk, across care, staffing and leadership.</p></div>
        <div class="t3 reveal"><span class="ix">03</span><h3>Our own, familiar faces</h3><p>Directly employed, DBS-checked and trained by us — the same small team, who get to know you and your routine.</p></div>
      </div>
    </div>
  </section>

  <section class="section trustwhy" id="faqs">
    <div class="wrap">
      <div class="head-c reveal">
        <span class="eyebrow">Good to know</span>
        <h2>Frequently asked questions</h2>
      </div>
      <div class="faqs reveal">
        <div class="faq"><button>How quickly can care start?<span class="tog">+</span></button><div class="ans"><p>After a free home visit we can usually begin within a few days — and sooner in urgent situations. We'll always be honest about what we can arrange and when.</p></div></div>
        <div class="faq"><button>How much does home care cost?<span class="tog">+</span></button><div class="ans"><p>Visiting care starts from £36 per hour, with flexible visit lengths from 30 minutes upwards; live-in care from £1,550 per week. You only ever pay for the time you use, with no travel or call-out fees. We'll talk you through clear pricing at your free assessment.</p></div></div>
        <div class="faq"><button>Are you regulated?<span class="tog">+</span></button><div class="ans"><p>Yes — we're fully regulated by the Care Quality Commission (CQC) and a member of the Homecare Association. Our Care Professionals are directly employed and trained by us.</p></div></div>
        <div class="faq"><button>Can we choose visit times and lengths?<span class="tog">+</span></button><div class="ans"><p>Absolutely. Care is built around your routine, with flexible visit lengths — from a short daily call-in through to live-in support.</p></div></div>
        <div class="faq"><button>Will the same people visit each time?<span class="tog">+</span></button><div class="ans"><p>We keep our team small and deliberately match consistent Care Professionals, so you see familiar faces who truly get to know you and your needs.</p></div></div>
        <div class="faq"><button>Which areas do you cover?<span class="tog">+</span></button><div class="ans"><p>Trowbridge, Bradford-on-Avon, Melksham, Westbury, Frome and the surrounding villages. Not sure if you're in our area? Just give us a call.</p></div></div>
      </div>
    </div>
  </section>

  <section class="section book" id="book-cta">
    <div class="wrap" style="grid-template-columns:1fr;text-align:center;display:block">
      <div class="reveal" style="max-width:36ch;margin:0 auto">
        <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
        <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
        <p class="lede" style="margin-bottom:26px;color:#bfe0dc">Speak to a real, local person today — never a call centre. We'd love to help you or your loved one.</p>
        <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
          <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
          <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
        </div>
      </div>
      <div class="book-trust reveal">
        <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
        <RatedBadge />
      </div>
    </div>
  </section>

  <section class="accred">
    <div class="wrap">
      <span class="lab">Regulated &amp; accredited</span>
      <a href="https://www.cqc.org.uk/location/1-18269081969" target="_blank" rel="noopener"><img src={img("ff72ba_1dd84e5fdfa54621847dc493095a773f~mv2.jpg")} alt="Otter Homecare's Care Quality Commission profile" loading="lazy" /></a>
      <a href="https://www.homecareassociation.org.uk" target="_blank" rel="noopener"><img src={img("ff72ba_91a56724044b4b7e9b3fcaf45212292b~mv2.png")} alt="Member of the Homecare Association" loading="lazy" /></a>
      <a class="wide" href="https://www.homecare.co.uk" target="_blank" rel="noopener"><img src={img("ff72ba_08d2912203b449fcb907fb6fa089403a~mv2.jpg")} alt="Reviewed on homecare.co.uk" loading="lazy" /></a>
    </div>
  </section>
</SiteLayout>
