---
// Home care vs a care home. Built 22 Aug 2026 from Jamie's answers plus published
// local care home charges. Every figure comes from src/data/careCosts.ts.
//
// The page's power is restraint. It says where a care home genuinely wins, it does
// not name anyone's reviews, and it makes no claim about health outcomes — Jamie's
// team observe faster decline after a move, but people usually move once decline
// has begun, and that confound is stated rather than exploited.
import SiteLayout from "../layouts/SiteLayout.astro";
import RatedBadge from "../components/RatedBadge.astro";
import { otter, careHomes, funding, checked } from "../data/careCosts";

const liveInLow = otter.liveIn.A + otter.liveInFood;
const liveInHigh = otter.liveIn.C + otter.liveInFood;
const gbp = (n: number) => "£" + n.toLocaleString("en-GB");

// Chart geometry. Plot viewBox is 0 0 680 256 — x is hours of visiting care a
// day (0–8), y is £ a week (0–2,200). Derived, never typed by hand.
const PW = 680, PH = 256, Y_MAX = 2200, X_MAX = 8;
const py = (v: number) => +(PH - v * (PH / Y_MAX)).toFixed(2);
const px = (h: number) => +(h * (PW / X_MAX)).toFixed(2);
const pctTop = (v: number) => +((1 - v / Y_MAX) * 100).toFixed(2) + "%";

// £260 a week for every hour a day: five weekdays at £36 + two weekend days at £40.
const perHourDay = otter.visiting.hour.weekday * 5 + otter.visiting.hour.weekend * 2;
const liveBandLow  = otter.liveIn.A + otter.liveInFood;   // 1600
const liveBandHigh = otter.liveIn.C + otter.liveInFood;   // 1850
const chLow  = careHomes.dementiaResidential.low;         // 1795
const chHigh = careHomes.dementiaResidential.high;        // 1920

// The band of hours over which visiting care passes through both ranges —
// "about six to seven and a half hours a day" on the August 2026 figures.
const levelFromX = px(liveBandLow / perHourDay);
const levelToX   = px(chHigh / perHourDay);

const grid = [2000, 1500, 1000, 500];

const faqs = [
  { q: "Is live-in care really the same price as a care home?",
    a: `Close to it, and often less. Live-in care with us is ${gbp(liveInLow)}–${gbp(liveInHigh)} a week including the food allowance. Local homes publish ${gbp(careHomes.dementiaResidential.low)}–${gbp(careHomes.dementiaResidential.high)} a week for residential dementia care. At the top of our banding and the bottom of theirs the two are level; across most of the range live-in costs less.` },
  { q: "Would we have to sell the house to pay for a care home?",
    a: `Not immediately, and sometimes not at all. The value of the home is disregarded for the first ${funding.propertyDisregardWeeks} weeks, and a Deferred Payment Agreement lets the council pay and recover the money later instead of forcing a sale. If a partner still lives there, or a relative aged 60 or over or with a disability does, the home is disregarded entirely. What is true is that unless someone qualifying lives there, the property's value ultimately funds the care either way. For care at home it is never counted at all.` },
  { q: "Does Attendance Allowance stop in a care home?",
    a: "It depends who is paying. GOV.UK says you cannot usually get Attendance Allowance if you live in a care home and your care is paid for by your local authority — but you can still claim it if you pay all your care home costs yourself. At home it is unaffected." },
  { q: "Is home care always the better option?",
    a: "No, and we will tell you when it is not. If someone cannot be kept safe at home, needs 24-hour nursing, or needs care we are not able to give, a care home is the right answer and we will say so — even though it costs us the work." },
  { q: "What about a couple who both need care?",
    a: "This is where the gap is widest. Two care home places are two full fees. Two people at home are usually one package, priced at the upper end but still one package. On published local figures that difference runs to tens of thousands of pounds a year." },
  { q: "Can we start with a bit of help and see how it goes?",
    a: "Yes, and most families do. Visits can be half an hour once a day or several hours across the day, and they can go up or down as things change. Nothing here is a one-way door." },
];
const faqSchema = { "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: faqs.map(f => ({ "@type": "Question", name: f.q, acceptedAnswer: { "@type": "Answer", text: f.a } })) };
---
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
<SiteLayout
  title="Home Care vs a Care Home | Costs & Questions | Otter Homecare"
  description={`An honest comparison for families in Wiltshire — what a local care home actually costs against care at home, what the money buys, and when a care home is genuinely the better answer. Figures checked ${checked}.`}
  breadcrumbLabel="Home care vs a care home"
>
  <header class="phero"><div class="wrap">
    <div class="crumb"><a href="/">Home</a> · <a href="/cost-of-home-care">Costs &amp; Funding</a> · Home care vs a care home</div>
    <h1>Home care or a care home?</h1>
    <p>Most comparisons like this are written by someone who wants one answer. This one includes the cases where a care home is the better choice — because you will find those out anyway, and you should hear them from us first.</p>
  </div></header>

  <!-- THE SHORT ANSWER -->
  <section class="section tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">The short answer</span>
      <h2>On cost, there is much less in it than people expect</h2></div>
    <div class="reveal" style="max-width:64ch;margin:0 auto">
      <p class="lede" style="margin-bottom:14px">Families almost always assume a care home is the cheaper option. On the published local numbers, it usually is not.</p>
      <p style="margin-bottom:14px">Care homes near us publish <strong>{gbp(careHomes.dementiaResidential.low)}–{gbp(careHomes.dementiaResidential.high)} a week</strong> for residential dementia care, per person. Live-in care from us is <strong>{gbp(liveInLow)}–{gbp(liveInHigh)} a week</strong> including the food allowance.</p>
      <p style="margin-bottom:14px">So the honest headline is not "home care is cheaper". It is that <strong>the two cost about the same</strong> — which changes the question. If the money is roughly level, you are no longer choosing on price. You are choosing what the money buys.</p>
      <p style="margin-bottom:14px">Visiting care is a different matter: at up to about six hours a day it stays well below the cost of a care home place. Beyond that, live-in usually makes more sense — it costs less than the same hours bought as visits and it covers the night too.</p>
    </div>
  </div></section>

  <!-- CALCULATOR -->
  <section class="section bg-paper" id="calculator"><div class="wrap" style="max-width:900px">
  <div class="head-c reveal"><span class="eyebrow">Care calculator</span>
    <h2>What would each option cost?</h2>
    <p class="lede">An estimate, not a quote — every family's situation differs, and a care home's fee depends on the room and the assessment.</p></div>

  <div class="calc reveal" id="ccCalc">

    <div class="calc-ask">
      <label for="ccLevel">How much help is needed?</label>
      <select id="ccLevel">
        <option value="v1">A visit a day (1 hour)</option>
        <option value="v2">Two visits a day (1 hour each)</option>
        <option value="v3" selected>Three visits a day (1 hour each)</option>
        <option value="v4">Four visits a day (1 hour each)</option>
        <option value="sleep">Visits plus a sleeping night</option>
        <option value="wake">Visits plus a waking night</option>
        <option value="liveA">Live-in care — lower dependency</option>
        <option value="liveB">Live-in care — medium dependency</option>
        <option value="liveC">Live-in care — higher dependency</option>
      </select>
    </div>

    <div class="calc-refine">
      <div class="calc-group">
        <p id="ccWhoLab">Who needs care?</p>
        <div class="calc-pills" role="radiogroup" aria-labelledby="ccWhoLab" id="ccWho">
          <button type="button" class="calc-pill" role="radio" aria-checked="true"  tabindex="0" data-people="1">One person</button>
          <button type="button" class="calc-pill" role="radio" aria-checked="false" tabindex="-1" data-people="2">A couple, both needing care</button>
        </div>
      </div>
      <div class="calc-group">
        <p id="ccAALab">Attendance Allowance</p>
        <div class="calc-pills" role="radiogroup" aria-labelledby="ccAALab" id="ccAA">
          <button type="button" class="calc-pill" role="radio" aria-checked="true"  tabindex="0" data-aa="0">Not claiming</button>
          <button type="button" class="calc-pill" role="radio" aria-checked="false" tabindex="-1" data-aa={funding.attendanceAllowance.lower}>Lower — £{funding.attendanceAllowance.lower.toFixed(2)}</button>
          <button type="button" class="calc-pill" role="radio" aria-checked="false" tabindex="-1" data-aa={funding.attendanceAllowance.higher}>Higher — £{funding.attendanceAllowance.higher.toFixed(2)}</button>
        </div>
      </div>
    </div>

    <div class="calc-rule"></div>

    <div class="calc-figs">
      <div class="calc-fig">
        <span class="calc-tag">Care at home</span>
        <b id="ccHome">—</b>
        <span class="calc-per">a week · <span id="ccHomeYr"></span></span>
        <ul class="calc-notes" id="ccHomeNotes"></ul>
      </div>
      <div class="calc-fig">
        <span class="calc-tag">A local care home</span>
        <b id="ccCH">—</b>
        <span class="calc-per">a week · <span id="ccCHYr"></span></span>
        <ul class="calc-notes" id="ccCHNotes"></ul>
      </div>
    </div>

    <p class="calc-verdict" id="ccVerdict" aria-live="polite"></p>

    <div class="calc-cross">
      <h3>Where visiting care stops being the cheaper option</h3>
      <p>Read along the bottom for how many hours of care a day — about one hour per visit, so three visits a day sits at the 3 mark. Visiting care costs about {gbp(perHourDay)} a week for every hour a day. It stays below both live-in care and a local care home until roughly six hours a day — after that, live-in usually costs less than the same hours bought as visits, and it covers the night.</p>

      <div class="calc-plotgrid">
        <div class="calc-yaxis">
          {grid.map((v) => <span style={`top:${pctTop(v)}`}>{gbp(v)}</span>)}
        </div>

        <div class="calc-plot" id="ccPlot">
          <svg viewBox={`0 0 ${PW} ${PH}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
            {/* the hours over which the two are level */}
            <rect x={levelFromX} y="0" width={+(levelToX - levelFromX).toFixed(2)} height={PH}
                  fill="var(--cream)" stroke="var(--line)" stroke-width="1" vector-effect="non-scaling-stroke" />
            <g stroke="var(--line)" stroke-width="1">
              {grid.map((v) => <line x1="0" y1={py(v)} x2={PW} y2={py(v)} vector-effect="non-scaling-stroke" />)}
            </g>
            {/* live-in range — pale fill always takes a 1.5px --teal edge */}
            <rect x="0" y={py(liveBandHigh)} width={PW} height={+(py(liveBandLow) - py(liveBandHigh)).toFixed(2)}
                  fill="var(--teal-soft)" stroke="var(--teal)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
            {/* care home range — dashed outline, so the overlap with live-in stays visible */}
            <rect x="0" y={py(chHigh)} width={PW} height={+(py(chLow) - py(chHigh)).toFixed(2)}
                  fill="none" stroke="var(--teal-d)" stroke-width="1.5" stroke-dasharray="7 4" vector-effect="non-scaling-stroke" />
            {/* visiting care, £260 a week per hour a day */}
            <line x1="0" y1={PH} x2={PW} y2={py(perHourDay * X_MAX)}
                  stroke="var(--teal-d)" stroke-width="2.5" vector-effect="non-scaling-stroke" />
          </svg>
          <span class="calc-dot"      id="ccDot"  hidden></span>
          <span class="calc-liveline" id="ccLive" hidden></span>
          <span class="calc-offchart" id="ccOff"  hidden></span>
        </div>

        <div></div>
        <div class="calc-xaxis"><span>0</span><span>2 hrs</span><span>4 hrs</span><span>6 hrs</span><span>8 hrs</span></div>

        <div></div>
        <p class="calc-axisnote">Hours of visiting care a day — roughly one hour per visit · <span id="ccChartNote">shown for one person</span></p>
      </div>

      <div class="calc-key">
        <span><i class="k-visit"></i>Visiting care, by hours a day</span>
        <span><i class="k-live"></i>Live-in care {gbp(liveBandLow)}–{gbp(liveBandHigh)}</span>
        <span><i class="k-home"></i>A local care home {gbp(chLow)}–{gbp(chHigh)}</span>
        <span><i class="k-level"></i>Where the two are level</span>
      </div>
    </div>

      <p class="calc-checked">Figures checked {checked}. Care home charges are the homes' own published rates; ours are on our <a href="/cost-of-home-care">costs page</a>.</p>

  </div>
</div></section>

  <!-- WHAT THE MONEY BUYS -->
<section class="section tmt"><div class="wrap" style="max-width:820px">
  <div class="head-c reveal">
    <span class="eyebrow">If the money is level</span>
    <h2>What the money actually buys</h2>
  </div>
  <div class="reveal">
    <div class="buys-grid">

      <div class="buys">
        <span class="buys-ic"><img src="/assets/icons/team.svg" alt="" aria-hidden="true" width="26" height="26" loading="lazy" /></span>
        <h3>One-to-one time — and this surprises people.</h3>
        <p>Families often assume a care home means more attention, because there are more staff in the building. Several of our team have worked in both, including in management, and their experience is the opposite: homes are frequently short-staffed and carers move quickly between residents. At home, the carer's hour is yours. It can be spent going out.</p>
      </div>

      <div class="buys">
        <span class="buys-ic"><img src="/assets/icons/calendar.svg" alt="" aria-hidden="true" width="26" height="26" loading="lazy" /></span>
        <h3>Independence, in practice rather than in a brochure.</h3>
        <p>A care home runs on a timetable — shower times and mealtimes are largely fixed. At home, someone gets up when they want to get up and eats when they are hungry. Person-centred care is much easier to deliver when the day still belongs to the person.</p>
      </div>

      <div class="buys">
        <span class="buys-ic"><img src="/assets/icons/paw.svg" alt="" aria-hidden="true" width="26" height="26" loading="lazy" /></span>
        <h3>The pet stays.</h3>
        <p>A dog or a cat matters enormously to someone living alone, and most homes cannot take them. It sounds like a small thing next to the money. For a lot of people it is not a small thing at all.</p>
      </div>

      <div class="buys">
        <span class="buys-ic"><img src="/assets/icons/armchair.svg" alt="" aria-hidden="true" width="26" height="26" loading="lazy" /></span>
        <h3>The house stays a home.</h3>
        <p>Familiar rooms, familiar street, the neighbours who notice. For someone with dementia especially, a setting they already know is doing quiet work all day long.</p>
      </div>

    </div>
  </div>
</div></section>

  <!-- WHEN A CARE HOME IS RIGHT -->
  <section class="section bg-sky"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">Being straight with you</span><h2>When a care home is the better answer</h2></div>
    <div class="reveal" style="max-width:64ch;margin:0 auto">
      <p class="lede" style="margin-bottom:14px">There are situations where we will tell a family that a care home is the right choice, and we do tell them — even though it costs us the work.</p>
      <ul style="margin:0 0 14px 20px;display:flex;flex-direction:column;gap:8px">
        <li><strong>Safety we cannot manage.</strong> If someone cannot be kept safe at home, that outranks everything else on this page.</li>
        <li><strong>Twenty-four-hour nursing</strong>, or needs that require a clinical setting rather than a domestic one.</li>
        <li><strong>Severe mental health needs</strong> where someone requires a level of supervision or intervention that home care cannot provide.</li>
        <li><strong>Loneliness, where live-in is not an option.</strong> A real strength of a good care home is company all day. If someone is at genuine risk of isolation and live-in care is not affordable or wanted, that company can be worth more than the setting.</li>
      </ul>
      <p style="color:var(--muted)">We would rather lose the hours than keep someone at home where they should not be. If we think that, you will hear it from us plainly.</p>
    </div>
  </div></section>

  <!-- FUNDING TRAP -->
  <section class="section tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">Maybe worth knowing</span><h2>“Will the council pay?” has a different answer at each home</h2></div>
    <div class="reveal" style="max-width:64ch;margin:0 auto">
      <p style="margin-bottom:14px">Care homes choose which funding routes they accept, and they do not all accept the same ones. Of the local homes that publish this, some take council funding <em>only with a weekly top-up from the family</em>, and some do not take NHS Continuing Healthcare at all. Others accept every route.</p>
      <p style="margin-bottom:14px">A top-up is not a one-off. It is a payment someone has to keep making, every week, for as long as the placement lasts — and families often discover the requirement late, once a place has been chosen and a move is underway.</p>
      <p style="color:var(--muted)">Ask the question before you fall in love with a home: <em>which funding routes do you accept, and if the council funds the place, what top-up would we be committing to?</em></p>
    </div>
  </div></section>

  <!-- WHAT ABOUT THE HOUSE -->
  <section class="section bg-paper tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal">
      
      <span class="eyebrow">Before you decide</span>
      <h2>What about the house?</h2>
    </div>
    <div class="reveal" style="max-width:64ch;margin:0 auto">
      <p class="lede" style="margin-bottom:15px">This is the part families are most often surprised by, and it can matter more than the weekly figures.</p>
      <p style="margin-bottom:14px"><strong>For care at home, the value of the home is never counted</strong> in the council's financial assessment. Age UK put it plainly: “Unless you're moving into a care home, this won't take into account the value of your property.”</p>
      <p style="margin-bottom:14px"><strong>For a permanent care home place it is counted</strong> — though not straight away, and not always. It is disregarded for the first {funding.propertyDisregardWeeks} weeks. A Deferred Payment Agreement lets the council pay the fees and recover the money later, rather than forcing a sale. And it is disregarded entirely if a partner still lives there, or a relative aged 60 or over or with a disability does.</p>
      <p style="margin-bottom:14px">Where nobody qualifying lives in the property, the practical position is that its value funds the care either way — by sale, or by a deferred payment repaid from the estate. What changes is the timing, and whether the house stays in the family in the meantime.</p>
      <p class="calc-caveat">We are a care provider, not financial advisers, and we are not going to pretend otherwise. For your own situation, talk to <a href="https://www.ageuk.org.uk/information-advice/care/paying-for-care/" target="_blank" rel="noopener">Age UK</a> or an independent financial adviser who specialises in later-life care.</p>
    </div>
  </div></section>

  <!-- MOVING TOO LATE -->
  <section class="section tmt"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">One pattern we see</span><h2>Most people leave it later than they meant to</h2></div>
    <div class="reveal" style="max-width:64ch;margin:0 auto">
      <p style="margin-bottom:14px">Our team notice that people often decline quite quickly after moving into a home. We are careful about what we read into that, because the honest explanation is probably the simple one: people usually move at the point things have already started to slip. The decline was under way before the move.</p>
      <p style="margin-bottom:14px">But it points at something useful. The families who do best are not the ones who choose correctly between two options in a crisis — they are the ones who got a bit of help in early, while there was still a choice to make calmly.</p>
      <p style="color:var(--muted)">An hour a day, a few days a week, is often enough to hold a situation steady for a long time. It is a much easier decision than the one you are reading this page to make.</p>
    </div>
  </div></section>

  <!-- FAQS -->
  <section class="section bg-paper"><div class="wrap" style="max-width:820px">
    <div class="head-c reveal"><span class="eyebrow">Good to know</span><h2>Questions families ask us</h2></div>
    <div class="faqs reveal">
      {faqs.map((f) => (
        <div class="faq"><button type="button">{f.q}<span class="tog">+</span></button><div class="ans"><p>{f.a}</p></div></div>
      ))}
    </div>
  </div></section>

  <section class="section book"><div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
    <div class="reveal" style="max-width:38ch;margin:0 auto">
      <span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
      <h2 style="margin:14px 0 12px">Not sure which way to go?</h2>
      <p class="lede" style="margin-bottom:26px;color:#bfe0dc">Tell us the situation and we'll give you a straight answer — including if that answer is a care home.</p>
      <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
        <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
        <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
      </div>
    </div>
    <div class="book-trust reveal">
      <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
      <RatedBadge />
    </div>
  </div></section>

<script is:inline define:vars={{ otter, careHomes, perHourDay, Y_MAX, X_MAX }}>
  (function () {
    var el = function (id) { return document.getElementById(id); };
    var calc = el("ccCalc"); if (!calc) return;
    var gbp = function (n) { return "£" + Math.round(n).toLocaleString("en-GB"); };

    function visitWeek(rate, perDay) { return rate.weekday * perDay * 5 + rate.weekend * perDay * 2; }
    function nightWeek(rate) { return rate.weekday * 5 + rate.weekend * 2; }
    var foodNote = "Someone living in, round the clock (incl. £" + otter.liveInFood + " food)";

    var LEVELS = {
      v1:    function () { return { cost: visitWeek(otter.visiting.hour, 1), note: "1 hour a day, every day", hours: 1 }; },
      v2:    function () { return { cost: visitWeek(otter.visiting.hour, 2), note: "2 hours a day, every day", hours: 2 }; },
      v3:    function () { return { cost: visitWeek(otter.visiting.hour, 3), note: "3 hours a day, every day", hours: 3 }; },
      v4:    function () { return { cost: visitWeek(otter.visiting.hour, 4), note: "4 hours a day, every day", hours: 4 }; },
      sleep: function () { return { cost: visitWeek(otter.visiting.hour, 2) + nightWeek(otter.night.sleeping), note: "2 hours of visits a day, plus someone sleeping over" }; },
      wake:  function () { return { cost: visitWeek(otter.visiting.hour, 2) + nightWeek(otter.night.waking),  note: "2 hours of visits a day, plus someone awake all night" }; },
      liveA: function () { return { cost: otter.liveIn.A + otter.liveInFood, note: foodNote, live: true }; },
      liveB: function () { return { cost: otter.liveIn.B + otter.liveInFood, note: foodNote, live: true }; },
      liveC: function () { return { cost: otter.liveIn.C + otter.liveInFood, note: foodNote, live: true }; }
    };

    var people = 1, aa = 0;
    var pctTop = function (v) { return (1 - v / Y_MAX) * 100 + "%"; };

    function pills(wrap, attr, value, set) {
      wrap.querySelectorAll(".calc-pill").forEach(function (b) {
        b.setAttribute("aria-checked", String(parseFloat(b.dataset[attr]) === value));
      });
    }

    function render() {
      var key = el("ccLevel").value;
      var r = LEVELS[key]();

      var home = r.cost, homeNotes = [r.note];
      if (people === 2) {
        if (r.live) { home = otter.liveIn.C + otter.liveInFood; homeNotes.push("A couple is one live-in package, priced at the higher band — not two"); }
        else { home = r.cost * 1.5; homeNotes.push("Two people at home is one visit package with longer visits, not two packages — shown here as a rough uplift"); }
      }
      var chLow = careHomes.dementiaResidential.low * people;
      var chHigh = careHomes.dementiaResidential.high * people;
      var chNotes = ["Published local rates for residential dementia care"];
      if (people === 2) chNotes.push("Two places means two full fees");
      if (aa) {
        home = Math.max(0, home - aa * people);
        homeNotes.push("Less Attendance Allowance of " + gbp(aa * people) + " a week, which continues at home");
        chNotes.push("Attendance Allowance usually stops if the council funds a care home place");
      }

      el("ccHome").textContent = gbp(home);
      el("ccCH").textContent = gbp(chLow) + " – " + gbp(chHigh);
      el("ccHomeYr").textContent = "about " + gbp(home * 52) + " a year";
      el("ccCHYr").textContent = "about " + gbp(chLow * 52) + " – " + gbp(chHigh * 52) + " a year";
      el("ccHomeNotes").innerHTML = homeNotes.map(function (n) { return "<li>" + n + "</li>"; }).join("");
      el("ccCHNotes").innerHTML = chNotes.map(function (n) { return "<li>" + n + "</li>"; }).join("");

      // Verdict. The three sentences are the current ones, unchanged. The
      // trailing sentence on the cheaper cases is NEW COPY — see README.
      var v, fwd = "";
      if (home < chLow) {
        v = "On these figures care at home is <strong>" + gbp(chLow - home) + " to " + gbp(chHigh - home) +
            " a week less</strong> — around " + gbp((chLow - home) * 52) + " to " + gbp((chHigh - home) * 52) + " a year.";
        if (r.hours) fwd = "That holds while the hours stay where they are. Past about six hours a day, live-in care usually costs less than the same hours bought as visits.";
      } else if (home > chHigh) {
        v = "On these figures care at home costs <strong>" + gbp(home - chHigh) + " to " + gbp(home - chLow) +
            " a week more</strong>. At this level of support, live-in care is usually better value than buying the same hours as visits — and it covers the nights.";
      } else {
        v = "On these figures the two are <strong>about the same</strong>. Which means the decision is not really about money — it is about what the money buys.";
      }
      el("ccVerdict").innerHTML = v +
        (fwd ? ' <span class="cv-soft">' + fwd + "</span>" : "") +
        ' <span class="cv-soft">These are estimates, not quotes.</span>';

      // Chart marker. Always the one-person picture — the axis is hours, and a
      // couple is one package, so doubling it would draw a relationship that
      // does not exist.
      var dot = el("ccDot"), live = el("ccLive"), off = el("ccOff");
      dot.hidden = live.hidden = off.hidden = true;
      if (r.hours) {
        dot.hidden = false;
        dot.style.left = (r.hours / X_MAX) * 100 + "%";
        dot.style.top = pctTop(perHourDay * r.hours);
      } else if (r.live) {
        live.hidden = false;
        live.style.top = pctTop(r.cost);
      } else {
        off.hidden = false;
        off.textContent = gbp(r.cost) + " a week — above the top of this chart";
      }
      el("ccChartNote").textContent = people === 2
        ? "shown for one person; the figures above are for a couple"
        : "shown for one person";
    }

    // role="radio" announces a radiogroup, which commits us to arrow-key
    // navigation and a roving tabindex — a screen-reader user is told these are
    // radios and will try to drive them as radios. The handoff set the roles and
    // the click handling but not this, so without it the group is operable only
    // by Tab-and-Space and does not behave as announced.
    function wireRadios(wrap, onPick) {
      var btns = Array.prototype.slice.call(wrap.querySelectorAll(".calc-pill"));
      function focusTo(i) {
        var n = (i + btns.length) % btns.length;
        btns.forEach(function (b, k) { b.tabIndex = k === n ? 0 : -1; });
        btns[n].focus(); onPick(btns[n]);
      }
      wrap.addEventListener("keydown", function (e) {
        var i = btns.indexOf(document.activeElement); if (i < 0) return;
        if (e.key === "ArrowRight" || e.key === "ArrowDown") { e.preventDefault(); focusTo(i + 1); }
        else if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); focusTo(i - 1); }
        else if (e.key === "Home") { e.preventDefault(); focusTo(0); }
        else if (e.key === "End") { e.preventDefault(); focusTo(btns.length - 1); }
      });
    }


    el("ccLevel").addEventListener("change", render);
    el("ccWho").addEventListener("click", function (e) {
      var b = e.target.closest(".calc-pill"); if (!b) return;
      people = parseInt(b.dataset.people, 10); pills(this, "people", people); render();
    });
    el("ccAA").addEventListener("click", function (e) {
      var b = e.target.closest(".calc-pill"); if (!b) return;
      aa = parseFloat(b.dataset.aa) || 0; pills(this, "aa", aa); render();
    });
      // Route the keyboard through exactly the same state setters the click
      // handlers use, so there is one source of truth for `people` and `aa`.
      wireRadios(el("ccWho"), function (b) {
        people = parseInt(b.dataset.people, 10); pills(el("ccWho"), "people", people); render();
      });
      wireRadios(el("ccAA"), function (b) {
        aa = parseFloat(b.dataset.aa) || 0; pills(el("ccAA"), "aa", aa); render();
      });

    render();
  })();
</script>
</SiteLayout>
