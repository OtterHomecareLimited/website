---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout
  title="Page not found | Otter Homecare"
  description="Sorry — we couldn't find that page. Find your way back to Otter Homecare's care services, areas we cover, or get in touch."
>
  <section class="section" style="text-align:center;padding:110px 0">
    <div class="wrap" style="max-width:56ch">
      <div class="reveal in">
        <span class="eyebrow">Page not found</span>
        <h1 style="margin:14px 0 14px">Sorry — we can't find that page</h1>
        <p class="lede" style="max-width:none">The page may have moved when we refreshed our website. The links below should get you back on track — or just give us a ring and a real person will help.</p>
        <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap;margin-top:26px">
          <a class="btn btn-primary btn-lg" href="/">Back to home →</a>
          <a class="btn btn-ghost btn-lg" href="/care-services">Our care services</a>
          <a class="btn btn-ghost btn-lg" href="tel:01225690022">Call 01225 690022</a>
        </div>
      </div>
    </div>
  </section>
</SiteLayout>
