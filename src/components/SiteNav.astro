---
// v5 nav: gold rotating utility bar + teal nav with 6-item dropdown IA.
// Desktop = hover dropdowns; mobile = <details> accordions. Real route links.
const caret = `<svg class="caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"></path></svg>`;
---
<div class="util"><div class="wrap">
  <span class="util-promise">
    <svg class="util-heart" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 21s-7.5-4.9-10-9.2C.4 8.5 2 5 5.3 5c2 0 3.4 1.2 4.2 2.4C10.3 6.2 11.7 5 13.7 5 17 5 18.6 8.5 17 11.8 14.5 16.1 12 21 12 21z"></path></svg>
    <span class="util-rot" id="utilRot" aria-live="polite">We treat your family <span class="em">like our own</span></span>
  </span>
  <a href="tel:01225690022">01225 690022 · hello@otterhomecare.co.uk</a>
</div></div>

<nav>
  <div class="inner">
    <a class="brand" href="/"><img class="logo" src="/assets/otter-logo-white.png" alt="Otter Homecare" /></a>
    <div class="navlinks">
      <div class="has-drop">
        <button class="toplink" type="button">Our Care <Fragment set:html={caret} /></button>
        <div class="dropdown"><div class="dropdown-inner">
          <a href="/care-services">Care Services</a>
          <div class="dd-sep"></div>
          <a href="/personal-care">Personal Care</a>
          <a href="/visiting-care">Visiting Care</a>
          <a href="/live-in-care">Live-in Care</a>
          <a href="/companionship">Companionship</a>
          <a href="/conditions">Conditions We Care For</a>
          <a href="/fall-recovery">Fall Recovery</a>
        </div></div>
      </div>
      <div class="has-drop">
        <button class="toplink" type="button">Areas We Cover <Fragment set:html={caret} /></button>
        <div class="dropdown"><div class="dropdown-inner">
          <a href="/areas-we-cover">All areas</a>
          <div class="dd-sep"></div>
          <a href="/trowbridge">Trowbridge</a>
          <a href="/bradford-on-avon">Bradford-on-Avon</a>
          <a href="/melksham">Melksham</a>
          <a href="/westbury">Westbury</a>
          <a href="/frome">Frome</a>
        </div></div>
      </div>
      <a href="/how-we-work">How We Work</a>
      <a href="/cost-of-home-care">Costs &amp; Funding</a>
      <div class="has-drop">
        <button class="toplink" type="button">About <Fragment set:html={caret} /></button>
        <div class="dropdown"><div class="dropdown-inner">
          <a href="/our-story">Our Story</a>
          <a href="/our-team">Meet the Team</a>
          <a href="/support-for-families">For Families &amp; Care App</a>
          <a href="/reviews">Reviews</a>
          <a href="/faqs">FAQs</a>
          <a href="/blog">Blog</a>
          <a href="/otter-cafe">Otter Café</a>
        </div></div>
      </div>
      <a href="/careers">Careers</a>
    </div>
    <div class="nav-cta">
      <a class="btn btn-primary" href="/#book">Book a free assessment <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></a>
    </div>
    <a class="nav-call" href="tel:01225690022" aria-label="Call us"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></a>
    <button class="nav-toggle" id="navToggle" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
  </div>
  <div class="mobile-menu" id="mobileMenu">
    <details><summary>Our Care</summary><div class="sub">
      <a href="/care-services">Care Services</a>
      <a href="/personal-care">Personal Care</a>
      <a href="/visiting-care">Visiting Care</a>
      <a href="/live-in-care">Live-in Care</a>
      <a href="/companionship">Companionship</a>
      <a href="/conditions">Conditions We Care For</a>
