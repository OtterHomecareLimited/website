      <a href="/melksham">Melksham</a>
      <a href="/westbury">Westbury</a>
      <a href="/frome">Frome</a>
    </div></details>
    <a href="/how-we-work">How We Work</a>
    <a href="/cost-of-home-care">Costs &amp; Funding</a>
    <details><summary>About</summary><div class="sub">
      <a href="/our-story">Our Story</a>
      <a href="/our-team">Meet the Team</a>
      <a href="/support-for-families">For Families &amp; Care App</a>
      <a href="/reviews">Reviews</a>
      <a href="/faqs">FAQs</a>
      <a href="/blog">Blog</a>
      <a href="/otter-cafe">Otter Café</a>
    </div></details>
    <a href="/careers">Careers</a>
    <div class="mm-cta">
      <a class="btn btn-primary" href="/#book">Book a free assessment</a>
      <a class="btn btn-ghost" href="tel:01225690022">Call 01225 690022</a>
    </div>
  </div>
</nav>
