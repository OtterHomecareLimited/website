---
import type { Service } from "../data/services";
interface Props { service: Service }
const { service } = Astro.props;
---
<!-- Hero -->
<section class="loc-hero">
  <div class="wrap">
    <span class="eyebrow">🦦 Our care · {service.name}</span>
    <h1>{service.h1}</h1>
    <p class="lede">{service.subtitle}</p>
    <div class="hero-ctas">
      <a href="/contact" class="cta large">Arrange a free chat →</a>
      <a href="tel:01225690022" class="cta ghost large">Call 01225 690022</a>
    </div>
  </div>
</section>

<!-- Body: intro + "what's included" sidebar -->
<section>
  <div class="wrap">
    <div class="loc-grid">
      <div class="loc-intro">
        {service.intro.map((para) => <p>{para}</p>)}

        {service.note && (
          <p style="background:var(--teal-soft);border-radius:var(--radius);padding:16px 20px;color:var(--teal-dark)">
            <strong>{service.note}</strong>
          </p>
        )}

        {service.testimonial && (
          <div class="quote" style="margin-top:32px">
            <p>{service.testimonial.quote}</p>
            <div class="who">
              <div class="avatar">{service.testimonial.who.slice(0, 1)}</div>
              <div><div class="name">{service.testimonial.who}</div></div>
            </div>
          </div>
        )}
      </div>

      <aside class="loc-side">
        <h3>What's included</h3>
        <ul>
          {service.included.map((item) => (
            <li><span class="dot" style="background:var(--sage)"></span>{item}</li>
          ))}
        </ul>
        {service.price && (
          <p style="font-size:18px;font-weight:700;color:var(--teal);margin:4px 0 18px">{service.price}</p>
        )}
        <a href="/contact" class="cta" style="width:100%;justify-content:center">Book a free assessment →</a>
      </aside>
    </div>
  </div>
</section>

<!-- Cross-sell strip -->
<section class="how" style="background:var(--cream)">
  <div class="wrap">
    <div class="big-cta" style="background:linear-gradient(135deg,var(--teal) 0%,var(--teal-dark) 100%);border-radius:var(--radius);padding:56px 24px">
      <h2 style="font-size:30px">Not sure which kind of care you need?</h2>
      <p>Have a free, no-pressure chat with someone local. We'll listen first and help you work it out.</p>
      <div class="row">
        <a href="tel:01225690022" class="phone">📞 01225 690022</a>
        <a href="/contact" class="cta large" style="background:#fff;color:var(--teal)">Get in touch →</a>
      </div>
    </div>
  </div>
</section>
