---
import RatedBadge from "./RatedBadge.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { Service } from "../data/services";
import { services } from "../data/services";
import TTMark from "./TTMark.astro";
import PheroCta from "./PheroCta.astro";
import Photo from "./Photo.astro";

interface Props { service: Service }
const { service } = Astro.props;
const img = (f: string) => `/img/${f}`;
// Fall Recovery is kept live (old links, 2024 leaflet QR) but not promoted (Jamie, 8 Oct 2026), so never suggest it.
const others = services.filter((s) => s.slug !== service.slug && s.slug !== "fall-recovery").slice(0, 3);

// schema.org Service — emitted only when the service entry opts in via serviceType.
const canonicalUrl = new URL(`/${service.slug}`, Astro.site).href;
const serviceSchema = service.serviceType
  ? {
      "@context": "https://schema.org",
      "@type": "Service",
      serviceType: service.serviceType,
      name: service.name,
      description: service.description,
      url: canonicalUrl,
      provider: {
        "@type": "HomeHealthCareService",
        "@id": "https://www.otterhomecare.co.uk/#organization",
        name: "Otter Homecare",
      },
      areaServed: (service.areaServed ?? []).map((a) => ({ "@type": "Place", name: a })),
      ...(service.priceFrom
        ? {
            offers: {
              "@type": "Offer",
              priceCurrency: "GBP",
              price: service.priceFrom.amount,
              priceSpecification: {
                "@type": "UnitPriceSpecification",
                priceCurrency: "GBP",
                price: service.priceFrom.amount,
                unitText: service.priceFrom.unit,
              },
            },
          }
        : {}),
    }
  : null;
// schema.org FAQPage — emitted only when the service entry supplies FAQs.
const faqSchema = service.faqs?.length
  ? {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      mainEntity: service.faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a.join(" ") },
      })),
    }
  : null;

// Quicker to scan (28 Sep review P3, Jamie chose "All four", 17 Oct 2026):
// key facts after the intro, "On this page" links, the review mid-page and a
// second button after the costs section. All of it is built from the data above.
const money = (n: number) => `£${n.toLocaleString("en-GB", { minimumFractionDigits: n % 1 ? 2 : 0 })}`;
// Fall Recovery is for existing clients and has no rate of its own, so it gets no key-facts card.
const fromLine = service.priceFrom
  ? `From ${money(service.priceFrom.amount)} ${
      service.priceFrom.unit === "WEEK" ? "a week" : `a ${service.priceFrom.unit.replace(" (9 hours)", "")}`
    }`
  : null;
const slugify = (t: string) => t.toLowerCase().replace(/<[^>]+>/g, "").replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
const used = new Set<string>();
const secs = (service.sections ?? []).map((sec) => {
  let id = slugify(sec.h2);
  while (used.has(id)) id += "-2";
  used.add(id);
  return { ...sec, id, isCost: /cost/i.test(`${sec.eyebrow ?? ""} ${sec.h2}`) };
});
// Two live-in headings differ only by a comma; list the first one only.
const seen = new Set<string>();
const toc = [
  ...(service.secondList ? [{ id: "who-for", label: service.secondListTitle ?? "" }] : []),
  ...secs.map((sec) => ({ id: sec.id, label: sec.h2 })),
  ...(service.faqs?.length ? [{ id: "questions", label: "Questions" }] : []),
].filter((t) => {
  const k = t.label.toLowerCase().replace(/[^a-z]/g, "");
  if (!t.label || seen.has(k)) return false;
  seen.add(k);
  return true;
});
// The review sits inside the middle section (a band of its own would break the band joins); pages without sections keep it near the end.
const quoteAfter = secs.length >= 2 ? Math.ceil(secs.length / 2) - 1 : -1;
---
<SiteLayout title={service.title} description={service.description}>
  {serviceSchema && <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />}
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
  <header class="phero phero--photo">
    <div class="wrap">
      <div class="phero-text">
        <div class="crumb"><a href="/">Home</a> · <a href="/care-services">Care Services</a> · {service.name}</div>
        <h1>{service.h1}</h1>
        <p>{service.subtitle}</p>
        <PheroCta />
      </div>
      <div class="phero-media"><Photo src={img(service.heroImg)} alt={service.h1} priority sizes="(max-width: 900px) 100vw, 520px" /></div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="srow srow--solo reveal">
        <div>
          {service.intro.map((p) => <p class="lede" style="margin-bottom:14px">{p}</p>)}
          {service.slug !== "fall-recovery" && (<dl class="svc-facts">
            <div><dt>Cost</dt><dd>{fromLine ?? "Every rate is published"} · <a href="/cost-of-home-care">full rate card</a></dd></div>
            <div><dt>Who comes</dt><dd>A small, familiar team, directly employed and DBS-checked</dd></div>
            <div><dt>Getting started</dt><dd>A free home assessment, usually the same day you call</dd></div>
            <div><dt>Where</dt><dd>Trowbridge, Melksham, Frome and nearby towns · <a href="/areas-we-cover">areas we cover</a></dd></div>
          </dl>)}
          {toc.length >= 3 && (
            <nav class="svc-toc" aria-label="On this page">
              <p class="svc-toc__title">On this page</p>
              <ul>{toc.map((t) => <li><a href={`#${t.id}`}>{t.label}</a></li>)}</ul>
            </nav>
          )}
          <h2 style="font-size:22px;margin:20px 0 8px">{service.includedTitle ?? "What's included"}</h2>
          <ul>{service.included.map((i) => <li>{i}</li>)}</ul>
          {service.price && (
            <p style="background:var(--sun-soft);border-radius:var(--r-sm);padding:14px 18px;margin-top:18px;font-size:17px"><strong>Cost &amp; funding.</strong> {service.price}</p>
          )}
          {service.note && (
            <p style="background:var(--teal-soft);border-radius:var(--r-sm);padding:12px 16px;margin-top:14px;font-size:15px;color:var(--teal-d)"><strong>{service.note}</strong></p>
          )}
          <a class="btn btn-primary" href="/contact" style="margin-top:20px">Book a free assessment →</a>
        </div>
      </div>
    </div>
  </section>

  {service.secondList && (
    <section class="section trustwhy" id="who-for">
      <div class="wrap">
        <div class="head-c reveal"><h2>{service.secondListTitle}</h2></div>
        <div class="conds reveal">{service.secondList.map((i) => <span>{i}</span>)}</div>
      </div>
    </section>
  )}

  {secs.map((sec, i) => (
    <section class="section" id={sec.id}>
      <div class="wrap" style="max-width:760px">
        <div class="reveal">
          {sec.eyebrow && <span class="eyebrow">{sec.eyebrow}</span>}
          <h2 style="font-size:clamp(24px,3vw,32px);margin:8px 0 14px">{sec.h2}</h2>
          {sec.body && sec.body.map((p) => <p class="lede" style="max-width:none;margin-bottom:14px" set:html={p}></p>)}
          {sec.list && <ul class="svc-seclist">{sec.list.map((li) => <li>{li}</li>)}</ul>}
          {sec.isCost && (
            <div class="svc-cta">
              <a class="btn btn-primary" href="/contact">Book a free assessment</a>
              <a class="btn btn-ghost" href="tel:01225690022">Call 01225 690022</a>
            </div>
          )}
          {i === quoteAfter && service.testimonial && (
            <figure class="quote svc-midquote">
              <div class="star">★★★★★</div>
              <p>{service.testimonial.quote}</p>
              <div class="by"><span class="av">{service.testimonial.who.slice(0, 1)}</span><div><b>{service.testimonial.who}</b></div></div>
            </figure>
          )}
        </div>
      </div>
    </section>
  ))}

  {service.faqs && service.faqs.length > 0 && (
    <section class="section trustwhy" id="questions">
      <div class="wrap">
        <div class="head-c reveal"><span class="eyebrow">Good to know</span><h2>{service.name} questions</h2></div>
        <div class="faqs reveal">
          {service.faqs.map((f) => (
            <div class="faq">
              <button type="button">{f.q}<span class="tog">+</span></button>
              <div class="ans">{f.a.map((p) => <p>{p}</p>)}</div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {service.testimonial && quoteAfter < 0 && (
    <section class="section tmt">
      <div class="wrap">
        <div class="quote reveal" style="max-width:760px;margin:0 auto">
          <div class="star">★★★★★</div>
          <p>{service.testimonial.quote}</p>
          <div class="by"><span class="av">{service.testimonial.who.slice(0, 1)}</span><div><b>{service.testimonial.who}</b></div></div>
        </div>
      </div>
    </section>
  )}

  <section class="section tmt">
    <div class="wrap">
      <div class="head-c reveal"><h2>Other ways we can help</h2></div>
      <div class="svc-grid svc-others">
        {others.map((o) => (
          <a class="svc reveal" href={`/${o.slug}`}><div class="body"><h3>{o.name}</h3><p>{o.subtitle}</p><span class="more">Learn more →</span></div></a>
        ))}
      </div>
    </div>
  </section>

  <section class="section book" id="book-cta">
    <div class="wrap" style="grid-template-columns:1fr;display:block;text-align:center">
      <div class="reveal" style="max-width:36ch;margin:0 auto">
        <TTMark pose={97} animate class="book-mark" /><span class="eyebrow" style="color:#9fc4bf">Free, no-obligation assessment</span>
        <h2 style="margin:14px 0 12px">Let's find the right care, together</h2>
        <p class="lede" style="margin-bottom:26px;color:#bfe0dc">A friendly voice, not a call centre.</p>
        <div style="display:flex;gap:13px;justify-content:center;flex-wrap:wrap">
          <a class="btn btn-clay btn-lg" href="/contact">Book a free assessment</a>
          <a class="btn btn-ghost btn-lg" href="tel:01225690022" style="background:transparent;color:#fff;border-color:rgba(255,255,255,.5)">Call 01225 690022</a>
        </div>
      </div>
      <div class="book-trust reveal">
        <div class="bt-ticks"><span>Free, no-obligation home visit</span><span>A care plan built around you</span><span>We usually reply the same day</span></div>
        <RatedBadge />
      </div>
    </div>
  </section>
</SiteLayout>
