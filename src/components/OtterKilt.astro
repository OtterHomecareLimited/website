---
/**
 * The Otter Homecare mascot in its kilt, inline so CSS can move it.
 *
 * Geometry and colours from Core/Brand Assets/Logos and mascotts/otter with
 * kilt.svg. Unlike the plain mascot's file, this one's stylesheet was intact,
 * so nothing needed reconstructing.
 *
 * Parts, worked out by rendering each class in a different colour and by
 * bounding box: st10 head, st12 nose, st6 and st5 whiskers, st7 smile,
 * st3 tongue, st2 body, st11 belly, st8 tail, st13/st14/st0/st4/st1 the kilt
 * and sporran.
 *
 * st9 is the one to watch: it holds the ear interiors, the eyes AND the paw
 * markings. Only the first two belong to the head. Rotating all of st9 with
 * the head would swing the paws round with it.
 *
 * Each eye sits in its own .kilt-headrot group so it can blink about its own
 * centre while turning about the neck — one element cannot carry two
 * transform origins.
 */
interface Props { class?: string }
const { class: className = "" } = Astro.props;
