---
// Sticky site header — real Otter wordmark (home link), primary nav, primary CTA.
import { Image } from "astro:assets";
import wordmark from "../assets/img/logo-wordmark.png";
---
<header class="site">
  <div class="wrap">
    <a href="/" class="logo" aria-label="Otter Homecare — home">
      <Image src={wordmark} alt="Otter Homecare" class="logo-wordmark" height={54} />
    </a>
    <nav class="primary">
      <a href="/care-services">Our Care</a>
      <a href="/areas-we-cover">Areas</a>
      <a href="/how-we-work">How it Works</a>
      <a href="/blog">Blog</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/contact" class="cta">Get in Touch →</a>
  </div>
</header>
