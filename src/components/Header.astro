---
// Sticky site header — logo (home link), primary nav, primary CTA.
import { Image } from "astro:assets";
import logo from "../assets/img/logo.png";
---
<header class="site">
  <div class="wrap">
    <a href="/" class="logo">
      <Image src={logo} alt="Otter Homecare" class="logo-mark" width={42} height={42} />
      Otter Homecare
    </a>
    <nav class="primary">
      <a href="/care-services">Our Care</a>
      <a href="/areas-we-cover">Areas</a>
      <a href="/how-we-work">How it Works</a>
      <a href="/blog">Blog</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/contact" class="cta">Get in Touch →</a>
  </div>
</header>
