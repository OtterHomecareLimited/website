---
// "Adjust this site" accessibility control. Behaviour + persistence here (Code);
// final visual styling of the button/panel is design's to refine (functional baseline below).
---
<button id="a11yToggle" class="a11y-toggle" aria-expanded="false" aria-controls="a11yPanel">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="4" r="1.6" fill="currentColor" stroke="none"></circle><path d="M4 8h16M12 8v6m0 0l-3.5 5M12 14l3.5 5" stroke-linecap="round"></path></svg>
  <span>Adjust this site</span>
</button>

<div id="a11yPanel" class="a11y-panel" role="dialog" aria-label="Accessibility options" hidden>
  <h2>Make this site easier to use</h2>
  <div class="a11y-row">
    <span>Text size</span>
    <div class="a11y-seg">
      <button type="button" data-a11y="text-down" aria-label="Smaller text">A&minus;</button>
      <button type="button" data-a11y="text-up" aria-label="Larger text">A+</button>
    </div>
  </div>
  <button type="button" class="a11y-opt" data-a11y="font" aria-pressed="false">Easy-read spacing</button>
  <button type="button" class="a11y-opt" data-a11y="motion" aria-pressed="false">Reduce motion</button>
  <button type="button" class="a11y-opt" data-a11y="read" aria-pressed="false">Read this page aloud</button>
  <button type="button" class="a11y-reset" data-a11y="reset">Reset</button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement, KEY = "otterA11y";
    var state = {};
    try { state = JSON.parse(localStorage.getItem(KEY) || "{}"); } catch (e) {}
    function apply() {
      root.classList.toggle("a11y-text-1", state.text === 1);
      root.classList.toggle("a11y-text-2", state.text >= 2);
      root.classList.toggle("a11y-easy-font", !!state.font);
      root.classList.toggle("a11y-reduce-motion", !!state.motion);
      var f = document.querySelector('[data-a11y="font"]'); if (f) f.setAttribute("aria-pressed", String(!!state.font));
      var m = document.querySelector('[data-a11y="motion"]'); if (m) m.setAttribute("aria-pressed", String(!!state.motion));
      try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {}
    }
    apply();

    var toggle = document.getElementById("a11yToggle"), panel = document.getElementById("a11yPanel");
    function setOpen(o) { if (o) panel.removeAttribute("hidden"); else panel.setAttribute("hidden", ""); toggle.setAttribute("aria-expanded", String(o)); }
    toggle.addEventListener("click", function (e) { e.stopPropagation(); setOpen(panel.hasAttribute("hidden")); });
    document.addEventListener("click", function (e) { if (!panel.hasAttribute("hidden") && !panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !panel.hasAttribute("hidden")) { setOpen(false); toggle.focus(); } });

    // read-aloud (browser SpeechSynthesis)
    var reading = false;
    function stopRead() { reading = false; try { window.speechSynthesis.cancel(); } catch (e) {} var r = document.querySelector('[data-a11y="read"]'); if (r) { r.setAttribute("aria-pressed", "false"); r.textContent = "Read this page aloud"; } }
    function startRead() {
      if (!("speechSynthesis" in window)) { alert("Sorry — read-aloud isn't supported in this browser."); return; }
      var main = document.getElementById("main") || document.body;
      var text = (main.innerText || main.textContent || "").replace(/\s+/g, " ").trim().slice(0, 6000);
      var u = new SpeechSynthesisUtterance(text); u.rate = 0.95; u.lang = "en-GB";
      u.onend = stopRead;
      window.speechSynthesis.cancel(); window.speechSynthesis.speak(u);
      reading = true; var r = document.querySelector('[data-a11y="read"]'); if (r) { r.setAttribute("aria-pressed", "true"); r.textContent = "Stop reading"; }
    }

    document.querySelectorAll("[data-a11y]").forEach(function (b) {
      b.addEventListener("click", function () {
        var a = b.getAttribute("data-a11y");
        if (a === "text-up") state.text = Math.min(2, (state.text || 0) + 1);
        else if (a === "text-down") state.text = Math.max(0, (state.text || 0) - 1);
        else if (a === "font") state.font = !state.font;
        else if (a === "motion") state.motion = !state.motion;
        else if (a === "reset") { state = {}; stopRead(); }
        else if (a === "read") { reading ? stopRead() : startRead(); return; }
        apply();
      });
    });
    window.addEventListener("beforeunload", stopRead);
  })();
</script>
