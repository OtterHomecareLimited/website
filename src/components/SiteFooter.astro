---
// Design-system footer.
const mark = "/img/ff72ba_22266503bf64408e9f5cd5af4757b439~mv2.png";
const year = new Date().getFullYear();
---
<footer>
  <div class="wrap">
    <div>
      <a class="brand" href="/"><img class="logo" src="/assets/otter-logo-white.png" alt="Otter Homecare" /></a>
      <p>Compassionate home care across Wiltshire &amp; Somerset.</p>
      <p style="margin-top:14px">Arlington House, 72 Fore Street,<br>Trowbridge, Wiltshire BA14 8HQ</p>
    </div>
    <div>
      <h4>Our Care</h4>
      <a href="/personal-care">Personal Care</a>
      <a href="/visiting-care">Visiting Care</a>
      <a href="/live-in-care">Live-in Care</a>
      <a href="/companionship">Companionship</a>
      <a href="/conditions">Conditions We Care For</a>
      <a href="/dementia">Dementia Care</a>
    </div>
    <div>
      <h4>Explore</h4>
      <a href="/how-we-work">How We Work</a>
      <a href="/cost-of-home-care">Costs &amp; Funding</a>
      <a href="/areas-we-cover">Areas We Cover</a>
      <a href="/reviews">Reviews</a>
      <a href="/careers">Careers</a>
      <a href="/contact">Contact</a>
    </div>
    <div>
      <h4>Stay connected</h4>
      <p>Subscribe to our newsletter for community news.</p>
      <form class="news" id="newsForm" action="/api/contact" method="POST">
        <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
        <input name="email" type="email" placeholder="Your email" aria-label="Your email" required />
        <button type="submit">Submit</button>
      </form>
      <p id="newsOk" style="display:none;margin-top:10px;color:#bcd6d2;font-weight:700">Thanks — you're on the list.</p>
      <script is:inline>
        (function () {
          var f = document.getElementById("newsForm"); if (!f) return;
          f.addEventListener("submit", async function (e) {
            e.preventDefault();
            var email = (f.querySelector("[name=email]") || {}).value || "";
            if (!email) return;
            var btn = f.querySelector("button"); btn.disabled = true; btn.textContent = "…";
            try {
              var r = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify({ name: "Newsletter subscriber", email: email, msg: "Newsletter signup (footer)", company: (f.querySelector("[name=company]") || {}).value || "" }) });
              var j = await r.json();
              if (r.ok && j.ok) { f.style.display = "none"; document.getElementById("newsOk").style.display = "block"; }
              else { btn.disabled = false; btn.textContent = "Submit"; alert(j.error || "Something went wrong — please email hello@otterhomecare.co.uk."); }
            } catch (_) { btn.disabled = false; btn.textContent = "Submit"; alert("Something went wrong — please email hello@otterhomecare.co.uk."); }
          });
        })();
      </script>
      <p style="margin-top:14px">01225 690022 · hello@otterhomecare.co.uk</p>
    </div>
  </div>
  <div class="legal">© {year} Otter Homecare Limited. All Rights Reserved. · <a href="/privacy" style="display:inline">Privacy Policy</a> · <a href="/terms" style="display:inline">Terms &amp; Conditions</a> · <a href="/modern-slavery" style="display:inline">Modern Slavery</a></div>
</footer>
