---
import Turnstile from "./Turnstile.astro";
// "Talk to us" launcher. Markup + look = design (otter-a11y-talk). Behaviour = Code.
// Hooks: #talkToggle, #talkPanel, .talk-opt, #talkForm. Channels: phone + inline
// message form (posts to /api/contact, same handler as the Contact page).
---
<button id="talkToggle" class="otter-fab" aria-expanded="false" aria-controls="talkPanel" aria-haspopup="dialog">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.1 7.6L3 21l1.9-5.9A8.4 8.4 0 1 1 21 11.5z"></path></svg>
  <span class="fab-label">Talk to us</span>
</button>

<div id="talkPanel" class="otter-pop" role="dialog" aria-label="Talk to us" hidden>
  <div class="pop-head">
    <div><h2>Talk to us</h2></div>
    <button class="pop-close" data-talk-close type="button" aria-label="Close">✕</button>
  </div>
  <p class="talk-note">You'll always reach a real person here — not a bot. We're a small local team, so if we're with a client we'll get back to you shortly. <b>Office hours Mon–Fri, 9–5.</b></p>

  <a class="talk-opt talk-opt-call" href="tel:01225690022">
    <span class="ti"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8.1 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"></path></svg></span>
    <span><b>Call us</b><small>01225 690022 · usually the quickest</small></span>
  </a>

  <form class="talk-form" id="talkForm" novalidate>
    <p class="tf-lead">Leave your details and we'll get back to you shortly — a phone number's usually quickest.</p>
    <input type="text" name="name" autocomplete="name" placeholder="Your name" aria-label="Your name" required>
    <input type="tel" name="phone" autocomplete="tel" placeholder="Phone number" aria-label="Phone number">
    <input type="email" name="email" autocomplete="email" placeholder="Email address" aria-label="Email address">
    <textarea name="msg" rows="2" placeholder="How can we help? (optional)" aria-label="How can we help?"></textarea>
    <input class="talk-hp" type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true">
      <input type="hidden" name="ts" value="" data-stamp />
    <Turnstile />
    <button type="submit">Send message →</button>
  </form>

  <div class="talk-form-ok" id="talkFormOk" role="status" hidden>
    <b>Thank you — message received.</b>
    We'll be in touch very soon. If it's urgent, please call <b style="display:inline">01225 690022</b>.
  </div>
</div>

<script is:inline>
  (function () {
    var panel = document.getElementById("talkPanel"), toggle = document.getElementById("talkToggle");
    if (!panel || !toggle) return;
    function setOpen(o) {
      if (o) { panel.removeAttribute("hidden"); void panel.offsetWidth; panel.classList.add("open"); var ap = document.getElementById("a11yPanel"); if (ap) { ap.classList.remove("open"); ap.setAttribute("hidden", ""); } var at = document.getElementById("a11yToggle"); if (at) at.setAttribute("aria-expanded", "false"); }
      else { panel.classList.remove("open"); panel.setAttribute("hidden", ""); }
      toggle.setAttribute("aria-expanded", String(o));
    }
    toggle.addEventListener("click", function (e) { e.stopPropagation(); setOpen(panel.hasAttribute("hidden")); });
    document.addEventListener("click", function (e) { if (!panel.hasAttribute("hidden") && !panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !panel.hasAttribute("hidden")) { setOpen(false); toggle.focus(); } });
    var closeBtn = panel.querySelector("[data-talk-close]"); if (closeBtn) closeBtn.addEventListener("click", function () { setOpen(false); toggle.focus(); });
    panel.querySelectorAll("a[href]").forEach(function (a) { a.addEventListener("click", function () { setOpen(false); }); });

    // Inline message form → same /api/contact handler as the Contact page (emails the team via Resend).
    var form = document.getElementById("talkForm");
    if (form) form.addEventListener("submit", async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type="submit"]'), label = btn.textContent;
      // Attach where this enquiry came from (ad-click ID / campaign / page) — see SiteLayout head.
      var data = Object.assign(Object.fromEntries(new FormData(form).entries()),
        typeof window.otterAdSource === "function" ? window.otterAdSource() : {});
      if (!(data.phone || "").trim() && !(data.email || "").trim()) { alert("Please leave a phone number or an email so we can reach you."); return; }
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        var res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) });
        var json = await res.json();
        if (res.ok && json.ok) {
          form.hidden = true;
          var ok = document.getElementById("talkFormOk"); if (ok) ok.hidden = false;
          // Google Ads: count a successful send as a Contact conversion (cookieless — see SiteLayout head).
          if (typeof gtag === "function") gtag("event", "conversion", { send_to: "AW-11233030388/uXnICMDw5bwcEPThqewp" });
        } else { btn.disabled = false; btn.textContent = label; alert(json.error || "Something went wrong — please call us on 01225 690022."); }
      } catch (err) { btn.disabled = false; btn.textContent = label; alert("Something went wrong — please call us on 01225 690022."); }
    });
  })();
</script>
