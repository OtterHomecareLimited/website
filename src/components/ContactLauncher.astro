---
// "Talk to us" launcher. Behaviour here (Code); final look is design's to refine (functional baseline).
// WhatsApp = public office hotline (+44 7564 842728). Honest, human — not a fake live chat.
---
<button id="talkToggle" class="talk-toggle" aria-expanded="false" aria-controls="talkPanel">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-8.5 8.5 8.5 8.5 0 0 1-3.8-.9L3 21l1.9-5.7A8.38 8.38 0 0 1 4 11.5 8.5 8.5 0 0 1 12.5 3 8.38 8.38 0 0 1 21 11.5z" stroke-linecap="round" stroke-linejoin="round"></path></svg>
  <span>Talk to us</span>
</button>

<div id="talkPanel" class="talk-panel" role="dialog" aria-label="Ways to talk to us" hidden>
  <h2>Talk to us</h2>
  <p class="talk-note">You'll always reach a real person here — never a bot. We're a small local team, so if we're with a client we'll get back to you as soon as we can (office hours, Mon–Fri 9–5).</p>
  <a class="talk-opt" href="tel:01225690022">
    <span class="talk-ic" aria-hidden="true">📞</span>
    <span><b>Call us</b><small>01225 690022</small></span>
  </a>
  <a class="talk-opt" href="https://wa.me/447564842728" target="_blank" rel="noopener">
    <span class="talk-ic talk-wa" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15l-1.3 4.8 4.9-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-2.9.8.8-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-2-1.2 7.4 7.4 0 0 1-1.4-1.7c-.1-.3 0-.4.1-.5l.4-.5.2-.4a.5.5 0 0 0 0-.5l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1.1 2.7 11.5 11.5 0 0 0 4.4 3.9c2.6 1 2.6.7 3.1.6a2.6 2.6 0 0 0 1.7-1.2 2.1 2.1 0 0 0 .1-1.2c0-.1-.2-.2-.5-.3z"></path></svg>
    </span>
    <span><b>WhatsApp us</b><small>Message the team</small></span>
  </a>
  <a class="talk-opt" href="/contact">
    <span class="talk-ic" aria-hidden="true">✉️</span>
    <span><b>Request a callback</b><small>We'll come back to you</small></span>
  </a>
</div>

<script is:inline>
  (function () {
    var toggle = document.getElementById("talkToggle"), panel = document.getElementById("talkPanel");
    if (!toggle || !panel) return;
    function setOpen(o) { if (o) panel.removeAttribute("hidden"); else panel.setAttribute("hidden", ""); toggle.setAttribute("aria-expanded", String(o)); }
    toggle.addEventListener("click", function (e) { e.stopPropagation(); setOpen(panel.hasAttribute("hidden")); });
    document.addEventListener("click", function (e) { if (!panel.hasAttribute("hidden") && !panel.contains(e.target) && !toggle.contains(e.target)) setOpen(false); });
    document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !panel.hasAttribute("hidden")) { setOpen(false); toggle.focus(); } });
    panel.querySelectorAll("a[href]").forEach(function (a) { a.addEventListener("click", function () { setOpen(false); }); });
  })();
</script>
