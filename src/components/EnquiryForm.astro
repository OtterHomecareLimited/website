---
/**
 * The booking form on the homepage, /dementia and /contact. One copy, so the
 * fields, spam traps, ad-source details and Google Ads conversion stay the same
 * on every page. Until 18 Oct 2026 each page had its own copy and they drifted:
 * /dementia had no second honeypot or load stamp, and the homepage sent neither
 * the ad-click ID nor the conversion ping.
 *
 * Only the wording around the form changes per page. Field ids are prefixed
 * with the form id so two forms can never clash on one page.
 */
import Turnstile from "./Turnstile.astro";

interface Props {
  id: string;
  heading: string;
  hint: string;
  button: string;
  successHeading: string;
  successText: string;
  /** h2 on /contact, where the form is the page's main content; h3 inside a section. */
  level?: "h2" | "h3";
}
const { id, heading, hint, button, successHeading, successText, level = "h3" } = Astro.props;
const H = level;
const f = (name: string) => `${id}-${name}`;
---
<form class="form" id={id} action="/api/contact" method="POST" novalidate data-enquiry data-ok={f("ok")} data-button={button}>
  <H>{heading}</H>
  <p class="fhint">{hint}</p>
  <input type="text" name="company" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />
  <!-- Second honeypot. Positioned off-screen rather than display:none, which
       spam tooling detects and skips, and given an ordinary-looking name so a
       bot avoiding the well-known "company" trap still fills it. Never focusable,
       never announced. -->
  <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true"
         style="position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden" />
  <input type="hidden" name="ts" value="" data-stamp />
  <div class="frow">
    <div class="field"><label for={f("name")}>Your name</label><input id={f("name")} name="name" type="text" required autocomplete="name" placeholder="Jane Smith" /></div>
    <div class="field"><label for={f("phone")}>Phone</label><input id={f("phone")} name="phone" type="tel" required autocomplete="tel" inputmode="tel" placeholder="07700 900000" /></div>
  </div>
  <div class="field"><label for={f("email")}>Email <span class="opt">(optional)</span></label><input id={f("email")} name="email" type="email" autocomplete="email" inputmode="email" placeholder="jane@example.com" /></div>
  <div class="frow">
    <div class="field"><label for={f("who")}>Who is the care for? <span class="opt">(optional)</span></label><select id={f("who")} name="who"><option value="" selected>Please choose…</option><option>My parent</option><option>My partner</option><option>Myself</option><option>Another relative</option><option>Someone else</option></select></div>
    <div class="field"><label for={f("area")}>Your area <span class="opt">(optional)</span></label><select id={f("area")} name="area"><option value="" selected>Please choose…</option><option>Trowbridge</option><option>Bradford-on-Avon</option><option>Melksham</option><option>Westbury</option><option>Frome</option><option>Warminster</option><option>Corsham</option><option>Elsewhere nearby</option></select></div>
  </div>
  <div class="field"><label for={f("next")}>What would you like? <span class="opt">(optional)</span></label><select id={f("next")} name="next"><option value="" selected>Please choose…</option><option>A call to talk it through first</option><option>A free home assessment</option><option>Not sure yet</option></select></div>
  <div class="field"><label for={f("msg")}>How can we help? <span class="opt">(optional)</span></label><textarea id={f("msg")} name="msg" placeholder="Tell us a little about what you're looking for…"></textarea></div>
  <Turnstile />
  <button class="btn btn-primary" type="submit">{button}</button>
  <p class="privacy">We'll only use your details to respond to your enquiry. See our <a href="/privacy" style="text-decoration:underline">privacy policy</a>.</p>
</form>
<div class="form-success" id={f("ok")}>
  <div class="tick">✓</div>
  <H>{successHeading}</H>
  <p>{successText} If it's urgent, please call <strong>01225 690022</strong>.</p>
</div>

<script is:inline>
  // Sends the form as JSON so the visitor stays on the page. Without JS the form
  // still posts normally and api/contact.js redirects to /thank-you.
  {
    // Binds each form once, so a second form on the same page also works.
    document.querySelectorAll("form[data-enquiry]:not([data-bound])").forEach((form) => {
      form.dataset.bound = "";
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const btn = form.querySelector('button[type="submit"]');
        const label = form.dataset.button;
        const fail = (msg) => { btn.disabled = false; btn.textContent = label; alert(msg || "Something went wrong — please call us on 01225 690022."); };
        // Attach where this enquiry came from (ad-click ID / campaign / page) — see SiteLayout head.
        const data = Object.assign(Object.fromEntries(new FormData(form).entries()),
          typeof window.otterAdSource === "function" ? window.otterAdSource() : {});
        btn.disabled = true; btn.textContent = "Sending…";
        try {
          const res = await fetch("/api/contact", { method: "POST", headers: { "Content-Type": "application/json", Accept: "application/json" }, body: JSON.stringify(data) });
          const json = await res.json();
          if (res.ok && json.ok) {
            form.classList.add("hide");
            document.getElementById(form.dataset.ok).classList.add("show");
            // Google Ads: count the successful send as a "Contact form submission" conversion (cookieless — see SiteLayout head)
            if (typeof gtag === "function") gtag("event", "conversion", { send_to: "AW-11233030388/uXnICMDw5bwcEPThqewp" });
          } else fail(json.error);
        } catch { fail(); }
      });
    });
  }
</script>
