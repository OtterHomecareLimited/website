---
/**
 * The Otter Homecare "TT" mark: the two T's of OTTER drawn as two people,
 * arm in arm. Inline rather than <img> so CSS can move it.
 *
 * Five poses, all from Core/Brand Assets/Logos and mascotts/TT/. They are a
 * small emotional range, so pick the one that fits what the section is saying:
 *
 *   95  one turned toward the other — walking alongside, guiding
 *   96  arms up, heads together — joyful
 *   97  arms open wide — welcoming, here to help
 *   98  arm around, one raised — "we have got you"
 *   99  symmetrical and steady — calm  (the default)
 *
 * The bodies use currentColor, so one component serves both grounds: logo teal
 * #0E7286 on light, white in the dark footer. That teal is the LOGO palette,
 * deliberately not the site's teal token, and should not be aligned to it.
 *
 * Motion, where .tt-live is set, is two small alternating head bobs. Not a lean
 * or a hug: the shoulders arc physically joins the figures, so pulling them
 * together would tear the drawing.
 */
interface Props {
  /** 95 | 96 | 97 | 98 | 99 — see the note above */
  pose?: 95 | 96 | 97 | 98 | 99;
  /** adds .tt-live, which is what the motion rules hook */
  animate?: boolean;
  class?: string;
}
const { pose = 99, animate = false, class: className = "" } = Astro.props;
const cls = ["tt-mark", animate ? "tt-live" : "", className].filter(Boolean).join(" ");
---
  {pose === 95 && (
  <svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 115.45 123.95" role="img" aria-label="Otter Homecare">
    <g fill="none" stroke="currentColor" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
      <path d="M23.33,9.5c-36.11,38.71,6.99,49.53,32.87,50.6,25.6,1.06,35.66.09,49.75,7.26"></path>
      <path d="M41.34,60.19s9.35,33.9-9.92,51.08"></path>
      <path d="M76.61,62.11s6.67,29.96-8.74,52.34"></path>
    </g>
    <circle class="tt-head-l" cx="44.2" cy="30.24" r="12.79" fill="#CCAD2D"></circle>
    <circle class="tt-head-r" cx="79.69" cy="35.8" r="11.83" fill="#CCAD2D"></circle>
  </svg>
  )}
  {pose === 96 && (
  <svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 105.53 110.64" role="img" aria-label="Otter Homecare">
    <g fill="none" stroke="currentColor" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5,25.69c10.35,12.99,17.38,13.24,43.27,14.31,25.6,1.06,36.66-7.13,43.27-14.31"></path>
      <path d="M37.9,40.09s-4.39,50.92-7.08,61.05"></path>
      <path d="M63.44,40.09s3.61,49.6,9.73,61.05"></path>
    </g>
    <circle class="tt-head-l" cx="37.9" cy="12.9" r="12.79" fill="#CCAD2D"></circle>
    <circle class="tt-head-r" cx="68.37" cy="11.83" r="11.83" fill="#CCAD2D"></circle>
  </svg>
  )}
  {pose === 97 && (
  <svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 109.76 104.81" role="img" aria-label="Otter Homecare">
    <g fill="none" stroke="currentColor" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5,33.8c9.51,7.25,15.12,6.09,41,7.16,25.6,1.06,35.66.09,49.75,7.26"></path>
      <path d="M35.64,41.05s9.35,33.9-9.92,51.08"></path>
      <path d="M70.91,42.97s6.67,29.96-8.74,52.34"></path>
    </g>
    <circle class="tt-head-l" cx="38.51" cy="12.79" r="12.79" fill="#CCAD2D"></circle>
    <circle class="tt-head-r" cx="74" cy="12.79" r="11.83" fill="#CCAD2D"></circle>
  </svg>
  )}
  {pose === 98 && (
  <svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 111.42 114.58" role="img" aria-label="Otter Homecare">
    <g fill="none" stroke="currentColor" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5,49.4c16.7-13.87,18.15-6.54,44.04-5.47,25.6,1.06,39.19,2.01,48.39-3.43"></path>
      <path d="M38.67,44.02s5.56,48.09-5.01,61.05"></path>
      <path d="M73.95,45.94s9.48,43.53,0,59.13"></path>
    </g>
    <circle class="tt-head-l" cx="40.14" cy="12.79" r="12.79" fill="#CCAD2D"></circle>
    <circle class="tt-head-r" cx="72.63" cy="16.34" r="11.83" fill="#CCAD2D"></circle>
  </svg>
  )}
  {pose === 99 && (
  <svg class={cls} xmlns="http://www.w3.org/2000/svg" viewBox="0 0 110.6 107.89" role="img" aria-label="Otter Homecare">
    <g fill="none" stroke="currentColor" stroke-width="19" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.5,48.22c16.7-13.87,19.76-8.33,45.64-7.26,25.6,1.06,31.86.09,45.95,7.26"></path>
      <path d="M40.28,41.05s-1.77,39.09-1.77,57.34"></path>
      <path d="M75.55,42.97s-.98,30.38-3.08,52.34"></path>
    </g>
    <circle class="tt-head-l" cx="43.15" cy="12.79" r="12.79" fill="#CCAD2D"></circle>
    <circle class="tt-head-r" cx="78.64" cy="12.79" r="11.83" fill="#CCAD2D"></circle>
  </svg>
  )}
