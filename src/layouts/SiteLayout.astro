---
import "../styles/fonts.css";
import "../styles/otter-home.css";
import "../styles/code-overrides.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AccessibilityControl from "../components/AccessibilityControl.astro";
import ContactLauncher from "../components/ContactLauncher.astro";

import { towns } from "../data/towns";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Overrides the breadcrumb leaf name; defaults to the title before " | ". */
  breadcrumbLabel?: string;
  /** Keeps the page out of search results (post-submission pages, etc.). */
  noindex?: boolean;
}
const {
  title,
  description,
  ogImage = "/img/ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg",
  breadcrumbLabel,
  noindex = false,
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "").replace(/\/$/, "") || "/",
  Astro.site,
).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// ---------------------------------------------------------------------------
// BreadcrumbList — mirrors the visible .crumb trail each page already renders,
// derived from the path so no page has to pass anything. Only real, linkable
// parents appear: the visible trails show a plain-text "About" level, but there
// is no /about page, so it is omitted here rather than emitted without a URL.
// `breadcrumbLabel` lets a page override the leaf name (used by blog posts and
// town pages, whose leaf is the article/town title rather than the slug).
// ---------------------------------------------------------------------------
const SECTION_PARENTS: Record<string, { name: string; path: string }> = {
  "/care-services": { name: "Care Services", path: "/care-services" },
  "/areas-we-cover": { name: "Areas We Cover", path: "/areas-we-cover" },
  "/family": { name: "Family Guides", path: "/family" },
  "/blog": { name: "Blog", path: "/blog" },
};

// leaf slug -> display name, and which section it hangs under (if any)
const CRUMBS: Record<string, { name: string; parent?: string }> = {
  "/personal-care": { name: "Personal Care", parent: "/care-services" },
  "/visiting-care": { name: "Visiting Care", parent: "/care-services" },
  "/live-in-care": { name: "Live-in Care", parent: "/care-services" },
  "/companionship": { name: "Companionship", parent: "/care-services" },
  "/respite-care": { name: "Respite Care", parent: "/care-services" },
  "/conditions": { name: "Conditions", parent: "/care-services" },
  "/dementia": { name: "Dementia Care", parent: "/care-services" },
  "/fall-recovery": { name: "Fall Recovery", parent: "/care-services" },
  "/care-services": { name: "Care Services" },
  "/areas-we-cover": { name: "Areas We Cover" },
  "/how-we-work": { name: "How We Work" },
  "/cost-of-home-care": { name: "Costs & Funding" },
  "/our-story": { name: "Our Story" },
  "/our-team": { name: "Meet the Team" },
  "/support-for-families": { name: "For Families & Care App" },
  "/reviews": { name: "Reviews" },
  "/real-moments": { name: "Real Moments" },
  "/faqs": { name: "FAQs" },
  "/otter-cafe": { name: "Otter Café" },
  "/your-care": { name: "Your Care" },
  "/careers": { name: "Careers" },
  "/contact": { name: "Contact" },
  "/blog": { name: "Blog" },
  "/family": { name: "Family Guides" },
  "/privacy": { name: "Privacy Policy" },
  "/terms": { name: "Terms & Conditions" },
  "/cookies": { name: "Cookies" },
  "/modern-slavery": { name: "Modern Slavery Policy" },
};

const path =
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "").replace(/\/+$/, "") || "/";

function buildCrumbs() {
  if (path === "/") return null; // Google: don't emit a single-item trail
  const trail: { name: string; path: string }[] = [{ name: "Home", path: "/" }];

  const known = CRUMBS[path];
  if (known) {
    if (known.parent && known.parent !== path) trail.push(SECTION_PARENTS[known.parent]);
    trail.push({ name: known.name, path });
  } else if (path.startsWith("/post/")) {
    trail.push(SECTION_PARENTS["/blog"]);
    trail.push({ name: breadcrumbLabel ?? title.split(" | ")[0], path });
  } else if (path.startsWith("/family/")) {
    trail.push(SECTION_PARENTS["/family"]);
    trail.push({ name: breadcrumbLabel ?? title.split(" | ")[0], path });
  } else if (towns.some((t) => `/${t.slug}` === path)) {
    trail.push(SECTION_PARENTS["/areas-we-cover"]);
    trail.push({ name: breadcrumbLabel ?? title.split(" | ")[0], path });
  } else {
    // Unmapped page (/thank-you, /404, anything new) — no invented parent.
    return null;
  }

  return {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: trail.map((c, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: c.name,
      item: new URL(c.path, Astro.site).href,
    })),
  };
}
const breadcrumbSchema = buildCrumbs();
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Google Ads conversion measurement (gtag.js) in strict COOKIELESS mode: Consent Mode v2
         defaults are all DENIED and there is no banner, so no cookies are ever set — that keeps
         the /cookies "not a single cookie" promise true. Attribution relies on the ad-click ID
         in the landing URL (url_passthrough carries it across internal links) plus Google's
         aggregate modelling. Do NOT add analytics_storage/ad_storage grants or any other
         analytics here without updating /cookies and /privacy first. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
      gtag("set", "url_passthrough", true);
      gtag("set", "ads_data_redaction", true);
      gtag("js", new Date());
      gtag("config", "AW-11233030388");
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-11233030388"></script>

    <!-- Enquiry provenance — reads only, STORES NOTHING. No cookie, no localStorage, no
         sessionStorage, so the /cookies "not a single cookie" promise is unaffected and no
         consent banner is needed. It works because url_passthrough (set above) keeps the
         ad-click ID in the URL across internal links while ad_storage is denied — so the ID is
         still there in location.search when the visitor submits, even pages later. Read at
         submit time by the two contact forms (components/ContactLauncher.astro and
         pages/contact.astro) and emailed with the enquiry, so the team can tell a paid click
         from an organic visit. Presence of gclid/gbraid/wbraid = the visitor arrived on an ad. -->
    <script is:inline>
      window.otterAdSource = function () {
        var q = new URLSearchParams(location.search), out = {};
        ["gclid", "gbraid", "wbraid", "gad_source", "utm_source", "utm_medium", "utm_campaign"]
          .forEach(function (k) { var v = q.get(k); if (v) out[k] = v.slice(0, 200); });
        out.page = location.pathname;
        // Only external referrers are useful — internal navigation would just echo our own pages.
        if (document.referrer && document.referrer.indexOf(location.origin) !== 0) {
          out.referrer = document.referrer.slice(0, 200);
        }
        return out;
      };
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <!-- Fonts are self-hosted (src/styles/fonts.css + /fonts/*.woff2) — no Google CDN calls. -->

    <!-- Vercel Web Analytics — cookieless, anonymous visit counting, served first-party from
         this domain. No-ops (404s silently) until Web Analytics is enabled in the Vercel
         dashboard. Disclosed on /cookies. -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Vercel Speed Insights — real-visitor Core Web Vitals (the metric Google ranks on),
         cookieless, first-party. The queue stub captures metrics fired before the script loads. -->
    <script is:inline>window.si=window.si||function(){(window.siq=window.siq||[]).push(arguments)};</script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Otter Homecare" />
    <meta name="twitter:card" content="summary_large_image" />

    {breadcrumbSchema && (
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
    )}

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HomeHealthCareService",
      "@id": "https://www.otterhomecare.co.uk/#organization",
      "name": "Otter Homecare",
      "alternateName": "Otter Homecare Ltd",
      "description": "Family-run, CQC-registered home care provider in Trowbridge offering visiting care, live-in care, overnight and 24-hour care, companionship, respite and dementia care across West Wiltshire and Somerset.",
      "image": ogImageUrl,
      "logo": "https://www.otterhomecare.co.uk/assets/apple-touch-icon.png",
      "telephone": "+441225690022",
      "email": "hello@otterhomecare.co.uk",
      "url": "https://www.otterhomecare.co.uk",
      "priceRange": "££",
      "currenciesAccepted": "GBP",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Arlington House, 72 Fore Street",
        "addressLocality": "Trowbridge",
        "addressRegion": "Wiltshire",
        "postalCode": "BA14 8HQ",
        "addressCountry": "GB"
      },
      "areaServed": [
        "Trowbridge", "Melksham", "Frome", "Bradford-on-Avon", "Westbury",
        "West Wiltshire", "Somerset"
      ],
      "founder": { "@type": "Person", "name": "Jamie Rowland-Jones" },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "17:00"
      }],
      "knowsAbout": [
        "Home care", "Visiting care", "Live-in care", "Overnight care",
        "24-hour care", "Companionship care", "Respite care", "Dementia care",
        "Parkinson's care", "Stroke recovery", "Palliative care", "Fall recovery"
      ],
      "sameAs": [
        "https://www.facebook.com/otterhomecare",
        "https://www.cqc.org.uk/provider/1-16037123435",
        "https://www.nhs.uk/services/care-provider/otter-homecare-limited/1-18269081969",
        "https://www.homecare.co.uk/homecare/agency.cfm/id/65432251370"
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main"><slot /></main>
    <SiteFooter />
    <AccessibilityControl />
    <ContactLauncher />

    <!-- Sticky mobile action bar REMOVED (Jamie, 2026-07-26): it sat on top of
         page content — the clay "Talk to us" launcher is the mobile contact
         affordance instead (un-hidden in code-overrides.css). The .mbar CSS
         rules in otter-home.css are inert without this markup. -->

    <script is:inline>
      // nav toggle — slide-in drawer: tap-outside and tap-a-link both close it
      const t = document.getElementById("navToggle"), m = document.getElementById("mobileMenu");
      if (t && m) {
        const setMenu = (o) => {
          m.classList.toggle("show", o);
          t.classList.toggle("open", o);
          t.setAttribute("aria-expanded", String(o));
        };
        t.addEventListener("click", (e) => { e.stopPropagation(); setMenu(!m.classList.contains("show")); });
        document.addEventListener("click", (e) => {
          if (m.classList.contains("show") && !m.contains(e.target) && !t.contains(e.target)) setMenu(false);
        });
        m.querySelectorAll("a[href]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      }
      // reveal on scroll
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      setTimeout(() => document.querySelectorAll(".reveal:not(.in)").forEach((el) => el.classList.add("in")), 1400);
      // FAQ accordion
      document.querySelectorAll(".faq > button").forEach((b) =>
        b.addEventListener("click", () => b.parentElement.classList.toggle("open")));
      // Utility-bar promise line is static — the rotating carousel was distracting and
      // violated the "no infinite loops" motion rule.
      // Google Ads: a tap on any phone link counts as a "Phone click" conversion (cookieless — see head)
      document.addEventListener("click", (e) => {
        if (e.target.closest && e.target.closest('a[href^="tel:"]') && typeof gtag === "function")
          gtag("event", "conversion", { send_to: "AW-11233030388/CSi8CMPw5bwcEPThqewp" });
      });
      // Inline video blocks — click a [data-yt] block to play a YouTube film in place
      document.querySelectorAll(".video-embed[data-yt], .fullbleed[data-yt]").forEach((el) => {
        const play = () => {
          if (el.classList.contains("playing")) return;
          const f = document.createElement("iframe");
          f.src = "https://www.youtube-nocookie.com/embed/" + el.getAttribute("data-yt") + "?autoplay=1&rel=0&playsinline=1";
          f.title = "Otter Homecare video";
          f.setAttribute("allow", "autoplay; encrypted-media; fullscreen");
          f.setAttribute("allowfullscreen", "");
          el.appendChild(f);
          el.classList.add("playing");
        };
        el.addEventListener("click", play);
        el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); play(); } });
      });
</script>
  
    <script is:inline>
      /* Stamps when the page was loaded, so api/contact.js can tell a person
         typing from a script posting instantly. Deliberately advisory only: a
         missing or odd value never blocks a submission, because no-JS visitors
         have none and losing a real enquiry is the worse failure. */
      (function () {
        var now = Date.now();
        document.querySelectorAll("input[data-stamp]").forEach(function (i) { i.value = String(now); });
      })();
    </script>
  </body>
</html>
