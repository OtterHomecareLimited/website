---
import "../styles/fonts.css";
import "../styles/otter-home.css";
import "../styles/code-overrides.css";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import AccessibilityControl from "../components/AccessibilityControl.astro";
import ContactLauncher from "../components/ContactLauncher.astro";

interface Props {
  title: string;
  description: string;
  ogImage?: string;
}
const { title, description, ogImage = "/img/ff72ba_82b85220c73d4bf3b00cc07f8605e8f0~mv2.jpg" } = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "").replace(/\/$/, "") || "/",
  Astro.site,
).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add("js");</script>

    <!-- Google Ads conversion measurement (gtag.js) in strict COOKIELESS mode: Consent Mode v2
         defaults are all DENIED and there is no banner, so no cookies are ever set — that keeps
         the /cookies "not a single cookie" promise true. Attribution relies on the ad-click ID
         in the landing URL (url_passthrough carries it across internal links) plus Google's
         aggregate modelling. Do NOT add analytics_storage/ad_storage grants or any other
         analytics here without updating /cookies and /privacy first. -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("consent", "default", {
        ad_storage: "denied",
        ad_user_data: "denied",
        ad_personalization: "denied",
        analytics_storage: "denied",
      });
      gtag("set", "url_passthrough", true);
      gtag("set", "ads_data_redaction", true);
      gtag("js", new Date());
      gtag("config", "AW-11233030388");
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-11233030388"></script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/assets/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    <!-- Fonts are self-hosted (src/styles/fonts.css + /fonts/*.woff2) — no Google CDN calls. -->

    <!-- Vercel Web Analytics — cookieless, anonymous visit counting, served first-party from
         this domain. No-ops (404s silently) until Web Analytics is enabled in the Vercel
         dashboard. Disclosed on /cookies. -->
    <script defer src="/_vercel/insights/script.js"></script>

    <!-- Vercel Speed Insights — real-visitor Core Web Vitals (the metric Google ranks on),
         cookieless, first-party. The queue stub captures metrics fired before the script loads. -->
    <script is:inline>window.si=window.si||function(){(window.siq=window.siq||[]).push(arguments)};</script>
    <script defer src="/_vercel/speed-insights/script.js"></script>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Otter Homecare" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HomeHealthCareService",
      "@id": "https://www.otterhomecare.co.uk/#organization",
      "name": "Otter Homecare",
      "alternateName": "Otter Homecare Ltd",
      "description": "Family-run, CQC-registered home care provider in Trowbridge offering visiting care, live-in care, overnight and 24-hour care, companionship, respite and dementia care across West Wiltshire and Somerset.",
      "image": ogImageUrl,
      "logo": "https://www.otterhomecare.co.uk/assets/apple-touch-icon.png",
      "telephone": "+441225690022",
      "email": "hello@otterhomecare.co.uk",
      "url": "https://www.otterhomecare.co.uk",
      "priceRange": "££",
      "currenciesAccepted": "GBP",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Arlington House, 72 Fore Street",
        "addressLocality": "Trowbridge",
        "addressRegion": "Wiltshire",
        "postalCode": "BA14 8HQ",
        "addressCountry": "GB"
      },
      "areaServed": [
        "Trowbridge", "Melksham", "Frome", "Bradford-on-Avon", "Westbury",
        "West Wiltshire", "Somerset"
      ],
      "founder": { "@type": "Person", "name": "Jamie Rowland-Jones" },
      "openingHoursSpecification": [{
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
        "opens": "09:00",
        "closes": "17:00"
      }],
      "knowsAbout": [
        "Home care", "Visiting care", "Live-in care", "Overnight care",
        "24-hour care", "Companionship care", "Respite care", "Dementia care",
        "Parkinson's care", "Stroke recovery", "Palliative care", "Fall recovery"
      ],
      "sameAs": [
        "https://www.facebook.com/otterhomecare",
        "https://www.cqc.org.uk/provider/1-16037123435",
        "https://www.nhs.uk/services/care-provider/otter-homecare-limited/1-18269081969",
        "https://www.homecare.co.uk/homecare/agency.cfm/id/65432251370"
      ]
    })} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <main id="main"><slot /></main>
    <SiteFooter />
    <AccessibilityControl />
    <ContactLauncher />

    <!-- sticky mobile action bar -->
    <div class="mbar">
      <a class="btn btn-ghost" href="tel:01225690022">Call</a>
      <a class="btn btn-primary" href="/contact">Book a free assessment</a>
    </div>

    <script is:inline>
      // nav toggle — slide-in drawer: tap-outside and tap-a-link both close it
      const t = document.getElementById("navToggle"), m = document.getElementById("mobileMenu");
      if (t && m) {
        const setMenu = (o) => {
          m.classList.toggle("show", o);
          t.classList.toggle("open", o);
          t.setAttribute("aria-expanded", String(o));
        };
        t.addEventListener("click", (e) => { e.stopPropagation(); setMenu(!m.classList.contains("show")); });
        document.addEventListener("click", (e) => {
          if (m.classList.contains("show") && !m.contains(e.target) && !t.contains(e.target)) setMenu(false);
        });
        m.querySelectorAll("a[href]").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      }
      // reveal on scroll
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); io.unobserve(e.target); } });
      }, { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".reveal").forEach((el) => io.observe(el));
      setTimeout(() => document.querySelectorAll(".reveal:not(.in)").forEach((el) => el.classList.add("in")), 1400);
      // FAQ accordion
      document.querySelectorAll(".faq > button").forEach((b) =>
        b.addEventListener("click", () => b.parentElement.classList.toggle("open")));
      // Rotating promise line in the gold utility bar (disabled under reduced-motion)
      const rot = document.getElementById("utilRot");
      if (rot && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const lines = [
          'We treat your family <span class="em">like our own</span>',
          'Care that feels <span class="em">like family</span>',
          'A familiar face, <span class="em">every single visit</span>',
          'A reliable team <span class="em">around your loved one</span>',
        ];
        const tt = document.getElementById("utilTT");
        let i = 0;
        setInterval(() => {
          i = (i + 1) % lines.length;
          rot.classList.add("fade");
          setTimeout(() => {
            rot.innerHTML = lines[i]; rot.classList.remove("fade");
            if (tt) tt.src = "/assets/otter-tt-" + ((i % 3) + 1) + ".png";
          }, 400);
        }, 3800);
      }
      // Google Ads: a tap on any phone link counts as a "Phone click" conversion (cookieless — see head)
      document.addEventListener("click", (e) => {
        if (e.target.closest && e.target.closest('a[href^="tel:"]') && typeof gtag === "function")
          gtag("event", "conversion", { send_to: "AW-11233030388/CSi8CMPw5bwcEPThqewp" });
      });
      // Inline video blocks — click a [data-yt] block to play a YouTube film in place
      document.querySelectorAll(".video-embed[data-yt], .fullbleed[data-yt]").forEach((el) => {
        const play = () => {
          if (el.classList.contains("playing")) return;
          const f = document.createElement("iframe");
          f.src = "https://www.youtube-nocookie.com/embed/" + el.getAttribute("data-yt") + "?autoplay=1&rel=0&playsinline=1";
          f.title = "Otter Homecare video";
          f.setAttribute("allow", "autoplay; encrypted-media; fullscreen");
          f.setAttribute("allowfullscreen", "");
          el.appendChild(f);
          el.classList.add("playing");
        };
        el.addEventListener("click", play);
        el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); play(); } });
      });
</script>
  </body>
</html>
