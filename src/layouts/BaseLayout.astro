---
import "../styles/global.css";
import UtilityBar from "../components/UtilityBar.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Optional Open Graph image (absolute path under /). */
  ogImage?: string;
}

const { title, description, ogImage = "/og-default.png" } = Astro.props;

// Canonical URL derived from the configured `site` + current path.
// This is the SEO-parity machinery the audit flagged as missing on Wix.
// Strip the `.html` (file-based build output) and normalise the index so
// canonicals are extensionless and slash-free — matching the live Wix URLs
// (Vercel serves these files extensionless via cleanUrls).
const cleanPath =
  Astro.url.pathname.replace(/index\.html$/, "").replace(/\.html$/, "").replace(/\/$/, "") || "/";
const canonical = new URL(cleanPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph / social (none of this existed on the Wix site) -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content="Otter Homecare" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- LocalBusiness structured data (also absent on Wix) -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "HomeAndConstructionBusiness",
      "name": "Otter Homecare",
      "image": ogImageUrl,
      "telephone": "+441225690022",
      "email": "hello@otterhomecare.co.uk",
      "url": "https://www.otterhomecare.co.uk",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Arlington House, 72 Fore Street",
        "addressLocality": "Trowbridge",
        "postalCode": "BA14 8HQ",
        "addressCountry": "GB"
      },
      "areaServed": ["Trowbridge", "Melksham", "Frome", "Bradford-on-Avon", "Westbury"]
    })} />
  </head>
  <body>
    <UtilityBar />
    <Header />
    <slot />
    <Footer />
  </body>
</html>
